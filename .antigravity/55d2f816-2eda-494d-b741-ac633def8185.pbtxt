  file_change {
    absolute_path_uri: "file:///src/components/SettingsModule.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "  // If Employee / Cashier Role: Simplify to ONLY Internal UI Personalization\n  if (!isOwner) {\n    return (\n      <div className=\"max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6\">\n        <div className=\"bg-white rounded-xl shadow-sm border border-slate-200 p-4 flex items-center justify-between\">\n          <div>\n            <h2 className=\"text-xl font-bold text-slate-900 flex items-center gap-2\">\n              <Palette className=\"w-5 h-5 text-orange-600\" />\n              Employee Settings\n            </h2>\n            <p className=\"text-xs text-slate-500 mt-0.5\">\n              Customize your workstation UI theme preference\n            </p>\n          </div>\n        </div>\n\n        <form onSubmit={handleSubmit} className=\"space-y-6\">\n          {/* THEME PERSONALIZATION (Single setting for Employee) */}\n          <div className=\"bg-white rounded-2xl shadow-sm border border-slate-200 p-6 space-y-4\">\n            <div className=\"flex items-center justify-between border-b border-slate-100 pb-3\">\n              <div>\n                <h3 className=\"font-bold text-slate-900 text-sm flex items-center gap-2\">\n                  <Palette className=\"w-4 h-4 text-orange-600\" />\n                  Internal UI Personalization\n                </h3>\n                <p className=\"text-xs text-slate-500 mt-0.5\">\n                  Select your preferred color accents for your active POS shift session\n                </p>\n              </div>\n              {!isTier2Unlocked && (\n                <span className=\"text-[10px] bg-amber-100 text-amber-800 font-bold px-2 py-0.5 rounded border border-amber-300\">\n                  Tier 2 Locked\n                </span>\n              )}\n            </div>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3\">\n              {[\n                { id: \'orange\', name: \'Marikina Warm Orange\', hex: \'bg-orange-600\' },\n                { id: \'amber\', name: \'Terracotta Amber\', hex: \'bg-amber-600\' },\n                { id: \'emerald\', name: \'Fresh Emerald\', hex: \'bg-emerald-600\' },\n                { id: \'slate\', name: \'Dark Slate Premium\', hex: \'bg-slate-800\' },\n              ].map((t) => (\n                <button\n                  key={t.id}\n                  type=\"button\"\n                  onClick={() => {\n                    if (!isTier2Unlocked) {\n                      alert(\'UI Theme Personalization requires SaaS Tier 2 (\342\202\26199/mo). Ask Store Owner to upgrade.\');\n                    } else {\n                      setThemeColor(t.id as any);\n                    }\n                  }}\n                  className={`p-3.5 rounded-xl border text-left flex items-center space-x-2.5 transition cursor-pointer ${\n                    themeColor === t.id\n                      ? \'border-orange-600 ring-2 ring-orange-500/20 bg-orange-50/30 font-bold\'\n                      : \'border-slate-200 hover:bg-slate-50 text-slate-700\'\n                  }`}\n                >\n                  <div className={`w-4 h-4 rounded-full shrink-0 ${t.hex}`} />\n                  <span className=\"text-xs\">{t.name}</span>\n                </button>\n              ))}\n            </div>\n          </div>\n\n          <div className=\"flex justify-end\">\n            <button\n              type=\"submit\"\n              className=\"px-6 py-3 bg-[#E65100] hover:bg-[#BF360C] text-white font-bold rounded-xl text-xs shadow-md transition flex items-center space-x-2 cursor-pointer\"\n            >\n              <CheckCircle2 className=\"w-4 h-4\" />\n              <span>SAVE PREFERENCES</span>\n            </button>\n          </div>\n        </form>\n      </div>\n    );\n  }"
      replacement_content: "  // If Employee / Cashier Role: Simplify to ONLY Internal UI Personalization\n  if (!isOwner) {\n    return (\n      <div className=\"max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6\">\n        <div className=\"bg-white rounded-3xl shadow-airmee border border-slate-200/80 p-6 flex items-center justify-between\">\n          <div>\n            <span className=\"bg-orange-50 text-orange-600 border border-orange-200/60 text-[11px] font-extrabold px-3.5 py-1 rounded-full uppercase tracking-wider inline-block mb-2\">\n              Shift Preferences\n            </span>\n            <h2 className=\"text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2\">\n              <Palette className=\"w-6 h-6 text-orange-600\" />\n              Employee Settings\n            </h2>\n            <p className=\"text-xs text-slate-500 font-medium mt-1\">\n              Customize your workstation UI theme preference for active shift counter operations.\n            </p>\n          </div>\n        </div>\n\n        <form onSubmit={handleSubmit} className=\"space-y-6\">\n          {/* THEME PERSONALIZATION (Single setting for Employee) */}\n          <div className=\"bg-white rounded-3xl shadow-airmee border border-slate-200/80 p-6 space-y-5\">\n            <div className=\"flex items-center justify-between border-b border-slate-100 pb-4\">\n              <div>\n                <h3 className=\"font-extrabold text-slate-900 text-base flex items-center gap-2\">\n                  <Palette className=\"w-5 h-5 text-orange-600\" />\n                  Internal UI Personalization\n                </h3>\n                <p className=\"text-xs text-slate-500 font-medium mt-0.5\">\n                  Select your preferred color accents for your active POS shift session\n                </p>\n              </div>\n              {!isTier2Unlocked && (\n                <span className=\"text-[10px] bg-amber-50 text-amber-800 font-extrabold px-3 py-1 rounded-full border border-amber-200 uppercase tracking-wider\">\n                  Tier 2 Locked\n                </span>\n              )}\n            </div>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n              {[\n                { id: \'orange\', name: \'Marikina Warm Orange\', hex: \'bg-orange-600\' },\n                { id: \'amber\', name: \'Terracotta Amber\', hex: \'bg-amber-600\' },\n                { id: \'emerald\', name: \'Fresh Emerald\', hex: \'bg-emerald-600\' },\n                { id: \'slate\', name: \'Dark Slate Premium\', hex: \'bg-slate-800\' },\n              ].map((t) => (\n                <button\n                  key={t.id}\n                  type=\"button\"\n                  onClick={() => {\n                    if (!isTier2Unlocked) {\n                      alert(\'UI Theme Personalization requires SaaS Tier 2 (\342\202\26199/mo). Ask Store Owner to upgrade.\');\n                    } else {\n                      setThemeColor(t.id as any);\n                    }\n                  }}\n                  className={`p-4 rounded-2xl border text-left flex items-center space-x-3 transition-all cursor-pointer ${\n                    themeColor === t.id\n                      ? \'border-orange-600 ring-2 ring-orange-500/20 bg-orange-50/40 font-black\'\n                      : \'border-slate-200/80 hover:bg-slate-50 text-slate-700\'\n                  }`}\n                >\n                  <div className={`w-4 h-4 rounded-full shrink-0 ${t.hex}`} />\n                  <span className=\"text-xs font-bold\">{t.name}</span>\n                </button>\n              ))}\n            </div>\n          </div>\n\n          <div className=\"flex justify-end\">\n            <button\n              type=\"submit\"\n              className=\"px-6 py-3 bg-orange-600 hover:bg-orange-700 text-white font-extrabold rounded-full text-xs shadow-airmee-orange transition-all flex items-center space-x-2 cursor-p