  file_change {
    absolute_path_uri: "file:///src/components/LoginLandingPage.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React, { useState } from \'react\';\nimport { \n  Building2, \n  ShieldCheck, \n  Lock, \n  ArrowRight, \n  Store, \n  KeyRound, \n  AlertCircle,\n  User,\n  Users,\n  Mail,\n  Eye,\n  EyeOff,\n  RefreshCw,\n  Send,\n  CheckCircle2,\n  ArrowLeft,\n  Crown,\n  UserCheck\n} from \'lucide-react\';\nimport { UserProfile, StoreSettings, Role } from \'../types\';\n\ninterface LoginLandingPageProps {\n  settings: StoreSettings;\n  staffAccounts: UserProfile[];\n  onLoginSuccess: (user: UserProfile) => void;\n  onUpdateStaffAccounts: (accounts: UserProfile[]) => void;\n}\n\nexport const LoginLandingPage: React.FC<LoginLandingPageProps> = ({\n  settings,\n  staffAccounts,\n  onLoginSuccess,\n  onUpdateStaffAccounts,\n}) => {\n  // Portal Selection State: null = Landing Screen, \'ADMIN\' = Owner Form, \'CASHIER\' = Employee Form\n  const [selectedPortal, setSelectedPortal] = useState<Role | null>(null);\n\n  // Login form state\n  const [identifier, setIdentifier] = useState<string>(\'\'); // email or username\n  const [password, setPassword] = useState<string>(\'\');\n  const [showPassword, setShowPassword] = useState<boolean>(false);\n  const [errorMsg, setErrorMsg] = useState<string>(\'\');\n\n  // Forgot Password Flow State\n  const [isForgotModalOpen, setIsForgotModalOpen] = useState<boolean>(false);\n  const [forgotStep, setForgotStep] = useState<1 | 2 | 3>(1); // 1: Email input, 2: Code verification, 3: New password\n  const [resetEmail, setResetEmail] = useState<string>(\'\');\n  const [generatedCode, setGeneratedCode] = useState<string>(\'\');\n  const [enteredCode, setEnteredCode] = useState<string>(\'\');\n  const [newPassword, setNewPassword] = useState<string>(\'\');\n  const [confirmNewPassword, setConfirmNewPassword] = useState<string>(\'\');\n  const [forgotError, setForgotError] = useState<string>(\'\');\n  const [forgotSuccess, setForgotSuccess] = useState<string>(\'\');\n  const [targetResetUser, setTargetResetUser] = useState<UserProfile | null>(null);\n\n  // Quick fill helper for testing demo accounts\n  const handleQuickFill = (acc: UserProfile) => {\n    setIdentifier(acc.email || acc.username || acc.name);\n    setPassword(acc.password || \'password123\');\n    setErrorMsg(\'\');\n  };\n\n  const handleSelectPortal = (portalRole: Role) => {\n    setSelectedPortal(portalRole);\n    setErrorMsg(\'\');\n    setIdentifier(\'\');\n    setPassword(\'\');\n  };\n\n  const handleLoginSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    setErrorMsg(\'\');\n\n    if (!selectedPortal) return;\n\n    const query = identifier.trim().toLowerCase();\n    if (!query) {\n      setErrorMsg(\'Please enter your username or email address.\');\n      return;\n    }\n\n    if (!password) {\n      setErrorMsg(\'Please enter your account password.\');\n      return;\n    }\n\n    // Find account by email, username, or name match\n    const foundUser = staffAccounts.find((acc) => {\n      const matchEmail = acc.email && acc.email.toLowerCase() === query;\n      const matchUsername = acc.username && acc.username.toLowerCase() === query;\n      const matchName = acc.name.toLowerCase().includes(query);\n      return matchEmail || matchUsername || matchName;\n    });\n\n    if (!foundUser) {\n      setErrorMsg(\'Account not found. Please check your username/email address.\');\n      return;\n    }\n\n    // ROLE VALIDATION CHECK\n    if (selectedPortal === \'CASHIER\' && foundUser.role === \'ADMIN\') {\n      setErrorMsg(\"This is an Owner\'s Account. Please input an Employee Account.\");\n      return;\n    }\n\n    if (selectedPortal === \'ADMIN\' && foundUser.role === \'CASHIER\') {\n      setErrorMsg(\"This is an Employee\'s Account. Please input an Owner Account.\");\n      return;\n    }\n\n    // Check password\n    const expectedPassword = foundUser.password || \'password123\';\n    if (password === expectedPassword) {\n      onLoginSuccess(foundUser);\n    } else {\n      setErrorMsg(\'Incorrect password. Please try again or click \"Forgot Password?\" to reset.\');\n    }\n  };\n\n  // --- FORGOT PASSWORD HANDLERS ---\n  const handleSendResetCode = (e: React.FormEvent) => {\n    e.preventDefault();\n    setForgotError(\'\');\n    setForgotSuccess(\'\');\n\n    const query = resetEmail.trim().toLowerCase();\n    if (!query) {\n      setForgotError(\'Please enter your registered email address or username.\');\n      return;\n    }\n\n    const found = staffAccounts.find((acc) => {\n      const matchEmail = acc.email && acc.email.toLowerCase() === query;\n      const matchUsername = acc.username && acc.username.toLowerCase() === query;\n      return matchEmail || matchUsername;\n    });\n\n    if (!found) {\n      setForgotError(\'No account registered under this email or username.\');\n      return;\n    }\n\n    // Generate random 6-digit confirmation code\n    const code = Math.floor(100000 + Math.random() * 900000).toString();\n    setGeneratedCode(code);\n    setTargetResetUser(found);\n    setForgotStep(2);\n    setForgotSuccess(`Verification code sent! Simulated email code for ${found.email}: ${code}`);\n  };\n\n  const handleVerifyCode = (e: React.FormEvent) => {\n    e.preventDefault();\n    setForgotError(\'\');\n\n    if (enteredCode.trim() !== generatedCode) {\n      setForgotError(\'Invalid confirmation code. Please check the simulated email notice above.\');\n      return;\n    }\n\n    setForgotStep(3);\n    setForgotError(\'\');\n    setForgotSuccess(\'Code confirmed! Please enter your new password.\');\n  };\n\n  const handleResetPasswordSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    setForgotError(\'\');\n\n    if (!newPassword || newPassword.length < 4) {\n      setForgotError(\'Password must be at least 4 characters long.\');\n      return;\n    }\n\n    if (newPassword !== confirmNewPassword) {\n      setForgotError(\'Passwords do not match. Please re-enter.\');\n      return;\n    }\n\n    if (!targetResetUser) return;\n\n    // Update account with new password\n    const updatedUser: UserProfile = {\n      ...targetResetUser,\n      password: newPassword,\n    };\n\n    const updatedAccounts = staffAccounts.map((acc) =>\n      acc.id === updatedUser.id ? updatedUser : acc\n    );\n\n    onUpdateStaffAccounts(updatedAccounts);\n\n    // Pre-fill login\n    setIdentifier(updatedUser.email || updatedUser.username || updatedUser.name);\n    setPassword(newPassword);\n\n    alert(`Password reset successful for ${updatedUser.name}! You can now log in.`);\n    setIsForgotModalOpen(false);\n    setForgotStep(1);\n    setEnteredCode(\'\');\n    setNewPassword(\'\');\n    setConfirmNewPassword(\'\');\n  };\n\n  const filteredDemoAccounts = staffAccounts.filter((acc) => \n    selectedPortal === \'ADMIN\' ? acc.role === \'ADMIN\' : acc.role === \'CASHIER\'\n  );\n\n  return (\n    <div className=\"min-h-screen bg-[#FCFAF7] text-[#2D241E] flex flex-col justify-between p-4 sm:p-6 md:p-10 font-sans selection:bg-[#E65100] selection:text-white\">\n      \n      {/* Top Brand Header */}\n      <div className=\"max-w-5xl mx-auto w-full flex items-center justify-between pb-6 border-b border-[#E8E2DD]\">\n        <div className=\"flex items-center space-x-3\">\n          <div className=\"w-10 h-10 rounded-xl bg-[#E65100] flex items-center justify-center text-white font-black text-xl shadow-xs\">\n            C\n          </div>\n          <div>\n            <h1 className=\"text-xl font-extrabold tracking-tight text-[#2D241E]\">\n              CariCloud POS\n            </h1>\n            <p className=\"text-xs text-[#756D67] font-medium\">\n              Marikina Carinderia Operating System\n            </p>\n          </div>\n        </div>\n\n        <div className=\"bg-white border border-[#E8E2DD] px-3.5 py-1.5 rounded-full text-xs text-[#756D67] font-semibold flex items-center gap-2 shadow-2xs\">\n          <Store className=\"w-3.5 h-3.5 text-[#E65100]\" />\n          <span>{settings.storeName} ({settings.branchName})</span>\n        </div>\n      </div>\n\n      {/* Main Content Container */}\n      <div className=\"max-w-4xl mx-auto w-full my-auto py-8\">\n        \n        {/* LANDING PAGE: SELECT OWNER OR EMPLOYEE LOGIN */}\n        {selectedPortal === null ? (\n          <div className=\"space-y-8 text-center max-w-2xl mx-auto animate-fadeIn\">\n            \n            <div className=\"space-y-3\">\n              <span className=\"bg-[#FFF3E0] text-[#E65100] border border-[#E8E2DD] text-xs font-bold px-3.5 py-1 rounded-full uppercase tracking-wider inline-block shadow-2xs\">\n                Account Access Portal\n              </span>\n              <h2 className=\"text-3xl sm:text-4xl font-black text-[#2D241E] tracking-tight\">\n                Welcome to CariCloud POS\n              </h2>\n              <p className=\"text-sm text-[#756D67] max-w-lg mx-auto leading-relaxed\">\n                Please select your login type below to access your designated workspace.\n              </p>\n            </div>\n\n            {/* Portal Choice Cards */}\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-5 pt-2\">\n              \n              {/* Option 1: Login as Owner */}\n              <button\n                type=\"button\"\n                onClick={() => handleSelectPortal(\'ADMIN\')}\n                className=\"group relative bg-white hover:bg-orange-50/50 rounded-3xl p-6 border-2 border-[#E8E2DD] hover:border-[#E65100] transition-all duration-200 shadow-md hover:shadow-xl text-left flex flex-col justify-between space-y-6 cursor-pointer\"\n              >\n                <div className=\"space-y-3\">\n                  <div className=\"w-14 h-14 rounded-2xl bg-orange-100 text-[#E65100] flex items-center justify-center font-bold shadow-xs group-hover:scale-105 transition-transform\">\n                    <Crown className=\"w-7 h-7\" />\n                  </div>\n\n                  <div>\n                    <span className=\"text-[10px] font-bold text-[#E65100] bg-orange-100/60 px-2.5 py-0.5 rounded-full uppercase tracking-wider\">\n                      Store Proprietor\n                    </span>\n                    <h3 className=\"text-2xl font-black text-[#2D241E] mt-1\">\n                      Login as Owner\n                    </h3>\n                    <p className=\"text-xs text-[#756D67] leading-relaxed mt-1.5\">\n                      Access store management, menu pricing, tax relief tracking, and the complete Listahan (Utang) credit ledger.\n                    </p>\n                  </div>\n                </div>\n\n                <div className=\"pt-2 flex items-center text-xs font-extrabold text-[#E65100] group-hover:translate-x-1 transition-transform\">\n                  <span>CONTINUE TO OWNER LOGIN</span>\n                  <ArrowRight className=\"w-4 h-4 ml-1.5\" />\n                </div>\n              </button>\n\n              {/* Option 2: Login as Employee */}\n              <button\n                type=\"button\"\n                onClick={() => handleSelectPortal(\'CASHIER\')}\n                className=\"group relative bg-white hover:bg-amber-50/50 rounded-3xl p-6 border-2 border-[#E8E2DD] hover:border-amber-600 transition-all duration-200 shadow-md hover:shadow-xl text-left flex flex-col justify-between space-y-6 cursor-pointer\"\n              >\n                <div className=\"space-y-3\">\n                  <div className=\"w-14 h-14 rounded-2xl bg-amber-100 text-amber-800 flex items-center justify-center font-bold shadow-xs group-hover:scale-105 transition-transform\">\n                    <UserCheck className=\"w-7 h-7\" />\n                  </div>\n\n                  <div>\n                    <span className=\"text-[10px] font-bold text-amber-800 bg-amber-100/60 px-2.5 py-0.5 rounded-full uppercase tracking-wider\">\n                      Shift Staff / Cashier\n                    </span>\n                    <h3 className=\"text-2xl font-black text-[#2D241E] mt-1\">\n                      Login as Employee\n                    </h3>\n                    <p className=\"text-xs text-[#756D67] leading-relaxed mt-1.5\">\n                      Access active POS register, counter ordering, receipt printouts, and view customer credit ledger history.\n                    </p>\n                  </div>\n                </div>\n\n                <div className=\"pt-2 flex items-center text-xs font-extrabold text-amber-800 group-hover:translate-x-1 transition-transform\">\n                  <span>CONTINUE TO EMPLOYEE LOGIN</span>\n                  <ArrowRight className=\"w-4 h-4 ml-1.5\" />\n                </div>\n              </button>\n\n            </div>\n\n          </div>\n        ) : (\n          /* LOGIN FORM SCREEN FOR SELECTED ROLE */\n          <div className=\"max-w-md mx-auto w-full animate-fadeIn space-y-4\">\n            \n            <button\n              type=\"button\"\n              onClick={() => setSelectedPortal(null)}\n              className=\"text-xs font-bold text-[#756D67] hover:text-[#E65100] flex items-center gap-1 mb-2 cursor-pointer transition\"\n            >\n              <ArrowLeft className=\"w-4 h-4\" />\n              <span>Back to Portal Selection</span>\n            </button>\n\n            <div className=\"bg-white rounded-3xl p-6 sm:p-8 border border-[#E8E2DD] shadow-xl space-y-6\">\n              \n              <div className=\"text-center space-y-2\">\n                <span className={`text-[11px] font-bold px-3 py-1 rounded-full uppercase tracking-wider inline-block border ${\n                  selectedPortal === \'ADMIN\'\n                    ? \'bg-orange-100 text-[#E65100] border-orange-200\'\n                    : \'bg-amber-100 text-amber-900 border-amber-200\'\n                }`}>\n                  {selectedPortal === \'ADMIN\' ? \'OWNER LOGIN PORTAL\' : \'EMPLOYEE LOGIN PORTAL\'}\n                </span>\n                <h2 className=\"text-2xl font-black text-[#2D241E] tracking-tight\">\n                  {selectedPortal === \'ADMIN\' ? \'Owner Sign In\' : \'Employee Sign In\'}\n                </h2>\n                <p className=\"text-xs text-[#756D67]\">\n                  Enter your registered {selectedPortal === \'ADMIN\' ? \'Owner\' : \'Employee\'} username or email and password.\n                </p>\n              </div>\n\n              <form onSubmit={handleLoginSubmit} className=\"space-y-4\">\n                \n                {/* Username or Email Input */}\n                <div>\n                  <label className=\"block text-xs font-bold text-[#2D241E] mb-1.5\">\n                    {selectedPortal === \'ADMIN\' ? \'Owner Username or Email\' : \'Employee Username or Email\'}\n                  </label>\n                  <div className=\"relative\">\n                    <input\n                      type=\"text\"\n                      required\n                      placeholder={selectedPortal === \'ADMIN\' ? \'e.g. owner@caricloud.ph or atemaria\' : \'e.g. cashier@caricloud.ph or juana\'}\n                      value={identifier}\n                      onChange={(e) => {\n                        setIdentifier(e.target.value);\n                        setErrorMsg(\'\');\n                      }}\n                      className=\"w-full pl-10 pr-4 py-3 text-sm border border-[#E8E2DD] rounded-xl focus:ring-2 focus:ring-[#E65100] focus:outline-none text-[#2D241E] bg-[#FCFAF7]\"\n                    />\n                    <Mail className=\"w-4 h-4 text-[#756D67] absolute left-3.5 top-3.5\" />\n                  </div>\n                </div>\n\n                {/* Password Input */}\n                <div>\n                  <div className=\"flex items-center justify-between mb-1.5\">\n                    <label className=\"text-xs font-bold text-[#2D241E]\">\n                      Account Password\n                    </label>\n                    <button\n                      type=\"button\"\n                      onClick={() => {\n                        setIsForgotModalOpen(true);\n                        setForgotStep(1);\n                        setForgotError(\'\');\n                        setForgotSuccess(\'\');\n                        if (identifier) setResetEmail(identifier);\n                      }}\n                      className=\"text-xs font-bold text-[#E65100] hover:underline cursor-pointer\"\n                    >\n                      Forgot Password?\n                    </button>\n                  </div>\n\n                  <div className=\"relative\">\n                    <input\n                      type={showPassword ? \'text\' : \'password\'}\n                      required\n                      placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n                      value={password}\n                      onChange={(e) => {\n                        setPassword(e.target.value);\n                        setErrorMsg(\'\');\n                      }}\n                      className=\"w-full pl-10 pr-10 py-3 text-sm border border-[#E8E2DD] rounded-xl focus:ring-2 focus:ring-[#E65100] focus:outline-none text-[#2D241E] bg-[#FCFAF7]\"\n                    />\n                    <Lock className=\"w-4 h-4 text-[#756D67] absolute left-3.5 top-3.5\" />\n                    <button\n                      type=\"button\"\n                      onClick={() => setShowPassword(!showPassword)}\n                      className=\"absolute right-3.5 top-3.5 text-[#756D67] hover:text-[#2D241E]\"\n                    >\n                      {showPassword ? <EyeOff className=\"w-4 h-4\" /> : <Eye className=\"w-4 h-4\" />}\n                    </button>\n                  </div>\n                </div>\n\n                {/* Error Banner */}\n                {errorMsg && (\n                  <div className=\"p-3 bg-red-50 border border-red-200 rounded-xl text-xs font-bold text-red-700 flex items-center gap-2 animate-fadeIn\">\n                    <AlertCircle className=\"w-4 h-4 shrink-0 text-red-600\" />\n                    <span>{errorMsg}</span>\n                  </div>\n                )}\n\n                {/* Submit Button */}\n                <button\n                  type=\"submit\"\n                  className=\"w-full py-3.5 bg-[#E65100] hover:bg-[#BF360C] text-white font-extrabold rounded-xl text-sm shadow-md transition cursor-pointer flex items-center justify-center space-x-2\"\n                >\n                  <span>LOG IN AS {selectedPortal === \'ADMIN\' ? \'OWNER\' : \'EMPLOYEE\'}</span>\n                  <ArrowRight className=\"w-4 h-4\" />\n                </button>\n\n              </form>\n\n              {/* Quick Demo Accounts Helper for the Selected Portal */}\n              <div className=\"pt-4 border-t border-[#E8E2DD] space-y-2\">\n                <span className=\"text-[10px] font-bold text-[#756D67] block text-center uppercase tracking-wider\">\n                  Test {selectedPortal === \'ADMIN\' ? \'Owner\' : \'Employee\'} Accounts\n                </span>\n\n                <div className=\"space-y-2\">\n                  {filteredDemoAccounts.map((acc) => (\n                    <button\n                      key={acc.id}\n                      type=\"button\"\n                      onClick={() => handleQuickFill(acc)}\n                      className=\"w-full p-2.5 rounded-xl border border-[#E8E2DD] bg-[#FCFAF7] hover:border-[#E65100] text-left flex items-center justify-between text-xs transition cursor-pointer\"\n                    >\n                      <div className=\"flex items-center space-x-2.5\">\n                        <div className=\"w-7 h-7 rounded-lg bg-orange-100 text-[#E65100] flex items-center justify-center font-bold text-xs\">\n                          {selectedPortal === \'ADMIN\' ? <Crown className=\"w-4 h-4\" /> : <User className=\"w-4 h-4\" />}\n                        </div>\n                        <div>\n                          <div className=\"font-extrabold text-[#2D241E]\">{acc.name}</div>\n                          <div className=\"text-[10px] text-[#756D67]\">\n                            {acc.email} \342\200\242 Pass: <code className=\"font-mono text-[#2D241E] font-bold\">{acc.password || \'password123\'}</code>\n                          </div>\n                        </div>\n                      </div>\n\n                      <span className=\"text-[10px] font-bold px-2 py-0.5 rounded bg-white border border-[#E8E2DD] text-[#E65100]\">\n                        Auto-Fill\n                      </span>\n                    </button>\n                  ))}\n                </div>\n              </div>\n\n            </div>\n\n          </div>\n        )}\n\n      </div>\n\n      {/* Forgot Password Modal */}\n      {isForgotModalOpen && (\n        <div className=\"fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 flex items-center justify-center p-4\">\n          <div className=\"bg-white rounded-3xl shadow-2xl max-w-md w-full p-6 space-y-5 border border-[#E8E2DD] animate-fadeIn\">\n            \n            <div className=\"flex items-center justify-between border-b border-[#E8E2DD] pb-3\">\n              <div className=\"flex items-center space-x-2\">\n                <div className=\"w-8 h-8 rounded-xl bg-[#FFF3E0] text-[#E65100] flex items-center justify-center\">\n                  <RefreshCw className=\"w-4 h-4\" />\n                </div>\n                <div>\n                  <h3 className=\"font-extrabold text-base text-[#2D241E]\">\n                    Reset Account Password\n                  </h3>\n                  <p className=\"text-[11px] text-[#756D67]\">\n                    Step {forgotStep} of 3 \342\200\242 Email Verification Code\n                  </p>\n                </div>\n              </div>\n\n              <button\n                type=\"button\"\n                onClick={() => setIsForgotModalOpen(false)}\n                className=\"text-[#756D67] hover:text-[#2D241E] font-bold text-sm px-2 py-1 rounded cursor-pointer\"\n              >\n                \342\234\225\n              </button>\n            </div>\n\n            {/* STEP 1: Enter Email */}\n            {forgotStep === 1 && (\n              <form onSubmit={handleSendResetCode} className=\"space-y-4\">\n                <p className=\"text-xs text-[#756D67] leading-relaxed\">\n                  Enter your registered account email or username. A 6-digit confirmation code will be generated to verify your identity.\n                </p>\n\n                <div>\n                  <label className=\"block text-xs font-bold text-[#2D241E] mb-1\">\n                    Email Address or Username\n                  </label>\n                  <input\n                    type=\"text\"\n                    required\n                    placeholder=\"e.g. owner@caricloud.ph or juana\"\n                    value={resetEmail}\n                    onChange={(e) => setResetEmail(e.target.value)}\n                    className=\"w-full px-3.5 py-2.5 text-sm border border-[#E8E2DD] rounded-xl focus:ring-2 focus:ring-[#E65100] focus:outline-none\"\n                  />\n                </div>\n\n                {forgotError && (\n                  <div className=\"p-2.5 bg-red-50 border border-red-200 rounded-xl text-xs font-bold text-red-700 flex items-center gap-1.5\">\n                    <AlertCircle className=\"w-4 h-4 shrink-0\" />\n                    <span>{forgotError}</span>\n                  </div>\n                )}\n\n                <div className=\"flex items-center justify-end space-x-2 pt-2\">\n                  <button\n                    type=\"button\"\n                    onClick={() => setIsForgotModalOpen(false)}\n                    className=\"px-4 py-2 text-xs font-bold text-[#756D67] cursor-pointer\"\n                  >\n                    Cancel\n                  </button>\n                  <button\n                    type=\"submit\"\n                    className=\"px-5 py-2.5 bg-[#E65100] hover:bg-[#BF360C] text-white font-bold text-xs rounded-xl flex items-center gap-1.5 shadow-xs cursor-pointer\"\n                  >\n                    <Send className=\"w-3.5 h-3.5\" />\n                    <span>Send Reset Code</span>\n                  </button>\n                </div>\n              </form>\n            )}\n\n            {/* STEP 2: Verify Code */}\n            {forgotStep === 2 && (\n              <form onSubmit={handleVerifyCode} className=\"space-y-4\">\n                \n                {/* Simulated Email Notice */}\n                <div className=\"p-3 bg-amber-50 border border-amber-200 rounded-xl text-xs text-amber-900 space-y-1\">\n                  <div className=\"font-bold flex items-center gap-1\">\n                    <Mail className=\"w-4 h-4 text-amber-700\" />\n                    <span>Simulated Email Code Sent ({targetResetUser?.email})</span>\n                  </div>\n                  <p>\n                    Verification Code: <strong className=\"font-mono text-base text-[#E65100] bg-white px-2 py-0.5 rounded border border-amber-300\">{generatedCode}</strong>\n                  </p>\n                </div>\n\n                <div>\n                  <label className=\"block text-xs font-bold text-[#2D241E] mb-1\">\n                    Enter 6-Digit Email Code\n                  </label>\n                  <input\n                    type=\"text\"\n                    maxLength={6}\n                    required\n                    placeholder=\"123456\"\n                    value={enteredCode}\n                    onChange={(e) => setEnteredCode(e.target.value)}\n                    className=\"w-full font-mono text-center tracking-widest text-2xl font-black px-4 py-2.5 border border-[#E8E2DD] rounded-xl focus:ring-2 focus:ring-[#E65100] focus:outline-none\"\n                  />\n                </div>\n\n                {forgotError && (\n                  <div className=\"p-2.5 bg-red-50 border border-red-200 rounded-xl text-xs font-bold text-red-700 flex items-center gap-1.5\">\n                    <AlertCircle className=\"w-4 h-4 shrink-0\" />\n                    <span>{forgotError}</span>\n                  </div>\n                )}\n\n                <div className=\"flex items-center justify-between pt-2\">\n                  <button\n                    type=\"button\"\n                    onClick={() => setForgotStep(1)}\n                    className=\"text-xs font-bold text-[#756D67] flex items-center gap-1 cursor-pointer\"\n                  >\n                    <ArrowLeft className=\"w-3.5 h-3.5\" />\n                    <span>Back</span>\n                  </button>\n\n                  <button\n                    type=\"submit\"\n                    className=\"px-5 py-2.5 bg-[#E65100] hover:bg-[#BF360C] text-white font-bold text-xs rounded-xl flex items-center gap-1.5 shadow-xs cursor-pointer\"\n                  >\n                    <CheckCircle2 className=\"w-4 h-4\" />\n                    <span>Confirm Code</span>\n                  </button>\n                </div>\n              </form>\n            )}\n\n            {/* STEP 3: Enter New Password */}\n            {forgotStep === 3 && (\n              <form onSubmit={handleResetPasswordSubmit} className=\"space-y-4\">\n                <p className=\"text-xs text-[#756D67]\">\n                  Enter new password for <strong>{targetResetUser?.name}</strong>.\n                </p>\n\n                <div>\n                  <label className=\"block text-xs font-bold text-[#2D241E] mb-1\">\n                    New Password\n                  </label>\n                  <input\n                    type=\"password\"\n                    required\n                    placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n                    value={newPassword}\n                    onChange={(e) => setNewPassword(e.target.value)}\n                    className=\"w-full px-3.5 py-2.5 text-sm border border-[#E8E2DD] rounded-xl focus:ring-2 focus:ring-[#E65100] focus:outline-none\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"block text-xs font-bold text-[#2D241E] mb-1\">\n                    Confirm New Password\n                  </label>\n                  <input\n                    type=\"password\"\n                    required\n                    placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n                    value={confirmNewPassword}\n                    onChange={(e) => setConfirmNewPassword(e.target.value)}\n                    className=\"w-full px-3.5 py-2.5 text-sm border border-[#E8E2DD] rounded-xl focus:ring-2 focus:ring-[#E65100] focus:outline-none\"\n                  />\n                </div>\n\n                {forgotError && (\n                  <div className=\"p-2.5 bg-red-50 border border-red-200 rounded-xl text-xs font-bold text-red-700 flex items-center gap-1.5\">\n                    <AlertCircle className=\"w-4 h-4 shrink-0\" />\n                    <span>{forgotError}</span>\n                  </div>\n                )}\n\n                <button\n                  type=\"submit\"\n                  className=\"w-full py-3 bg-[#E65100] hover:bg-[#BF360C] text-white font-extrabold text-xs rounded-xl shadow-xs cursor-pointer flex items-center justify-center space-x-1.5\"\n                >\n                  <CheckCircle2 className=\"w-4 h-4\" />\n                  <span>SAVE NEW PASSWORD & LOGIN</span>\n                </button>\n              </form>\n            )}\n\n          </div>\n        </div>\n      )}\n\n      {/* Footer Info */}\n      <div className=\"max-w-5xl mx-auto w-full text-center text-xs text-[#756D67] pt-6 border-t border-[#E8E2DD]\">\n        <p className=\"font-semibold\">CariCloud POS System \342\200\242 Marikina City SME Ordinance No. 2026-018 Compliant</p>\n      </div>\n\n    </div>\n  );\n};"
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  Building2, \n  ShieldCheck, \n  Lock, \n  ArrowRight, \n  Store, \n  KeyRound, \n  AlertCircle,\n  User,\n  Users,\n  Mail,\n  Eye,\n  EyeOff,\n  RefreshCw,\n  Send,\n  CheckCircle2,\n  ArrowLeft,\n  Crown,\n  UserCheck\n} from \'lucide-react\';\nimport { UserProfile, StoreSettings, Role } from \'../types\';\n\ninterface LoginLandingPageProps {\n  settings: StoreSettings;\n  staffAccounts: UserProfile[];\n  onLoginSuccess: (user: UserProfile) => void;\n  onUpdateStaffAccounts: (accounts: UserProfile[]) => void;\n}\n\nexport const LoginLandingPage: React.FC<LoginLandingPageProps> = ({\n  settings,\n  staffAccounts,\n  onLoginSuccess,\n  onUpdateStaffAccounts,\n}) => {\n  // Portal Selection State: null = Landing Screen, \'ADMIN\' = Owner Form, \'CASHIER\' = Employee Form\n  const [selectedPortal, setSelectedPortal] = useState<Role | null>(null);\n\n  // Login form state\n  const [identifier, setIdentifier] = useState<string>(\'\'); // email or username\n  const [password, setPassword] = useState<string>(\'\');\n  const [showPassword, setShowPassword] = useState<boolean>(false);\n  const [errorMsg, setErrorMsg] = useState<string>(\'\');\n\n  // Forgot Password Flow State\n  const [isForgotModalOpen, setIsForgotModalOpen] = useState<boolean>(false);\n  const [forgotStep, setForgotStep] = useState<1 | 2 | 3>(1); // 1: Email input, 2: Code verification, 3: New password\n  const [resetEmail, setResetEmail] = useState<string>(\'\');\n  const [generatedCode, setGeneratedCode] = useState<string>(\'\');\n  const [enteredCode, setEnteredCode] = useState<string>(\'\');\n  const [newPassword, setNewPassword] = useState<string>(\'\');\n  const [confirmNewPassword, setConfirmNewPassword] = useState<string>(\'\');\n  const [forgotError, setForgotError] = useState<string>(\'\');\n  const [forgotSuccess, setForgotSuccess] = useState<string>(\'\');\n  const [targetResetUser, setTargetResetUser] = useState<UserProfile | null>(null);\n\n  // Quick fill helper for testing demo accounts\n  const handleQuickFill = (acc: UserProfile) => {\n    setIdentifier(acc.email || acc.username || acc.name);\n    setPassword(acc.password || \'password123\');\n    setErrorMsg(\'\');\n  };\n\n  const handleSelectPortal = (portalRole: Role) => {\n    setSelectedPortal(portalRole);\n    setErrorMsg(\'\');\n    setIdentifier(\'\');\n    setPassword(\'\');\n  };\n\n  const handleLoginSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    setErrorMsg(\'\');\n\n    if (!selectedPortal) return;\n\n    const query = identifier.trim().toLowerCase();\n    if (!query) {\n      setErrorMsg(\'Please enter your username or email address.\');\n      return;\n    }\n\n    if (!password) {\n      setErrorMsg(\'Please enter your account password.\');\n      return;\n    }\n\n    // Find account by email, username, or name match\n    const foundUser = staffAccounts.find((acc) => {\n      const matchEmail = acc.email && acc.email.toLowerCase() === query;\n      const matchUsername = acc.username && acc.username.toLowerCase() === query;\n      const matchName = acc.name.toLowerCase().includes(query);\n      return matchEmail || matchUsername || matchName;\n    });\n\n    if (!foundUser) {\n      setErrorMsg(\'Account not found. Please check your username/email address.\');\n      return;\n    }\n\n    // ROLE VALIDATION CHECK\n    if (selectedPortal === \'CASHIER\' && foundUser.role === \'ADMIN\') {\n      setErrorMsg(\"This is an Owner\'s Account. Please input an Employee Account.\");\n      return;\n    }\n\n    if (selectedPortal === \'ADMIN\' && foundUser.role === \'CASHIER\') {\n      setErrorMsg(\"This is an Employee\'s Account. Please input an Owner Account.\");\n      return;\n    }\n\n    // Check password\n    const expectedPassword = foundUser.password || \'password123\';\n    if (password === expectedPassword) {\n      onLoginSuccess(foundUser);\n    } else {\n      setErrorMsg(\'Incorrect password. Please try again or click \"Forgot Password?\" to reset.\');\n    }\n  };\n\n  // --- FORGOT PASSWORD HANDLERS ---\n  const handleSendResetCode = (e: React.FormEvent) => {\n    e.preventDefault();\n    setForgotError(\'\');\n    setForgotSuccess(\'\');\n\n    const query = resetEmail.trim().toLowerCase();\n    if (!query) {\n      setForgotError(\'Please enter your registered email address or username.\');\n      return;\n    }\n\n    const found = staffAccounts.find((acc) => {\n      const matchEmail = acc.email && acc.email.toLowerCase() === query;\n      const matchUsername = acc.username && acc.username.toLowerCase() === query;\n      return matchEmail || matchUsername;\n    });\n\n    if (!found) {\n      setForgotError(\'No account registered under this email or username.\');\n      return;\n    }\n\n    // Generate random 6-digit confirmation code\n    const code = Math.floor(100000 + Math.random() * 900000).toString();\n    setGeneratedCode(code);\n    setTargetResetUser(found);\n    setForgotStep(2);\n    setForgotSuccess(`Verification code sent! Simulated email code for ${found.email}: ${code}`);\n  };\n\n  const handleVerifyCode = (e: React.FormEvent) => {\n    e.preventDefault();\n    setForgotError(\'\');\n\n    if (enteredCode.trim() !== generatedCode) {\n      setForgotError(\'Invalid confirmation code. Please check the simulated email notice above.\');\n      return;\n    }\n\n    setForgotStep(3);\n    setForgotError(\'\');\n    setForgotSuccess(\'Code confirmed! Please enter your new password.\');\n  };\n\n  const handleResetPasswordSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    setForgotError(\'\');\n\n    if (!newPassword || newPassword.length < 4) {\n      setForgotError(\'Password must be at least 4 characters long.\');\n      return;\n    }\n\n    if (newPassword !== confirmNewPassword) {\n      setForgotError(\'Passwords do not match. Please re-enter.\');\n      return;\n    }\n\n    if (!targetResetUser) return;\n\n    // Update account with new password\n    const updatedUser: UserProfile = {\n      ...targetResetUser,\n      password: newPassword,\n    };\n\n    const updatedAccounts = staffAccounts.map((acc) =>\n      acc.id === updatedUser.id ? updatedUser : acc\n    );\n\n    onUpdateStaffAccounts(updatedAccounts);\n\n    // Pre-fill login\n    setIdentifier(updatedUser.email || updatedUser.username || updatedUser.name);\n    setPassword(newPassword);\n\n    alert(`Password reset successful for ${updatedUser.name}! You can now log in.`);\n    setIsForgotModalOpen(false);\n    setForgotStep(1);\n    setEnteredCode(\'\');\n    setNewPassword(\'\');\n    setConfirmNewPassword(\'\');\n  };\n\n  const filteredDemoAccounts = staffAccounts.filter((acc) => \n    selectedPortal === \'ADMIN\' ? acc.role === \'ADMIN\' : acc.role === \'CASHIER\'\n  );\n\n  return (\n    <div className=\"min-h-screen bg-[#FAFAFA] text-slate-900 flex flex-col justify-between p-4 sm:p-8 md:p-12 font-sans selection:bg-orange-500 selection:text-white\">\n      \n      {/* Top Brand Header - Airmee Style */}\n      <div className=\"max-w-5xl mx-auto w-full flex items-center justify-between pb-8 border-b border-slate-100\">\n        <div className=\"flex items-center space-x-3.5\">\n          <div className=\"w-11 h-11 rounded-2xl bg-orange-600 flex items-center justify-center text-white font-black text-2xl shadow-airmee-orange\">\n            C\n          </div>\n          <div>\n            <h1 className=\"text-xl font-extrabold tracking-tight text-slate-900\">\n              CariCloud POS\n            </h1>\n            <p className=\"text-xs text-slate-500 font-medium\">\n              Marikina Carinderia Operating System\n            </p>\n          </div>\n        </div>\n\n        <div className=\"bg-white border border-slate-200/70 px-4 py-2 rounded-full text-xs text-slate-600 font-bold flex items-center gap-2 shadow-airmee\">\n          <Store className=\"w-4 h-4 text-orange-600\" />\n          <span>{settings.storeName} ({settings.branchName})</span>\n        </div>\n      </div>\n\n      {/* Main Content Container */}\n      <div className=\"max-w-4xl mx-auto w-full my-auto py-12\">\n        \n        {/* LANDING PAGE: SELECT OWNER OR EMPLOYEE LOGIN */}\n        {selectedPortal === null ? (\n          <div className=\"space-y-10 text-center max-w-2xl mx-auto animate-fadeIn\">\n            \n            <div className=\"space-y-4\">\n              <span className=\"bg-orange-50 text-orange-600 border border-orange-200/60 text-xs font-bold px-4 py-1.5 rounded-full uppercase tracking-wider inline-block\">\n                Account Access Portal\n              </span>\n              <h2 className=\"text-4xl sm:text-5xl font-black text-slate-900 tracking-tight leading-tight\">\n                Welcome to CariCloud POS\n              </h2>\n              <p className=\"text-sm text-slate-500 max-w-lg mx-auto leading-relaxed font-medium\">\n                Please select your login type below to access your designated Scandinavian-styled workspace.\n              </p>\n            </div>\n\n            {/* Portal Choice Cards */}\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-6 pt-2\">\n              \n              {/* Option 1: Login as Owner */}\n              <button\n                type=\"button\"\n                onClick={() => handleSelectPortal(\'ADMIN\')}\n                className=\"group relative bg-white rounded-3xl p-8 border border-slate-200/80 hover:border-orange-500 transition-all duration-300 shadow-airmee hover:shadow-airmee-hover text-left flex flex-col justify-between space-y-8 cursor-pointer hover:-translate-y-1\"\n              >\n                <div className=\"space-y-4\">\n                  <div className=\"w-14 h-14 rounded-2xl bg-orange-50 text-orange-600 flex items-center justify-center font-bold group-hover:bg-orange-600 group-hover:text-white transition-colors\">\n                    <Crown className=\"w-7 h-7\" />\n                  </div>\n\n                  <div>\n                    <span className=\"text-[10px] font-bold text-orange-600 bg-orange-50 px-3 py-1 rounded-full uppercase tracking-wider\">\n                      Store Proprietor\n                    </span>\n                    <h3 className=\"text-2xl font-black text-slate-900 mt-2\">\n                      Login as Owner\n                    </h3>\n                    <p className=\"text-xs text-slate-500 leading-relaxed mt-2 font-medium\">\n                      Access store management, menu pricing, BPLO tax relief tracking, and the complete Listahan (Utang) credit ledger.\n                    </p>\n                  </div>\n                </div>\n\n                <div className=\"pt-2 flex items-center text-xs font-extrabold text-orange-600 group-hover:translate-x-1 transition-transform\">\n                  <span>CONTINUE TO OWNER LOGIN</span>\n                  <ArrowRight className=\"w-4 h-4 ml-2\" />\n                </div>\n              </button>\n\n              {/* Option 2: Login as Employee */}\n              <button\n                type=\"button\"\n                onClick={() => handleSelectPortal(\'CASHIER\')}\n                className=\"group relative bg-white rounded-3xl p-8 border border-slate-200/80 hover:border-slate-800 transition-all duration-300 shadow-airmee hover:shadow-airmee-hover text-left flex flex-col justify-between space-y-8 cursor-pointer hover:-translate-y-1\"\n              >\n                <div className=\"space-y-4\">\n                  <div className=\"w-14 h-14 rounded-2xl bg-slate-100 text-slate-800 flex items-center justify-center font-bold group-hover:bg-slate-900 group-hover:text-white transition-colors\">\n                    <UserCheck className=\"w-7 h-7\" />\n                  </div>\n\n                  <div>\n                    <span className=\"text-[10px] font-bold text-slate-700 bg-slate-100 px-3 py-1 rounded-full uppercase tracking-wider\">\n                      Shift Staff / Cashier\n                    </span>\n                    <h3 className=\"text-2xl font-black text-slate-900 mt-2\">\n                      Login as Employee\n                    </h3>\n                    <p className=\"text-xs text-slate-500 leading-relaxed mt-2 font-medium\">\n                      Access active POS register, counter ordering, receipt printouts, and view customer credit repayment history.\n                    </p>\n                  </div>\n                </div>\n\n                <div className=\"pt-2 flex items-center text-xs font-extrabold text-slate-800 group-hover:translate-x-1 transition-transform\">\n                  <span>CONTINUE TO EMPLOYEE LOGIN</span>\n                  <ArrowRight className=\"w-4 h-4 ml-2\" />\n                </div>\n              </button>\n\n            </div>\n\n          </div>\n        ) : (\n          /* LOGIN FORM SCREEN FOR SELECTED ROLE */\n          <div className=\"max-w-md mx-auto w-full animate-fadeIn space-y-4\">\n            \n            <button\n              type=\"button\"\n              onClick={() => setSelectedPortal(null)}\n              className=\"text-xs font-bold text-slate-500 hover:text-orange-600 flex items-center gap-1.5 mb-2 cursor-pointer transition\"\n            >\n              <ArrowLeft className=\"w-4 h-4\" />\n              <span>Back to Portal Selection</span>\n            </button>\n\n            <div className=\"bg-white rounded-3xl p-8 border border-slate-200/80 shadow-airmee space-y-6\">\n              \n              <div className=\"text-center space-y-2\">\n                <span className={`text-[11px] font-extrabold px-3.5 py-1 rounded-full uppercase tracking-wider inline-block border ${\n                  selectedPortal === \'ADMIN\'\n                    ? \'bg-orange-50 text-orange-600 border-orange-200/60\'\n                    : \'bg-slate-100 text-slate-800 border-slate-200\'\n                }`}>\n                  {selectedPortal === \'ADMIN\' ? \'OWNER LOGIN PORTAL\' : \'EMPLOYEE LOGIN PORTAL\'}\n                </span>\n                <h2 className=\"text-2xl font-black text-slate-900 tracking-tight\">\n                  {selectedPortal === \'ADMIN\' ? \'Owner Sign In\' : \'Employee Sign In\'}\n                </h2>\n                <p className=\"text-xs text-slate-500 font-medium\">\n                  Enter your registered {selectedPortal === \'ADMIN\' ? \'Owner\' : \'Employee\'} username or email and password.\n                </p>\n              </div>\n\n              <form onSubmit={handleLoginSubmit} className=\"space-y-4\">\n                \n                {/* Username or Email Input */}\n                <div>\n                  <label className=\"block text-xs font-bold text-slate-800 mb-1.5\">\n                    {selectedPortal === \'ADMIN\' ? \'Owner Username or Email\' : \'Employee Username or Email\'}\n                  </label>\n                  <div className=\"relative\">\n                    <input\n                      type=\"text\"\n                      required\n                      placeholder={selectedPortal === \'ADMIN\' ? \'e.g. owner@caricloud.ph or atemaria\' : \'e.g. cashier@caricloud.ph or juana\'}\n                      value={identifier}\n                      onChange={(e) => {\n                        setIdentifier(e.target.value);\n                        setErrorMsg(\'\');\n                      }}\n                      className=\"w-full pl-10 pr-4 py-3 text-sm border border-slate-200 rounded-2xl focus:ring-2 focus:ring-orange-500 focus:outline-none text-slate-900 bg-slate-50/50\"\n                    />\n                    <Mail className=\"w-4 h-4 text-slate-400 absolute left-3.5 top-3.5\" />\n                  </div>\n                </div>\n\n                {/* Password Input */}\n                <div>\n                  <div className=\"flex items-center justify-between mb-1.5\">\n                    <label className=\"text-xs font-bold text-slate-800\">\n                      Account Password\n                    </label>\n                    <button\n                      type=\"button\"\n                      onClick={() => {\n                        setIsForgotModalOpen(true);\n                        setForgotStep(1);\n                        setForgotError(\'\');\n                        setForgotSuccess(\'\');\n                        if (identifier) setResetEmail(identifier);\n                      }}\n                      className=\"text-xs font-bold text-orange-600 hover:underline cursor-pointer\"\n                    >\n                      Forgot Password?\n                    </button>\n                  </div>\n\n                  <div className=\"relative\">\n                    <input\n                      type={showPassword ? \'text\' : \'password\'}\n                      required\n                      placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n                      value={password}\n                      onChange={(e) => {\n                        setPassword(e.target.value);\n                        setErrorMsg(\'\');\n                      }}\n                      className=\"w-full pl-10 pr-10 py-3 text-sm border border-slate-200 rounded-2xl focus:ring-2 focus:ring-orange-500 focus:outline-none text-slate-900 bg-slate-50/50\"\n                    />\n                    <Lock className=\"w-4 h-4 text-slate-400 absolute left-3.5 top-3.5\" />\n                    <button\n                      type=\"button\"\n                      onClick={() => setShowPassword(!showPassword)}\n                      className=\"absolute right-3.5 top-3.5 text-slate-400 hover:text-slate-700\"\n                    >\n                      {showPassword ? <EyeOff className=\"w-4 h-4\" /> : <Eye className=\"w-4 h-4\" />}\n                    </button>\n                  </div>\n                </div>\n\n                {/* Error Banner */}\n                {errorMsg && (\n                  <div className=\"p-3 bg-red-50 border border-red-200 rounded-2xl text-xs font-bold text-red-700 flex items-center gap-2 animate-fadeIn\">\n                    <AlertCircle className=\"w-4 h-4 shrink-0 text-red-600\" />\n                    <span>{errorMsg}</span>\n                  </div>\n                )}\n\n                {/* Submit Button - Airmee Pill Style */}\n                <button\n                  type=\"submit\"\n                  className=\"w-full py-3.5 bg-orange-600 hover:bg-orange-700 text-white font-extrabold rounded-full text-sm shadow-airmee-orange transition-all cursor-pointer flex items-center justify-center space-x-2\"\n                >\n                  <span>LOG IN AS {selectedPortal === \'ADMIN\' ? \'OWNER\' : \'EMPLOYEE\'}</span>\n                  <ArrowRight className=\"w-4 h-4\" />\n                </button>\n\n              </form>\n\n              {/* Quick Demo Accounts Helper for the Selected Portal */}\n              <div className=\"pt-4 border-t border-slate-100 space-y-2\">\n                <span className=\"text-[10px] font-bold text-slate-400 block text-center uppercase tracking-wider\">\n                  Quick Demo Accounts ({selectedPortal === \'ADMIN\' ? \'Owner\' : \'Employee\'})\n                </span>\n\n                <div className=\"space-y-2\">\n                  {filteredDemoAccounts.map((acc) => (\n                    <button\n                      key={acc.id}\n                      type=\"button\"\n                      onClick={() => handleQuickFill(acc)}\n                      className=\"w-full p-3 rounded-2xl border border-slate-200/80 bg-slate-50/50 hover:border-orange-500 text-left flex items-center justify-between text-xs transition cursor-pointer\"\n                    >\n                      <div className=\"flex items-center space-x-3\">\n                        <div className=\"w-8 h-8 rounded-xl bg-orange-100 text-orange-600 flex items-center justify-center font-bold text-xs\">\n                          {selectedPortal === \'ADMIN\' ? <Crown className=\"w-4 h-4\" /> : <User className=\"w-4 h-4\" />}\n                        </div>\n                        <div>\n                          <div className=\"font-extrabold text-slate-900\">{acc.name}</div>\n                          <div className=\"text-[10px] text-slate-500 font-medium\">\n                            {acc.email} \342\200\242 Pass: <code className=\"font-mono text-slate-800 font-bold\">{acc.password || \'password123\'}</code>\n                          </div>\n                        </div>\n                      </div>\n\n                      <span className=\"text-[10px] font-extrabold px-2.5 py-1 rounded-full bg-white border border-slate-200 text-orange-600\">\n                        Auto-Fill\n                      </span>\n                    </button>\n                  ))}\n                </div>\n              </div>\n\n            </div>\n\n          </div>\n        )}\n\n      </div>\n\n      {/* Forgot Password Modal */}\n      {isForgotModalOpen && (\n        <div className=\"fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 flex items-center justify-center p-4\">\n          <div className=\"bg-white rounded-3xl shadow-airmee-hover max-w-md w-full p-6 sm:p-8 space-y-6 border border-slate-100 animate-fadeIn\">\n            \n            <div className=\"flex items-center justify-between border-b border-slate-100 pb-4\">\n              <div className=\"flex items-center space-x-3\">\n                <div className=\"w-9 h-9 rounded-2xl bg-orange-50 text-orange-600 flex items-center justify-center\">\n                  <RefreshCw className=\"w-4 h-4\" />\n                </div>\n                <div>\n                  <h3 className=\"font-extrabold text-base text-slate-900\">\n                    Reset Password\n                  </h3>\n                  <p className=\"text-[11px] text-slate-500 font-medium\">\n                    Step {forgotStep} of 3 \342\200\242 Email Code\n                  </p>\n                </div>\n              </div>\n\n              <button\n                type=\"button\"\n                onClick={() => setIsForgotModalOpen(false)}\n                className=\"text-slate-400 hover:text-slate-600 font-bold text-sm p-1 rounded-full cursor-pointer\"\n              >\n                \342\234\225\n              </button>\n            </div>\n\n            {/* STEP 1: Enter Email */}\n            {forgotStep === 1 && (\n              <form onSubmit={handleSendResetCode} className=\"space-y-4\">\n                <p className=\"text-xs text-slate-500 leading-relaxed font-medium\">\n                  Enter your registered account email or username. A 6-digit verification code will be generated to verify your identity.\n                </p>\n\n                <div>\n                  <label className=\"block text-xs font-bold text-slate-800 mb-1\">\n                    Email Address or Username\n                  </label>\n                  <input\n                    type=\"text\"\n                    required\n                    placeholder=\"e.g. owner@caricloud.ph or juana\"\n                    value={resetEmail}\n                    onChange={(e) => setResetEmail(e.target.value)}\n                    className=\"w-full px-4 py-3 text-sm border border-slate-200 rounded-2xl focus:ring-2 focus:ring-orange-500 focus:outline-none\"\n                  />\n                </div>\n\n                {forgotError && (\n                  <div className=\"p-3 bg-red-50 border border-red-200 rounded-2xl text-xs font-bold text-red-700 flex items-center gap-1.5\">\n                    <AlertCircle className=\"w-4 h-4 shrink-0\" />\n                    <span>{forgotError}</span>\n                  </div>\n                )}\n\n                <div className=\"flex items-center justify-end space-x-2 pt-2\">\n                  <button\n                    type=\"button\"\n                    onClick={() => setIsForgotModalOpen(false)}\n                    className=\"px-4 py-2 text-xs font-bold text-slate-500 hover:text-slate-800 cursor-pointer\"\n                  >\n                    Cancel\n                  </button>\n                  <button\n                    type=\"submit\"\n                    className=\"px-5 py-2.5 bg-orange-600 hover:bg-orange-700 text-white font-extrabold text-xs rounded-full flex items-center gap-1.5 shadow-airmee-orange cursor-pointer\"\n                  >\n                    <Send className=\"w-3.5 h-3.5\" />\n                    <span>Send Reset Code</span>\n                  </button>\n                </div>\n              </form>\n            )}\n\n            {/* STEP 2: Verify Code */}\n            {forgotStep === 2 && (\n              <form onSubmit={handleVerifyCode} className=\"space-y-4\">\n                \n                {/* Simulated Email Notice */}\n                <div className=\"p-3 bg-orange-50/80 border border-orange-200/60 rounded-2xl text-xs text-orange-900 space-y-1\">\n                  <div className=\"font-bold flex items-center gap-1.5\">\n                    <Mail className=\"w-4 h-4 text-orange-600\" />\n                    <span>Simulated Email Sent ({targetResetUser?.email})</span>\n                  </div>\n                  <p className=\"font-medium\">\n                    Code: <strong className=\"font-mono text-base text-orange-600 bg-white px-2 py-0.5 rounded-full border border-orange-200\">{generatedCode}</strong>\n                  </p>\n                </div>\n\n                <div>\n                  <label className=\"block text-xs font-bold text-slate-800 mb-1\">\n                    Enter 6-Digit Email Code\n                  </label>\n                  <input\n                    type=\"text\"\n                    maxLength={6}\n                    required\n                    placeholder=\"123456\"\n                    value={enteredCode}\n                    onChange={(e) => setEnteredCode(e.target.value)}\n                    className=\"w-full font-mono text-center tracking-widest text-2xl font-black px-4 py-3 border border-slate-200 rounded-2xl focus:ring-2 focus:ring-orange-500 focus:outline-none\"\n                  />\n                </div>\n\n                {forgotError && (\n                  <div className=\"p-3 bg-red-50 border border-red-200 rounded-2xl text-xs font-bold text-red-700 flex items-center gap-1.5\">\n                    <AlertCircle className=\"w-4 h-4 shrink-0\" />\n                    <span>{forgotError}</span>\n                  </div>\n                )}\n\n                <div className=\"flex items-center justify-between pt-2\">\n                  <button\n                    type=\"button\"\n                    onClick={() => setForgotStep(1)}\n                    className=\"text-xs font-bold text-slate-500 flex items-center gap-1 cursor-pointer\"\n                  >\n                    <ArrowLeft className=\"w-3.5 h-3.5\" />\n                    <span>Back</span>\n                  </button>\n\n                  <button\n                    type=\"submit\"\n                    className=\"px-5 py-2.5 bg-orange-600 hover:bg-orange-700 text-white font-extrabold text-xs rounded-full flex items-center gap-1.5 shadow-airmee-orange cursor-pointer\"\n                  >\n                    <CheckCircle2 className=\"w-4 h-4\" />\n                    <span>Confirm Code</span>\n                  </button>\n                </div>\n              </form>\n            )}\n\n            {/* STEP 3: Enter New Password */}\n            {forgotStep === 3 && (\n              <form onSubmit={handleResetPasswordSubmit} className=\"space-y-4\">\n                <p className=\"text-xs text-slate-500 font-medium\">\n                  Enter new password for <strong>{targetResetUser?.name}</strong>.\n                </p>\n\n                <div>\n                  <label className=\"block text-xs font-bold text-slate-800 mb-1\">\n                    New Password\n                  </label>\n                  <input\n                    type=\"password\"\n                    required\n                    placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n                    value={newPassword}\n                    onChange={(e) => setNewPassword(e.target.value)}\n                    className=\"w-full px-4 py-3 text-sm border border-slate-200 rounded-2xl focus:ring-2 focus:ring-orange-500 focus:outline-none\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"block text-xs font-bold text-slate-800 mb-1\">\n                    Confirm New Password\n                  </label>\n                  <input\n                    type=\"password\"\n                    required\n                    placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n                    value={confirmNewPassword}\n                    onChange={(e) => setConfirmNewPassword(e.target.value)}\n                    className=\"w-full px-4 py-3 text-sm border border-slate-200 rounded-2xl focus:ring-2 focus:ring-orange-500 focus:outline-none\"\n                  />\n                </div>\n\n                {forgotError && (\n                  <div className=\"p-3 bg-red-50 border border-red-200 rounded-2xl text-xs font-bold text-red-700 flex items-center gap-1.5\">\n                    <AlertCircle className=\"w-4 h-4 shrink-0\" />\n                    <span>{forgotError}</span>\n                  </div>\n                )}\n\n                <button\n                  type=\"submit\"\n                  className=\"w-full py-3.5 bg-orange-600 hover:bg-orange-700 text-white font-extrabold text-xs rounded-full shadow-airmee-orange cursor-pointer flex items-center justify-center space-x-1.5\"\n                >\n                  <CheckCircle2 className=\"w-4 h-4\" />\n                  <span>SAVE NEW PASSWORD & LOGIN</span>\n                </button>\n              </form>\n            )}\n\n          </div>\n        </div>\n      )}\n\n      {/* Footer Info */}\n      <div className=\"max-w-5xl mx-auto w-full text-center text-xs text-slate-400 pt-8 border-t border-slate-100 font-medium\">\n        <p>CariCloud POS System \342\200\242 Marikina City SME Ordinance No. 2026-018 Compliant</p>\n      </div>\n\n    </div>\n  );\n};\n"
