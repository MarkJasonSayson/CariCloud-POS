\',\n    name: \'Lumpiang Shanghai (4 pcs)\',\n    category: \'Ulam\',\n    price: 40,\n    halfPrice: 20,\n    isSoldOut: false,\n    allowHalfOrder: true,\n    description: \'Crispy fried pork spring rolls with sweet chili sauce.\',\n  },\n  {\n    id: \'m9\',\n    name: \'Plain Rice\',\n    category: \'Rice\',\n    price: 15,\n    isSoldOut: false,\n    allowHalfOrder: false,\n    description: \'Freshly steamed local white rice.\',\n  },\n  {\n    id: \'m10\',\n    name: \'Garlic Rice\',\n    category: \'Rice\',\n    price: 20,\n    isSoldOut: false,\n    allowHalfOrder: false,\n    description: \'Fragrant sinangag rice cooked with toasted garlic.\',\n  },\n  {\n    id: \'m11\',\n    name: \"Sago\'t Gulaman\",\n    category: \'Drinks\',\n    price: 20,\n    isSoldOut: false,\n    allowHalfOrder: false,\n    description: \'Refreshing cold beverage with tapioca pearls and gelatin in brown sugar syrup.\',\n  },\n  {\n    id: \'m12\',\n    name: \'Cold Pineapple Juice\',\n    category: \'Drinks\',\n    price: 25,\n    isSoldOut: false,\n    allowHalfOrder: false,\n    description: \'Chilled canned fruit juice.\',\n  },\n  {\n    id: \'m13\',\n    name: \'House Iced Tea\',\n    category: \'Drinks\',\n    price: 20,\n    isSoldOut: false,\n    allowHalfOrder: false,\n    description: \'Brewed iced tea with calamansi zest.\',\n  },\n  {\n    id: \'m14\',\n    name: \"Tokwa\'t Baboy\",\n    category: \'Snacks\',\n    price: 45,\n    isSoldOut: false,\n    allowHalfOrder: false,\n    description: \'Deep-fried tofu cubes and boiled pork mask in soy-vinegar dressing.\',\n  },\n  {\n    id: \'m15\',\n    name: \'Pancit Canton\',\n    category: \'Snacks\',\n    price: 50,\n    halfPrice: 25,\n    isSoldOut: false,\n    allowHalfOrder: true,\n    description: \'Stir-fried egg noodles with vegetables and pork strips.\',\n  },\n  {\n    id: \'m16\',\n    name: \'Special Halo-Halo\',\n    category: \'Specials\',\n    price: 60,\n    isSoldOut: false,\n    allowHalfOrder: false,\n