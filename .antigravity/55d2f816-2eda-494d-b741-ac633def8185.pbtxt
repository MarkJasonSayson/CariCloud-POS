          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const transactions = this.getTransactions();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    // Annual gross sales calculations (summing all completed transactions)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const currentAnnualGross = transactions.reduce((sum, tx) => sum + tx.totalAmount, 0) + 148500; // Adding historical sales baseline for Marikina demo"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const annualGrossThreshold = 250000; // Marikina Municipal Ordinance 2026"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    // Estimated quarterly breakdown"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const q1 = Math.round(currentAnnualGross * 0.28);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const q2 = Math.round(currentAnnualGross * 0.32);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const q3 = Math.round(currentAnnualGross * 0.24);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const q4 = Math.round(currentAnnualGross * 0.16);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const isEligibleForRelief = currentAnnualGross <= annualGrossThreshold;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    // Estimated tax savings at 1.5% local business tax rate"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const estimatedTaxSavings = isEligibleForRelief ? currentAnnualGross * 0.015 : 0;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    return {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      annualGrossThreshold,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
