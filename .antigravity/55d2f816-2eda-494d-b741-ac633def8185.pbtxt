  file_change {
    absolute_path_uri: "file:///src/components/LoginLandingPage.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  Building2, \n  UserCheck, \n  ShieldCheck, \n  Lock, \n  ArrowRight, \n  Store, \n  Utensils, \n  KeyRound, \n  AlertCircle,\n  Receipt,\n  Edit3,\n  Check,\n  User,\n  Users\n} from \'lucide-react\';\nimport { UserProfile, Role, StoreSettings } from \'../types\';\n\ninterface LoginLandingPageProps {\n  settings: StoreSettings;\n  staffAccounts: UserProfile[];\n  onLoginSuccess: (user: UserProfile) => void;\n}\n\nexport const LoginLandingPage: React.FC<LoginLandingPageProps> = ({\n  settings,\n  staffAccounts,\n  onLoginSuccess,\n}) => {\n  const [selectedAccount, setSelectedAccount] = useState<UserProfile | null>(null);\n  const [pinInput, setPinInput] = useState<string>(\'\');\n  const [errorMsg, setErrorMsg] = useState<string>(\'\');\n  const [filterRole, setFilterRole] = useState<\'ALL\' | \'ADMIN\' | \'CASHIER\'>(\'ALL\');\n\n  const handleSelectAccount = (user: UserProfile) => {\n    setSelectedAccount(user);\n    setPinInput(\'\');\n    setErrorMsg(\'\');\n  };\n\n  const handleAuthenticate = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!selectedAccount) return;\n\n    // Check entered PIN against user PIN or global setting override\n    const expectedPin = selectedAccount.role === \'ADMIN\' ? settings.adminPin : settings.cashierPin;\n    const isPinMatch = pinInput === selectedAccount.pin || pinInput === expectedPin;\n\n    if (isPinMatch) {\n      setErrorMsg(\'\');\n      onLoginSuccess(selectedAccount);\n    } else {\n      setErrorMsg(`Invalid security PIN entered for ${selectedAccount.name}. Please try again.`);\n    }\n  };\n\n  const filteredAccounts = staffAccounts.filter((acc) => {\n    if (filterRole === \'ADMIN\') return acc.role === \'ADMIN\';\n    if (filterRole === \'CASHIER\') return acc.role === \'CASHIER\';\n    return true;\n  });\n\n  return (\n    <div className=\"min-h-screen bg-[#FCFAF7] text-[#2D241E] flex flex-col justify-between p-4 sm:p-6 md:p-10 font-sans selection:bg-[#E65100] selection:text-white\">\n      \n      {/* Top Brand Bar */}\n      <div className=\"max-w-5xl mx-auto w-full flex items-center justify-between pb-6 border-b border-[#E8E2DD]\">\n        <div className=\"flex items-center space-x-3\">\n          <div className=\"w-10 h-10 rounded-xl bg-[#E65100] flex items-center justify-center text-white font-black text-xl shadow-xs\">\n            C\n          </div>\n          <div>\n            <h1 className=\"text-xl font-extrabold tracking-tight text-[#2D241E]\">\n              CariCloud POS\n            </h1>\n            <p className=\"text-xs text-[#756D67] font-medium\">\n              Marikina Carinderia Operating System\n            </p>\n          </div>\n        </div>\n\n        <div className=\"bg-white border border-[#E8E2DD] px-3.5 py-1.5 rounded-full text-xs text-[#756D67] font-semibold flex items-center gap-2 shadow-2xs\">\n          <Store className=\"w-3.5 h-3.5 text-[#E65100]\" />\n          <span>{settings.storeName} ({settings.branchName})</span>\n        </div>\n      </div>\n\n      {/* Main Login Selection Section */}\n      <div className=\"max-w-4xl mx-auto w-full my-auto py-8 space-y-6\">\n        \n        <div className=\"text-center max-w-2xl mx-auto space-y-2\">\n          <span className=\"bg-[#FFF3E0] text-[#E65100] text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider inline-block border border-[#E8E2DD]\">\n            Secure Account Authentication\n          </span>\n          <h2 className=\"text-2xl sm:text-3xl font-black text-[#2D241E] tracking-tight\">\n            Select Your Account to Sign In\n          </h2>\n          <p className=\"text-xs sm:text-sm text-[#756D67]\">\n            Account-based login system for store security. Select your owner or cashier account and enter your 4-digit PIN to open your workspace.\n          </p>\n        </div>\n\n        {/* Filter Role Tabs */}\n        <div className=\"flex justify-center space-x-2 border-b border-[#E8E2DD] pb-4\">\n          <button\n            type=\"button\"\n            onClick={() => setFilterRole(\'ALL\')}\n            className={`px-4 py-1.5 rounded-xl text-xs font-bold transition border ${\n              filterRole === \'ALL\'\n                ? \'bg-[#E65100] text-white border-[#E65100] shadow-2xs\'\n                : \'bg-white text-[#756D67] border-[#E8E2DD] hover:text-[#2D241E]\'\n            }`}\n          >\n            All Accounts ({staffAccounts.length})\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => setFilterRole(\'ADMIN\')}\n            className={`px-4 py-1.5 rounded-xl text-xs font-bold transition border ${\n              filterRole === \'ADMIN\'\n                ? \'bg-[#E65100] text-white border-[#E65100] shadow-2xs\'\n                : \'bg-white text-[#756D67] border-[#E8E2DD] hover:text-[#2D241E]\'\n            }`}\n          >\n            Store Owner Accounts\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => setFilterRole(\'CASHIER\')}\n            className={`px-4 py-1.5 rounded-xl text-xs font-bold transition border ${\n              filterRole === \'CASHIER\'\n                ? \'bg-[#E65100] text-white border-[#E65100] shadow-2xs\'\n                : \'bg-white text-[#756D67] border-[#E8E2DD] hover:text-[#2D241E]\'\n            }`}\n          >\n            Employee Cashier Accounts\n          </button>\n        </div>\n\n        {/* Accounts Cards Grid */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n          {filteredAccounts.map((account) => {\n            const isSelected = selectedAccount?.id === account.id;\n            const isOwner = account.role === \'ADMIN\';\n\n            return (\n              <div\n                key={account.id}\n                onClick={() => handleSelectAccount(account)}\n                className={`bg-white rounded-2xl border p-5 transition-all cursor-pointer relative flex flex-col justify-between ${\n                  isSelected\n                    ? \'border-[#E65100] shadow-md ring-2 ring-[#E65100]/20 bg-[#FCFAF7]\'\n                    : \'border-[#E8E2DD] shadow-2xs hover:border-[#E65100]/60 hover:shadow-xs\'\n                }`}\n              >\n                {isSelected && (\n                  <div className=\"absolute top-3.5 right-3.5 bg-[#E65100] text-white p-1 rounded-full\">\n                    <Check className=\"w-3.5 h-3.5 stroke-[3]\" />\n                  </div>\n                )}\n\n                <div className=\"space-y-3\">\n                  <div className=\"flex items-center space-x-3\">\n                    {account.avatar ? (\n                      <img\n                        src={account.avatar}\n                        alt={account.name}\n                        className=\"w-11 h-11 rounded-xl object-cover border border-[#E8E2DD] shrink-0\"\n                        referrerPolicy=\"no-referrer\"\n                      />\n                    ) : (\n                      <div className={`w-11 h-11 rounded-xl flex items-center justify-center font-bold text-base shrink-0 ${\n                        isOwner ? \'bg-orange-100 text-[#E65100]\' : \'bg-amber-100 text-amber-800\'\n                      }`}>\n                        {isOwner ? <ShieldCheck className=\"w-5 h-5\" /> : <User className=\"w-5 h-5\" />}\n                      </div>\n                    )}\n\n                    <div className=\"min-w-0 flex-1\">\n                      <span className={`text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded inline-block ${\n                        isOwner ? \'bg-orange-50 text-[#E65100] border border-orange-200\' : \'bg-amber-50 text-amber-800 border border-amber-200\'\n                      }`}>\n                        {isOwner ? \'Store Owner\' : \'Employee Cashier\'}\n                      </span>\n                      <h3 className=\"text-sm font-extrabold text-[#2D241E] truncate mt-0.5\">\n                        {account.name}\n                      </h3>\n                    </div>\n                  </div>\n\n                  <p className=\"text-xs text-[#756D67] leading-relaxed line-clamp-2\">\n                    {isOwner\n                      ? \'Full store governance: Menu editing, prices, EOD financial reports, and tax compliance.\'\n                      : \'Front-of-house order processing, payments (Cash/QR Ph/Listahan), and receipts archive access.\'}\n                  </p>\n                </div>\n\n                <div className=\"mt-4 pt-3 border-t border-[#E8E2DD] flex items-center justify-between text-xs\">\n                  <span className=\"font-bold text-[#756D67]\">\n                    PIN: <code className=\"bg-[#FCFAF7] px-1.5 py-0.5 rounded border font-mono text-[#2D241E]\">{account.pin}</code>\n                  </span>\n                  <span className={`font-bold flex items-center gap-1 ${isSelected ? \'text-[#E65100]\' : \'text-[#756D67]\'}`}>\n                    <span>Select</span>\n                    <ArrowRight className=\"w-3.5 h-3.5\" />\n                  </span>\n                </div>\n              </div>\n            );\n          })}\n        </div>\n\n        {/* PIN Entry Form Modal/Section when an account is selected */}\n        {selectedAccount && (\n          <form\n            onSubmit={handleAuthenticate}\n            className=\"bg-white rounded-2xl p-6 border border-[#E8E2DD] shadow-md max-w-md mx-auto space-y-4 animate-fadeIn\"\n          >\n            <div className=\"text-center space-y-1\">\n              <div className=\"inline-flex items-center justify-center w-9 h-9 rounded-full bg-[#FFF3E0] text-[#E65100] mb-1\">\n                <KeyRound className=\"w-4 h-4\" />\n              </div>\n              <h4 className=\"font-extrabold text-[#2D241E] text-base\">\n                Sign In as {selectedAccount.name}\n              </h4>\n              <p className=\"text-xs text-[#756D67]\">\n                Enter 4-digit PIN for {selectedAccount.role === \'ADMIN\' ? \'Owner Admin\' : \'Employee Cashier\'} workspace\n              </p>\n            </div>\n\n            <div>\n              <input\n                type=\"password\"\n                maxLength={4}\n                autoFocus\n                required\n                placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\"\n                value={pinInput}\n                onChange={(e) => {\n                  setPinInput(e.target.value);\n                  setErrorMsg(\'\');\n                }}\n                className=\"w-full font-mono text-center tracking-widest font-black text-3xl px-4 py-3 border border-[#E8E2DD] rounded-xl focus:ring-2 focus:ring-[#E65100] focus:outline-none text-[#2D241E]\"\n              />\n            </div>\n\n            {errorMsg && (\n              <div className=\"p-2.5 bg-red-50 border border-red-200 rounded-xl text-xs font-bold text-red-700 flex items-center justify-center gap-1.5\">\n                <AlertCircle className=\"w-4 h-4 shrink-0\" />\n                <span>{errorMsg}</span>\n              </div>\n            )}\n\n            <button\n              type=\"submit\"\n              className=\"w-full py-3.5 bg-[#E65100] hover:bg-[#BF360C] text-white font-extrabold rounded-xl text-sm shadow-xs transition cursor-pointer flex items-center justify-center space-x-2\"\n            >\n              <span>SIGN IN TO {selectedAccount.role === \'ADMIN\' ? \'OWNER WORKSPACE\' : \'EMPLOYEE POS\'}</span>\n              <ArrowRight className=\"w-4 h-4\" />\n            </button>\n          </form>\n        )}\n\n      </div>\n\n      {/* Footer info */}\n      <div className=\"max-w-5xl mx-auto w-full text-center text-xs text-[#756D67] pt-6 border-t border-[#E8E2DD]\">\n        <p className=\"font-semibold\">CariCloud POS System \342\200\242 Marikina City SME Ordinance No. 2026-018 Compliant</p>\n      </div>\n\n    </div>\n  );\n};\n"
    }
