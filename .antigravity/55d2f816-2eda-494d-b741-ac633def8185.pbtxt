  file_change {
    absolute_path_uri: "file:///src/components/CheckoutModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { \n  X, \n  Banknote, \n  QrCode, \n  BookOpen, \n  CheckCircle2, \n  AlertTriangle, \n  ShieldCheck, \n  RefreshCw, \n  Sparkles,\n  User,\n  Lock\n} from \'lucide-react\';\nimport { CartItem, DiscountDetails, PaymentMethod, CustomerCredit, Transaction } from \'../types\';\n\ninterface CheckoutModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  cart: CartItem[];\n  subtotal: number;\n  discount: DiscountDetails;\n  totalAmount: number;\n  customers: CustomerCredit[];\n  cashierName: string;\n  adminPin: string;\n  onComplete: (tx: Transaction) => void;\n  onOpenPinModal: (reason: string, onSuccess: () => void) => void;\n}\n\nexport const CheckoutModal: React.FC<CheckoutModalProps> = ({\n  isOpen,\n  onClose,\n  cart,\n  subtotal,\n  discount,\n  totalAmount,\n  customers,\n  cashierName,\n  adminPin,\n  onComplete,\n  onOpenPinModal,\n}) => {\n  const [paymentMethod, setPaymentMethod] = useState<PaymentMethod>(\'CASH\');\n\n  // CASH State\n  const [tenderedAmount, setTenderedAmount] = useState<number>(Math.ceil(totalAmount));\n  \n  // E-WALLET State\n  const [qrLoading, setQrLoading] = useState<boolean>(false);\n  const [paymongoData, setPaymongoData] = useState<{ qrCodeUrl: string; paymongoRef: string } | null>(null);\n  const [paymongoVerified, setPaymongoVerified] = useState<boolean>(false);\n  const [verifyingWebhook, setVerifyingWebhook] = useState<boolean>(false);\n\n  // LISTAHAN CREDIT State\n  const [selectedCustomerId, setSelectedCustomerId] = useState<string>(\'\');\n  const [adminOverrideGranted, setAdminOverrideGranted] = useState<boolean>(false);\n\n  useEffect(() => {\n    setTenderedAmount(Math.ceil(totalAmount));\n  }, [totalAmount]);\n\n  useEffect(() => {\n    if (paymentMethod === \'E_WALLET\' && !paymongoData) {\n      generatePaymongoQR();\n    }\n  }, [paymentMethod]);\n\n  if (!isOpen) return null;\n\n  const changeAmount = Math.max(0, tenderedAmount - totalAmount);\n  const isCashInsufficient = tenderedAmount < totalAmount;\n\n  // Find selected customer for Listahan\n  const selectedCustomer = customers.find((c) => c.id === selectedCustomerId);\n  const isOverCreditLimit = selectedCustomer\n    ? selectedCustomer.currentDebt + totalAmount > selectedCustomer.creditLimit\n    : false;\n\n  const generatePaymongoQR = async () => {\n    setQrLoading(true);\n    try {\n      const response = await fetch(\'/api/paymongo/generate-qr\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ amount: totalAmount, receiptNo: \'CC-DRAFT\' }),\n      });\n      const data = await response.json();\n      if (data.success) {\n        setPaymongoData({\n          qrCodeUrl: data.qrCodeUrl,\n          paymongoRef: data.paymongoRef,\n        });\n      }\n    } catch {\n      // Fallback offline generation\n      const mockRef = \'PM-QRPH-\' + Math.floor(100000 + Math.random() * 900000);\n      setPaymongoData({\n        qrCodeUrl: `https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=PAYMONGO_${mockRef}`,\n        paymongoRef: mockRef,\n      });\n    } finally {\n      setQrLoading(false);\n    }\n  };\n\n  const handleSimulateWebhookVerification = async () => {\n    if (!paymongoData) return;\n    setVerifyingWebhook(true);\n    try {\n      await new Promise((r) => setTimeout(r, 1200)); // Simulate webhook roundtrip\n      const response = await fetch(\'/api/webhook/paymongo\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ paymongoRef: paymongoData.paymongoRef }),\n      });\n      const data = await response.json();\n      if (data.verified) {\n        setPaymongoVerified(true);\n      }\n    } catch {\n      setPaymongoVerified(true);\n    } finally {\n      setVerifyingWebhook(false);\n    }\n  };\n\n  const handleFinalizeTransaction = () => {\n    // Validation checks\n    if (paymentMethod === \'CASH\' && isCashInsufficient) {\n      alert(\'Tendered cash amount is less than total due.\');\n      return;\n    }\n\n    if (paymentMethod === \'E_WALLET\' && !paymongoVerified) {\n      alert(\'Please verify the PayMongo QR Ph payment before finalizing.\');\n      return;\n    }\n\n    if (paymentMethod === \'LISTAHAN_CREDIT\') {\n      if (!selectedCustomer) {\n        alert(\'Please select a customer for Listahan credit checkout.\');\n        return;\n      }\n\n      if (isOverCreditLimit && !adminOverrideGranted) {\n        // Prompt Admin PIN Modal override\n        onOpenPinModal(\n          `Customer ${selectedCustomer.name} exceeds credit limit (\342\202\261${selectedCustomer.currentDebt + totalAmount} / \342\202\261${selectedCustomer.creditLimit}). Manager PIN override required.`,\n          () => {\n            setAdminOverrideGranted(true);\n            executeFinalize(\'LISTAHAN_CREDIT\');\n          }\n        );\n        return;\n      }\n    }\n\n    executeFinalize(paymentMethod);\n  };\n\n  const executeFinalize = (method: PaymentMethod) => {\n    const newTx: Transaction = {\n      id: \'tx-\' + Date.now(),\n      receiptNo: \'CC-\' + new Date().toISOString().replace(/[-:T.]/g, \'\').slice(0, 12),\n      timestamp: new Date().toISOString(),\n      items: cart,\n      subtotal,\n      discount: {\n        isSeniorOrPwd: discount.isSeniorOrPwd,\n        vatExemptAmount: discount.vatExemptAmount,\n        discountAmount: discount.discountAmount,\n      },\n      totalAmount,\n      paymentMethod: method,\n      tenderedAmount: method === \'CASH\' ? tenderedAmount : totalAmount,\n      changeAmount: method === \'CASH\' ? changeAmount : 0,\n      customerId: method === \'LISTAHAN_CREDIT\' ? selectedCustomer?.id : undefined,\n      customerName: method === \'LISTAHAN_CREDIT\' ? selectedCustomer?.name : undefined,\n      paymongoRef: method === \'E_WALLET\' ? paymongoData?.paymongoRef : undefined,\n      paymongoStatus: method === \'E_WALLET\' ? \'PAID\' : undefined,\n      cashierName,\n      syncedOffline: true,\n    };\n\n    onComplete(newTx);\n  };\n\n  return (\n    <div className=\"fixed inset-0 bg-slate-900/70 backdrop-blur-xs z-50 flex items-center justify-center p-4\">\n      <div className=\"bg-white rounded-2xl shadow-2xl max-w-2xl w-full border border-slate-200 overflow-hidden flex flex-col max-h-[90vh]\">\n        \n        {/* Header */}\n        <div className=\"p-4 bg-slate-900 text-white flex items-center justify-between\">\n          <div>\n            <h3 className=\"font-bold text-lg text-white\">Payment Settlement</h3>\n            <p className=\"text-xs text-slate-400\">Select payment path and complete transaction</p>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-1 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Modal Body */}\n        <div className=\"p-5 flex-1 overflow-y-auto space-y-5\">\n          \n          {/* Order Summary Ribbon */}\n          <div className=\"bg-orange-50 border border-orange-200 rounded-xl p-3.5 flex items-center justify-between\">\n            <div>\n              <span className=\"text-xs text-orange-800 font-bold uppercase tracking-wider block\">Total Amount Due</span>\n              <span className=\"text-2xl font-black text-orange-600\">\342\202\261{totalAmount.toFixed(2)}</span>\n            </div>\n            {discount.isSeniorOrPwd && (\n              <span className=\"bg-amber-100 text-amber-900 border border-amber-300 text-xs font-bold px-2.5 py-1 rounded-lg\">\n                SC/PWD Discount Applied\n              </span>\n            )}\n          </div>\n\n          {/* Payment Method Selector Tabs */}\n          <div>\n            <label className=\"block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2\">\n              Payment Path:\n            </label>\n            <div className=\"grid grid-cols-3 gap-2\">\n              \n              <button\n                type=\"button\"\n                onClick={() => setPaymentMethod(\'CASH\')}\n                className={`p-3 rounded-xl border font-bold text-xs flex flex-col items-center gap-1.5 transition ${\n                  paymentMethod === \'CASH\'\n                    ? \'bg-orange-600 text-white border-orange-600 shadow-md\'\n                    : \'bg-slate-50 text-slate-700 border-slate-200 hover:bg-slate-100\'\n                }`}\n              >\n                <Banknote className=\"w-5 h-5\" />\n                <span>Cash Tender</span>\n              </button>\n\n              <button\n                type=\"button\"\n                onClick={() => setPaymentMethod(\'E_WALLET\')}\n                className={`p-3 rounded-xl border font-bold text-xs flex flex-col items-center gap-1.5 transition ${\n                  paymentMethod === \'E_WALLET\'\n                    ? \'bg-orange-600 text-white border-orange-600 shadow-md\'\n                    : \'bg-slate-50 text-slate-700 border-slate-200 hover:bg-slate-100\'\n                }`}\n              >\n                <QrCode className=\"w-5 h-5\" />\n                <span>E-Wallet (QR Ph)</span>\n              </button>\n\n              <button\n                type=\"button\"\n                onClick={() => setPaymentMethod(\'LISTAHAN_CREDIT\')}\n                className={`p-3 rounded-xl border font-bold text-xs flex flex-col items-center gap-1.5 transition ${\n                  paymentMethod === \'LISTAHAN_CREDIT\'\n                    ? \'bg-orange-600 text-white border-orange-600 shadow-md\'\n                    : \'bg-slate-50 text-slate-700 border-slate-200 hover:bg-slate-100\'\n                }`}\n              >\n                <BookOpen className=\"w-5 h-5\" />\n                <span>Listahan (Credit)</span>\n              </button>\n\n            </div>\n          </div>\n\n          {/* TAB 1: CASH SETTLEMENT */}\n          {paymentMethod === \'CASH\' && (\n            <div className=\"space-y-4 bg-slate-50 border border-slate-200 rounded-xl p-4\">\n              <label className=\"block text-xs font-bold text-slate-700\">\n                Rapid Cash Tender Preset:\n              </label>\n\n              <div className=\"grid grid-cols-3 sm:grid-cols-6 gap-2\">\n                {[\n                  { label: \'Exact\', val: Math.ceil(totalAmount) },\n                  { label: \'\342\202\26150\', val: 50 },\n                  { label: \'\342\202\261100\', val: 100 },\n                  { label: \'\342\202\261200\', val: 200 },\n                  { label: \'\342\202\261500\', val: 500 },\n                  { label: \'\342\202\2611000\', val: 1000 },\n                ].map((preset) => (\n                  <button\n                    key={preset.label}\n                    onClick={() => setTenderedAmount(preset.val)}\n                    className=\"py-2 bg-white border border-slate-300 hover:border-orange-500 hover:bg-orange-50 rounded-lg text-xs font-black text-slate-800 transition\"\n                  >\n                    {preset.label}\n                  </button>\n                ))}\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-bold text-slate-700 mb-1\">\n                  Custom Cash Tendered (\342\202\261):\n                </label>\n                <input\n                  type=\"number\"\n                  step=\"1\"\n                  min={totalAmount}\n                  value={tenderedAmount || \'\'}\n                  onChange={(e) => setTenderedAmount(parseFloat(e.target.value) || 0)}\n                  className=\"w-full text-xl font-bold px-3 py-2 bg-white border border-slate-300 rounded-xl focus:ring-2 focus:ring-orange-500 focus:outline-none\"\n                />\n              </div>\n\n              {/* Change Box */}\n              <div\n                className={`p-3.5 rounded-xl border flex items-center justify-between ${\n                  isCashInsufficient\n                    ? \'bg-red-50 border-red-300 text-red-800\'\n                    : \'bg-emerald-50 border-emerald-300 text-emerald-900\'\n                }`}\n              >\n                <div>\n                  <span className=\"text-xs font-bold uppercase tracking-wider block\">\n                    {isCashInsufficient ? \'Insufficient Tender\' : \'Change Due to Customer\'}\n                  </span>\n                  <span className=\"text-2xl font-black\">\n                    \342\202\261{changeAmount.toFixed(2)}\n                  </span>\n                </div>\n                {!isCashInsufficient && (\n                  <CheckCircle2 className=\"w-8 h-8 text-emerald-600\" />\n                )}\n              </div>\n            </div>\n          )}\n\n          {/* TAB 2: E-WALLET (PAYMONGO QR PH) SETTLEMENT */}\n          {paymentMethod === \'E_WALLET\' && (\n            <div className=\"space-y-4 bg-slate-50 border border-slate-200 rounded-xl p-4 text-center\">\n              <div className=\"flex items-center justify-center space-x-2 text-slate-800\">\n                <span className=\"font-bold text-sm\">PayMongo QR Ph Dynamic Settlement</span>\n                <span className=\"bg-sky-100 text-sky-800 border border-sky-300 text-[10px] font-bold px-2 py-0.5 rounded\">\n                  GCash / Maya Compatible\n                </span>\n              </div>\n\n              {qrLoading ? (\n                <div className=\"py-8 flex flex-col items-center space-y-2\">\n                  <RefreshCw className=\"w-8 h-8 text-orange-600 animate-spin\" />\n                  <span className=\"text-xs text-slate-500 font-medium\">Generating QR Ph code via PayMongo API...</span>\n                </div>\n              ) : paymongoData ? (\n                <div className=\"space-y-3\">\n                  <div className=\"bg-white p-3 rounded-xl inline-block shadow-sm border border-slate-200\">\n                    <img\n                      src={paymongoData.qrCodeUrl}\n                      alt=\"PayMongo QR Ph\"\n                      className=\"w-48 h-48 mx-auto\"\n                    />\n                  </div>\n\n                  <p className=\"text-xs text-slate-600 font-mono\">\n                    Ref #: <span className=\"font-bold text-slate-900\">{paymongoData.paymongoRef}</span>\n                  </p>\n\n                  {/* Verification Status */}\n                  {paymongoVerified ? (\n                    <div className=\"bg-emerald-100 border border-emerald-300 text-emerald-900 p-3 rounded-xl font-bold text-xs flex items-center justify-center space-x-2\">\n                      <CheckCircle2 className=\"w-5 h-5 text-emerald-600\" />\n                      <span>Payment Verified \360\237\237\242 (PayMongo Webhook Received)</span>\n                    </div>\n                  ) : (\n                    <button\n                      type=\"button\"\n                      disabled={verifyingWebhook}\n                      onClick={handleSimulateWebhookVerification}\n                      className=\"w-full py-2.5 bg-sky-600 hover:bg-sky-700 text-white font-bold rounded-xl text-xs flex items-center justify-center space-x-2 transition shadow-sm\"\n                    >\n                      {verifyingWebhook ? (\n                        <>\n                          <RefreshCw className=\"w-4 h-4 animate-spin\" />\n                          <span>Polling PayMongo Webhook...</span>\n                        </>\n                      ) : (\n                        <>\n                          <ShieldCheck className=\"w-4 h-4\" />\n                          <span>Simulate Webhook Payment Check</span>\n                        </>\n                      )}\n                    </button>\n                  )}\n                </div>\n              ) : null}\n            </div>\n          )}\n\n          {/* TAB 3: LISTAHAN CREDIT (UTANG) SETTLEMENT */}\n          {paymentMethod === \'LISTAHAN_CREDIT\' && (\n            <div className=\"space-y-4 bg-slate-50 border border-slate-200 rounded-xl p-4\">\n              <div>\n                <label className=\"block text-xs font-bold text-slate-700 mb-1\">\n                  Select Suki / Customer Account:\n                </label>\n                <select\n                  value={selectedCustomerId}\n                  onChange={(e) => {\n                    setSelectedCustomerId(e.target.value);\n                    setAdminOverrideGranted(false);\n                  }}\n                  className=\"w-full px-3 py-2 text-sm bg-white border border-slate-300 rounded-xl focus:ring-2 focus:ring-orange-500 focus:outline-none\"\n                >\n                  <option value=\"\">-- Choose Suki Customer --</option>\n                  {customers.map((c) => (\n                    <option key={c.id} value={c.id}>\n                      {c.name} (Current Debt: \342\202\261{c.currentDebt} / Limit: \342\202\261{c.creditLimit})\n                    </option>\n                  ))}\n                </select>\n              </div>\n\n              {selectedCustomer && (\n                <div className=\"bg-white border border-slate-200 rounded-xl p-3.5 space-y-2 text-xs\">\n                  <div className=\"flex justify-between text-slate-700\">\n                    <span>Contact:</span>\n                    <span className=\"font-semibold\">{selectedCustomer.contact}</span>\n                  </div>\n                  <div className=\"flex justify-between text-slate-700\">\n                    <span>Current Unsettled Debt:</span>\n                    <span className=\"font-bold text-slate-900\">\342\202\261{selectedCustomer.currentDebt.toFixed(2)}</span>\n                  </div>\n                  <div className=\"flex justify-between text-slate-700\">\n                    <span>Authorized Credit Limit:</span>\n                    <span className=\"font-bold text-slate-900\">\342\202\261{selectedCustomer.creditLimit.toFixed(2)}</span>\n                  </div>\n                  <div className=\"flex justify-between text-slate-900 font-bold pt-2 border-t border-slate-100\">\n                    <span>New Debt Balance after this Order:</span>\n                    <span className={isOverCreditLimit ? \'text-red-600\' : \'text-emerald-700\'}>\n                      \342\202\261{(selectedCustomer.currentDebt + totalAmount).toFixed(2)}\n                    </span>\n                  </div>\n\n                  {isOverCreditLimit && (\n                    <div className=\"bg-red-50 border border-red-200 text-red-800 p-2.5 rounded-lg text-xs space-y-1\">\n                      <div className=\"flex items-center space-x-1 font-bold\">\n                        <AlertTriangle className=\"w-4 h-4 text-red-600\" />\n                        <span>Credit Limit Exceeded!</span>\n                      </div>\n                      <p className=\"text-[11px]\">\n                        Order total exceeds approved credit limit by \342\202\261\n                        {(selectedCustomer.currentDebt + totalAmount - selectedCustomer.creditLimit).toFixed(2)}. Manager digital override PIN required.\n                      </p>\n                      {adminOverrideGranted && (\n                        <div className=\"text-emerald-700 font-bold flex items-center gap-1 mt-1\">\n                          <ShieldCheck className=\"w-4 h-4 text-emerald-600\" />\n                          <span>Manager Override PIN Authorized!</span>\n                        </div>\n                      )}\n                    </div>\n                  )}\n                </div>\n              )}\n            </div>\n          )}\n\n        </div>\n\n        {/* Modal Footer */}\n        <div className=\"p-4 bg-slate-100 border-t border-slate-200 flex items-center justify-between\">\n          <button\n            type=\"button\"\n            onClick={onClose}\n            className=\"px-4 py-2.5 text-xs font-bold text-slate-600 hover:bg-slate-200 rounded-xl transition\"\n          >\n            Cancel\n          </button>\n\n          <button\n            type=\"button\"\n            onClick={handleFinalizeTransaction}\n            disabled={paymentMethod === \'CASH\' && isCashInsufficient}\n            className=\"px-6 py-3 bg-orange-600 hover:bg-orange-700 disabled:bg-slate-400 text-white font-black rounded-xl text-sm shadow-md transition flex items-center space-x-2\"\n          >\n            <CheckCircle2 className=\"w-5 h-5\" />\n            <span>FINALIZE & PRINT RECEIPT</span>\n          </button>\n        </div>\n\n      </div>\n    </div>\n  );\n};\n"
