        replacement_content: "export const INITIAL_STORE_SETTINGS: StoreSettings = {\n  storeName: \'CariCloud Eatery - Marikina\',\n  branchName: \'Shoe Avenue Branch\',\n  address: \'142 Shoe Avenue, Barangay San Roque, Marikina City 1800\',\n  tinNumber: \'248-910-334-000\',\n  bploPermitNo: \'MKN-BPLO-2026-08492\',\n  contactNumber: \'(02) 8645-1928 / 0917-123-4567\',\n  operationalMode: \'SINGLE_OPERATOR\',\n  themeColor: \'orange\',\n  activeTier: 3, // Set to Tier 3 so full features (Tax Relief, BPLO) can be showcased immediately while keeping toggle available\n};"
