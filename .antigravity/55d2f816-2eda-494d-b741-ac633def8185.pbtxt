    instruction: "Update MenuManagementModule styling to Airmee skin"
    replacement_infos {
      original_chunk {
        target_content: "  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6\">\n      \n      {/* Employee Restricted Notice Banner */}\n      {!isOwner && (\n        <div className=\"bg-amber-50 border border-amber-300 rounded-2xl p-4 flex items-start space-x-3 text-amber-900 shadow-2xs\">\n          <ShieldAlert className=\"w-5 h-5 text-amber-600 shrink-0 mt-0.5\" />\n          <div className=\"text-xs space-y-1\">\n            <h4 className=\"font-extrabold text-amber-900\">\n              Employee Read-Only View: Owner Permissions Required\n            </h4>\n            <p className=\"text-amber-800\">\n              You are currently logged in as an Employee Cashier. Menu editing (adding dishes, modifying prices, or deleting items) is strictly restricted to the Store Owner.\n            </p>\n          </div>\n        </div>\n      )}\n\n      {/* Header Bar */}\n      <div className=\"bg-white rounded-2xl shadow-2xs border border-[#E8E2DD] p-5 flex flex-col md:flex-row items-center justify-between gap-4\">\n        <div>\n          <h2 className=\"text-xl font-extrabold text-[#2D241E] flex items-center gap-2\">\n            <UtensilsCrossed className=\"w-5 h-5 text-[#E65100]\" />\n            Daily Menu Digitization & Stock Control\n          </h2>\n          <p className=\"text-xs text-[#756D67] mt-0.5\">\n            Manage carinderia rotating daily recipes, portion half-prices, and instant sold-out badges\n          </p>\n        </div>\n\n        {isOwner ? (\n          <button\n            onClick={handleOpenAdd}\n            className=\"w-full md:w-auto px-4 py-2.5 bg-[#E65100] hover:bg-[#BF360C] text-white font-extrabold rounded-xl text-xs flex items-center justify-center space-x-1.5 shadow-2xs transition cursor-pointer\"\n          >\n            <Plus className=\"w-4 h-4\" />\n            <span>Add New Dish Item</span>\n          </button>\n        ) : (\n          <div className=\"px-3.5 py-2 bg-[#FCFAF7] border border-[#E8E2DD] text-[#756D67] font-semibold rounded-xl text-xs flex items-center gap-1.5\">\n            <Lock className=\"w-3.5 h-3.5 text-amber-600\" />\n            <span>Owner Only Action</span>\n          </div>\n        )}\n      </div>\n\n      {/* Filter and Search Bar */}\n      <div className=\"bg-white rounded-2xl shadow-2xs border border-[#E8E2DD] p-3.5 space-y-3\">\n        <div className=\"flex flex-col sm:flex-row items-center justify-between gap-3\">\n          <div className=\"relative w-full sm:w-80\">\n            <Search className=\"w-4 h-4 absolute left-3 top-2.5 text-[#756D67]\" />\n            <input\n              type=\"text\"\n              placeholder=\"Search dishes to inspect stock or prices...\"\n              value={searchQuery}\n              onChange={(e) => setSearchQuery(e.target.value)}\n              className=\"w-full pl-9 pr-3 py-1.5 text-sm bg-[#FCFAF7] border border-[#E8E2DD] rounded-xl focus:outline-none focus:ring-2 focus:ring-[#E65100] text-[#2D241E]\"\n            />\n          </div>\n\n          <div className=\"flex space-x-1.5 overflow-x-auto w-full sm:w-auto pb-1 scrollbar-none\">\n            <button\n              onClick={() => setSelectedCategory(\'ALL\')}\n              className={`px-3.5 py-1.5 rounded-xl text-xs font-bold transition whitespace-nowrap border ${\n                selectedCategory === \'ALL\'\n                  ? \'bg-[#E65100] text-white border-[#E65100] shadow-2xs\'\n                  : \'bg-white text-[#756D67] border-[#E8E2DD] hover:text-[#2D241E]\'\n              }`}\n            >\n              All ({menuItems.length})\n            </button>\n            {CATEGORIES.map((cat) => (\n              <button\n                key={cat}\n                onClick={() => setSelectedCategory(cat)}\n                className={`px-3.5 py-1.5 rounded-xl text-xs font-bold transition whitespace-nowrap border ${\n                  selectedCategory === cat\n                    ? \'bg-[#E65100] text-white border-[#E65100] shadow-2xs\'\n                    : \'bg-white text-[#756D67] border-[#E8E2DD] hover:text-[#2D241E]\'\n                }`}\n              >\n                {cat}\n              </button>\n            ))}\n          </div>\n        </div>\n      </div>\n\n      {/* Menu Grid */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n        {filteredItems.map((item) => (\n          <div\n            key={item.id}\n            className={`bg-white rounded-2xl border p-4 shadow-2xs transition flex flex-col justify-between ${\n              item.isSoldOut ? \'border-red-200 bg-red-50/20\' : \'border-[#E8E2DD] hover:border-[#E65100]\'\n            }`}\n          >\n            <div className=\"space-y-3\">\n              {/* Dish Image */}\n              <div className=\"relative w-full h-36 rounded-xl overflow-hidden bg-slate-100 border border-[#E8E2DD]\">\n                {item.image ? (\n                  <img\n                    src={item.image}\n                    alt={item.name}\n                    className=\"w-full h-full object-cover\"\n                    referrerPolicy=\"no-referrer\"\n                  />\n                ) : (\n                  <div className=\"w-full h-full flex items-center justify-center text-slate-400 bg-slate-50\">\n                    <UtensilsCrossed className=\"w-8 h-8 opacity-40\" />\n                  </div>\n                )}\n\n                <span className=\"absolute top-2 left-2 bg-white/90 backdrop-blur-xs text-[#2D241E] border border-[#E8E2DD] text-[10px] font-bold px-2 py-0.5 rounded-full uppercase tracking-wider shadow-2xs\">\n                  {item.category}\n                </span>\n\n                {/* Real-time Sold Out Toggle Overlay Badge */}\n                <button\n                  type=\"button\"\n                  disabled={!isOwner}\n                  onClick={() => {\n                    if (!isOwner) {\n                      alert(\'Only the store owner can toggle stock / sold-out status.\');\n                      return;\n                    }\n                    onToggleSoldOut(item.id, !item.isSoldOut);\n                  }}\n                  className={`absolute top-2 right-2 px-2.5 py-1 rounded-full text-[10px] font-bold flex items-center space-x-1 transition shadow-xs ${\n                    item.isSoldOut\n                      ? \'bg-red-600 text-white\'\n                      : \'bg-emerald-600/90 text-white hover:bg-emerald-700\'\n                  } ${!isOwner ? \'opacity-80 cursor-not-allowed\' : \'cursor-pointer\'}`}\n                >\n                  {item.isSoldOut ? (\n                    <>\n                      <XCircle className=\"w-3 h-3\" />\n                      <span>SOLD OUT</span>\n                    </>\n                  ) : (\n                    <>\n                      <CheckCircle className=\"w-3 h-3 text-white\" />\n                      <span>In Stock</span>\n                    </>\n                  )}\n                </button>\n              </div>\n\n              <div>\n                <h3 className=\"font-extrabold text-[#2D241E] text-base\">{item.name}</h3>\n                {item.description && (\n                  <p className=\"text-xs text-[#756D67] mt-0.5 line-clamp-2\">{item.description}</p>\n                )}\n              </div>\n\n              <div className=\"flex items-center space-x-3 pt-1 text-xs font-bold text-[#2D241E]\">\n                <div>\n                  <span className=\"text-[10px] text-[#756D67] block font-medium\">Full Price:</span>\n                  <span className=\"text-base text-[#2D241E]\">\342\202\261{item.price.toFixed(2)}</span>\n                </div>\n\n                {item.allowHalfOrder && (\n                  <div className=\"border-l border-[#E8E2DD] pl-3\">\n                    <span className=\"text-[10px] text-[#756D67] block font-medium\">Half Portion:</span>\n                    <span className=\"text-base text-[#E65100]\">\342\202\261{(item.halfPrice || item.price / 2).toFixed(2)}</span>\n                  </div>\n                )}\n              </div>\n            </div>\n\n            {/* Actions */}\n            <div className=\"flex items-center justify-between pt-3 mt-3 border-t border-[#E8E2DD]\">\n              {isOwner ? (\n                <div className=\"flex items-center space-x-2 ml-auto\">\n                  <button\n                    onClick={() => handleOpenEdit(item)}\n                    className=\"px-3 py-1.5 bg-[#FCFAF7] hover:bg-[#FFF3E0] border border-[#E8E2DD] text-[#2D241E] hover:text-[#E65100] rounded-xl text-xs font-bold flex items-center space-x-1 transition cursor-pointer\"\n                  >\n                    <Edit2 className=\"w-3.5 h-3.5\" />\n                    <span>Edit</span>\n                  </button>\n\n                  <button\n                    onClick={() => {\n                      if (confirm(`Are you sure you want to delete ${item.name}?`)) {\n                        onDeleteMenuItem(item.id);\n                      }\n                    }}\n                    className=\"px-2.5 py-1.5 text-red-600 hover:bg-red-50 rounded-xl text-xs font-bold transition cursor-pointer\"\n                  >\n                    <Trash2 className=\"w-3.5 h-3.5\" />\n                  </button>\n                </div>\n              ) : (\n                <span className=\"text-[11px] text-[#756D67] font-semibold flex items-center gap-1\">\n                  <Lock className=\"w-3 h-3 text-[#E65100]\" />\n                  Owner edit restricted\n                </span>\n              )}\n            </div>\n          </div>\n        ))}\n      </div>"
        replacement_content: "  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8\">\n      \n      {/* Employee Restricted Notice Banner */}\n      {!isOwner && (\n        <div className=\"bg-amber-50 border border-amber-200/80 rounded-3xl p-5 flex items-start space-x-3 text-amber-900 shadow-airmee\">\n          <ShieldAlert className=\"w-5 h-5 text-amber-600 shrink-0 mt-0.5\" />\n          <div className=\"text-xs space-y-1\">\n            <h4 className=\"font-extrabold text-amber-900\">\n              Employee Read-Only View: Owner Permissions Required\n            </h4>\n            <p className=\"text-amber-800 font-medium\">\n              You are currently logged in as an Employee Cashier. Menu editing (adding dishes, modifying prices, or deleting items) is strictly restricted to the Store Owner.\n            </p>\n          </div>\n        </div>\n      )}\n\n      {/* Header Bar */}\n      <div className=\"bg-white rounded-3xl shadow-airmee border border-slate-200/80 p-6 flex flex-col md:flex-row items-center justify-between gap-6\">\n        <div>\n          <span className=\"bg-orange-50 text-orange-600 border border-orange-200/60 text-[11px] font-extrabold px-3.5 py-1 rounded-full uppercase tracking-wider inline-block mb-2\">\n            Inventory & Dishes\n          </span>\n          <h2 className=\"text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2\">\n            <UtensilsCrossed className=\"w-6 h-6 text-orange-600\" />\n            Daily Menu Digitization & Stock Control\n          </h2>\n          <p className=\"text-xs text-slate-500 font-medium mt-1\">\n            Manage carinderia rotating daily recipes, portion half-prices, and instant sold-out badges\n          </p>\n        </div>\n\n        {isOwner ? (\n          <button\n            onClick={handleOpenAdd}\n            className=\"w-full md:w-auto px-6 py-3 bg-orange-600 hover:bg-orange-700 text-white font-extrabold rounded-full text-xs flex items-center justify-center space-x-2 shadow-airmee-orange transition-all cursor-pointer\"\n          >\n            <Plus className=\"w-4 h-4\" />\n            <span>Add New Dish Item</span>\n          </button>\n        ) : (\n          <div className=\"px-4 py-2.5 bg-slate-50 border border-slate-200/80 text-slate-500 font-bold rounded-full text-xs flex items-center gap-2\">\n            <Lock className=\"w-3.5 h-3.5 text-amber-600\" />\n            <span>Owner Only Action</span>\n          </div>\n        )}\n      </div>\n\n      {/* Filter and Search Bar */}\n      <div className=\"bg-white rounded-3xl shadow-airmee border border-slate-200/80 p-4 space-y-3\">\n        <div className=\"flex flex-col sm:flex-row items-center justify-between gap-4\">\n          <div className=\"relative w-full sm:w-80\">\n            <Search className=\"w-4 h-4 absolute left-3.5 top-3 text-slate-400\" />\n            <input\n              type=\"text\"\n              placeholder=\"Search dishes to inspect stock or prices...\"\n              value={searchQuery}\n              onChange={(e) => setSearchQuery(e.target.value)}\n              className=\"w-full pl-10 pr-4 py-2 text-xs bg-slate-50/70 border border-slate-200/80 rounded-2xl focus:outline-none focus:ring-2 focus:ring-orange-500 text-slate-900 font-medium\"\n            />\n          </div>\n\n          <div className=\"flex space-x-2 overflow-x-auto w-full sm:w-auto pb-1 scrollbar-none\">\n            <button\n              onClick={() => setSelectedCategory(\'ALL\')}\n              className={`px-4 py-2 rounded-full text-xs font-bold transition-all cursor-pointer whitespace-nowrap border ${\n                selectedCategory === \'ALL\'\n                  ? \'bg-orange-600 text-white border-orange-600 shadow-airmee-orange\'\n                  : \'bg-slate-50 text-slate-600 border-slate-200/80 hover:bg-slate-100\'\n              }`}\n            >\n              All ({menuItems.length})\n            </button>\n            {CATEGORIES.map((cat) => (\n              <button\n                key={cat}\n                onClick={() => setSelectedCategory(cat)}\n                className={`px-4 py-2 rounded-full text-xs font-bold transition-all cursor-pointer whitespace-nowrap border ${\n                  selectedCategory === cat\n                    ? \'bg-orange-600 text-white border-orange-600 shadow-airmee-orange\'\n                    : \'bg-slate-50 text-slate-600 border-slate-200/80 hover:bg-slate-100\'\n                }`}\n              >\n                {cat}\n              </button>\n            ))}\n          </div>\n        </div>\n      </div>\n\n      {/* Menu Grid */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n        {filteredItems.map((item) => (\n          <div\n            key={item.id}\n            className={`bg-white rounded-3xl border p-5 shadow-airmee transition-all flex flex-col justify-between ${\n              item.isSoldOut ? \'border-red-200/80 bg-red-50/10\' : \'border-slate-200/80 hover:border-orange-500/80\'\n            }`}\n          >\n            <div className=\"space-y-4\">\n              {/* Dish Image */}\n              <div className=\"relative w-full h-40 rounded-2xl overflow-hidden bg-slate-100 border border-slate-200/60\">\n                {item.image ? (\n                  <img\n                    src={item.image}\n                    alt={item.name}\n                    className=\"w-full h-full object-cover\"\n                    referrerPolicy=\"no-referrer\"\n                  />\n                ) : (\n                  <div className=\"w-full h-full flex items-center justify-center text-slate-400 bg-slate-50\">\n                    <UtensilsCrossed className=\"w-8 h-8 opacity-40\" />\n                  </div>\n                )}\n\n                <span className=\"absolute top-3 left-3 bg-white/90 backdrop-blur-md text-slate-900 border border-slate-200/60 text-[10px] font-extrabold px-3 py-1 rounded-full uppercase tracking-wider shadow-xs\">\n                  {item.category}\n                </span>\n\n                {/* Real-time Sold Out Toggle Overlay Badge */}\n                <button\n                  type=\"button\"\n                  disabled={!isOwner}\n                  onClick={() => {\n                    if (!isOwner) {\n                      alert(\'Only the store owner can toggle stock / sold-out status.\');\n                      return;\n                    }\n                    onToggleSoldOut(item.id, !item.isSoldOut);\n                  }}\n                  className={`absolute top-3 right-3 px-3 py-1 rounded-full text-[10px] font-extrabold flex items-center space-x-1 transition-all shadow-xs ${\n                    item.isSoldOut\n                      ? \'bg-red-600 text-white\'\n                      : \'bg-emerald-600 text-white hover:bg-emerald-700\'\n                  } ${!isOwner ? \'opacity-80 cursor-not-allowed\' : \'cursor-pointer\'}`}\n                >\n                  {item.isSoldOut ? (\n                    <>\n                      <XCircle className=\"w-3 h-3\" />\n                      <span>SOLD OUT</span>\n                    </>\n                  ) : (\n                    <>\n                      <CheckCircle className=\"w-3 h-3 text-white\" />\n                      <span>In Stock</span>\n                    </>\n                  )}\n                </button>\n              </div>\n\n              <div>\n                <h3 className=\"font-black text-slate-900 text-lg tracking-tight\">{item.name}</h3>\n                {item.description && (\n                  <p className=\"text-xs text-slate-500 font-medium mt-1 line-clamp-2\">{item.description}</p>\n                )}\n              </div>\n\n              <div className=\"flex items-center space-x-4 pt-1 text-xs font-bold text-slate-900\">\n                <div>\n                  <span className=\"text-[10px] text-slate-400 block font-semibold uppercase tracking-wider\">Full Price</span>\n                  <span className=\"text-lg font-black text-slate-900\">\342\202\261{item.price.toFixed(2)}</span>\n                </div>\n\n                {item.allowHalfOrder && (\n                  <div className=\"border-l border-slate-200/80 pl-4\">\n                    <span className=\"text-[10px] text-slate-400 block font-semibold uppercase tracking-wider\">Half Portion</span>\n                    <span className=\"text-lg font-black text-orange-600\">\342\202\261{(item.halfPrice || item.price / 2).toFixed(2)}</span>\n                  </div>\n                )}\n              </div>\n            </div>\n\n            {/* Actions */}\n            <div className=\"flex items-center justify-between pt-4 mt-4 border-t border-slate-100\">\n              {isOwner ? (\n                <div className=\"flex items-center space-x-2 ml-auto\">\n                  <button\n                    onClick={() => handleOpenEdit(item)}\n                    className=\"px-4 py-2 bg-slate-50 hover:bg-orange-50 text-slate-800 hover:text-orange-600 border border-slate-200/80 rounded-full text-xs font-extrabold flex items-center space-x-1.5 transition cursor-pointer\"\n                  >\n                    <Edit2 className=\"w-3.5 h-3.5\" />\n                    <span>Edit</span>\n                  </button>\n\n                  <button\n                    onClick={() => {\n                      if (confirm(`Are you sure you want to delete ${item.name}?`)) {\n                        onDeleteMenuItem(item.id);\n                      }\n                    }}\n                    className=\"px-3 py-2 text-red-600 hover:bg-red-50 rounded-full text-xs font-extrabold transition cursor-pointer\"\n                  >\n                    <Trash2 className=\"w-3.5 h-3.5\" />\n                  </button>\n                </div>\n              ) : (\n                <span className=\"text-[11px] text-slate-400 font-bold flex items-center gap-1\">\n                  <Lock className=\"w-3 h-3 text-orange-600\" />\n                  Owner edit restricted\n                </span>\n              )}\n            </div>\n          </div>\n        ))}\n      </div>"
      }
