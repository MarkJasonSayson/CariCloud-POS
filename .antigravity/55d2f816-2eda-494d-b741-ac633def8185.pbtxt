    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useMemo } from \'react\';\nimport { \n  Calculator, \n  CheckCircle2, \n  AlertTriangle, \n  DollarSign, \n  Trash2, \n  TrendingUp, \n  Calendar, \n  FileSpreadsheet,\n  Plus\n} from \'lucide-react\';\nimport { EODRecord, MenuItem, Transaction, UnsoldItemLoss } from \'../types\';\n\ninterface EODModuleProps {\n  transactions: Transaction[];\n  menuItems: MenuItem[];\n  eodLogs: EODRecord[];\n  closedBy: string;\n  onSaveEODRecord: (record: EODRecord) => void;\n}\n\nexport const EODModule: React.FC<EODModuleProps> = ({\n  transactions,\n  menuItems,\n  eodLogs,\n  closedBy,\n  onSaveEODRecord,\n}) => {\n  const todayStr = new Date().toISOString().split(\'T\')[0];\n\n  // Today\'s completed transactions\n  const todayTransactions = useMemo(() => {\n    return transactions.filter((tx) => tx.timestamp.startsWith(todayStr));\n  }, [transactions, todayStr]);\n\n  const expectedGrossSales = useMemo(() => {\n    return todayTransactions.reduce((sum, tx) => sum + tx.totalAmount, 0);\n  }, [todayTransactions]);\n\n  const cashSales = useMemo(() => {\n    return todayTransactions\n      .filter((tx) => tx.paymentMethod === \'CASH\')\n      .reduce((sum, tx) => sum + tx.totalAmount, 0);\n  }, [todayTransactions]);\n\n  const eWalletSales = useMemo(() => {\n    return todayTransactions\n      .filter((tx) => tx.paymentMethod === \'E_WALLET\')\n      .reduce((sum, tx) => sum + tx.totalAmount, 0);\n  }, [todayTransactions]);\n\n  const creditSales = useMemo(() => {\n    return todayTransactions\n      .filter((tx) => tx.paymentMethod === \'LISTAHAN_CREDIT\')\n      .reduce((sum, tx) => sum + tx.totalAmount, 0);\n  }, [todayTransactions]);\n\n  // Form States for Close of Day\n  const [actualCashInBox, setActualCashInBox] = useState<number>(Math.round(cashSales));\n  const [unsoldItemsList, setUnsoldItemsList] = useState<UnsoldItemLoss[]>([]);\n  const [selectedDishId, setSelectedDishId] = useState<string>(\'\');\n  const [unsoldQty, setUnsoldQty] = useState<number>(1);\n  const [auditNotes, setAuditNotes] = useState<string>(\'\');\n\n  const totalWastageValue = useMemo(() => {\n    return unsoldItemsList.reduce((sum, item) => sum + item.totalLoss, 0);\n  }, [unsoldItemsList]);\n\n  const cashVariance = actualCashInBox - cashSales;\n  const netSales = expectedGrossSales / 1.12; // Net sales before tax\n  const netProfit = Math.max(0, netSales - totalWastageValue);\n\n  const handleAddUnsoldItem = () => {\n    if (!selectedDishId) return;\n    const dish = menuItems.find((m) => m.id === selectedDishId);\n    if (!dish) return;\n\n    const lossItem: UnsoldItemLoss = {\n      menuItemId: dish.id,\n      dishName: dish.name,\n      quantityUnsold: unsoldQty,\n      unitPrice: dish.price,\n      totalLoss: dish.price * unsoldQty,\n    };\n\n    setUnsoldItemsList((prev) => [...prev, lossItem]);\n    setSelectedDishId(\'\');\n    setUnsoldQty(1);\n  };\n\n  const handleRemoveUnsoldItem = (idx: number) => {\n    setUnsoldItemsList((prev) => prev.filter((_, i) => i !== idx));\n  };\n\n  const handleFinalizeEOD = () => {\n    const record: EODRecord = {\n      id: \'eod-\' + todayStr,\n      date: todayStr,\n      closedAt: new Date().toISOString(),\n      closedBy,\n      expectedGrossSales,\n      actualCashInBox,\n      cashVariance,\n      eWalletSales,\n      creditSales,\n      unsoldLosses: unsoldItemsList,\n      totalWastageValue,\n      netSales,\n      netProfit,\n      totalTransactionsCount: todayTransactions.length,\n      notes: auditNotes || \'Daily cash audit completed.\',\n    };\n\n    onSaveEODRecord(record);\n    alert(`End-of-Day Audit for ${todayStr} finalized successfully!`);\n  };\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6\">\n      \n      {/* Title */}\n      <div className=\"bg-white rounded-xl shadow-sm border border-slate-200 p-4 flex flex-col md:flex-row items-center justify-between gap-3\">\n        <div>\n          <h2 className=\"text-xl font-bold text-slate-900 flex items-center gap-2\">\n            <Calculator className=\"w-5 h-5 text-orange-600\" />\n            End-of-Day (EOD) Financial Reconciliation & Food Loss Audit\n          </h2>\n          <p className=\"text-xs text-slate-500 mt-0.5\">\n            Audit daily cash count, calibrate leftover food loss, and derive net profit margins\n          </p>\n        </div>\n\n        <div className=\"text-right\">\n          <span className=\"text-xs font-bold text-slate-500 block\">Auditing Date:</span>\n          <span className=\"text-sm font-black text-orange-600\">{todayStr}</span>\n        </div>\n      </div>\n\n      {/* Main Reconciliation Workspace */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n        \n        {/* LEFT COLUMN: Input Daily Cash & Food Wastage (7 Cols) */}\n        <div className=\"lg:col-span-7 space-y-5\">\n          \n          {/* STEP 1: Cash Box Count Input */}\n          <div className=\"bg-white rounded-xl shadow-sm border border-slate-200 p-5 space-y-4\">\n            <h3 className=\"font-bold text-slate-900 text-sm flex items-center gap-2 border-b border-slate-100 pb-2\">\n              <span className=\"w-5 h-5 rounded-full bg-orange-600 text-white flex items-center justify-center text-xs\">1</span>\n              Actual Cash Box Drawer Count\n            </h3>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n              <div className=\"bg-slate-50 p-3 rounded-xl border border-slate-200\">\n                <span className=\"text-xs text-slate-500 font-bold block mb-1\">Expected Cash Sales:</span>\n                <span className=\"text-xl font-black text-slate-800\">\342\202\261{cashSales.toFixed(2)}</span>\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-bold text-slate-700 mb-1\">\n                  Actual Physical Cash Counted (\342\202\261):\n                </label>\n                <input\n                  type=\"number\"\n                  step=\"1\"\n                  value={actualCashInBox}\n                  onChange={(e) => setActualCashInBox(parseFloat(e.target.value) || 0)}\n                  className=\"w-full text-xl font-black text-emerald-800 px-3 py-2 bg-white border border-slate-300 rounded-xl focus:ring-2 focus:ring-orange-500 focus:outline-none\"\n                />\n              </div>\n            </div>\n\n            {/* Variance indicator */}\n            <div\n              className={`p-3 rounded-xl border flex items-center justify-between text-xs ${\n                cashVariance === 0\n                  ? \'bg-emerald-50 border-emerald-200 text-emerald-900\'\n                  : cashVariance < 0\n                  ? \'bg-red-50 border-red-200 text-red-900\'\n                  : \'bg-blue-50 border-blue-200 text-blue-900\'\n              }`}\n            >\n              <div>\n                <span className=\"font-bold block\">\n                  Cash Variance (Shortage / Overage):\n                </span>\n                <span className=\"text-base font-black\">\n                  {cashVariance >= 0 ? `+\342\202\261${cashVariance.toFixed(2)}` : `-\342\202\261${Math.abs(cashVariance).toFixed(2)}`}\n                </span>\n              </div>\n\n              {cashVariance === 0 ? (\n                <span className=\"bg-emerald-600 text-white font-bold text-[10px] px-2 py-1 rounded\">\n                  BALANCED \360\237\237\242\n                </span>\n              ) : (\n                <AlertTriangle className=\"w-5 h-5 text-amber-600\" />\n              )}\n            </div>\n          </div>\n\n          {/* STEP 2: Unsold Dishes Wastage Logger */}\n          <div className=\"bg-white rounded-xl shadow-sm border border-slate-200 p-5 space-y-4\">\n            <h3 className=\"font-bold text-slate-900 text-sm flex items-center gap-2 border-b border-slate-100 pb-2\">\n              <span className=\"w-5 h-5 rounded-full bg-orange-600 text-white flex items-center justify-center text-xs\">2</span>\n              Log Unsold Leftover Food Wastage\n            </h3>\n\n            {/* Dish selector & Qty */}\n            <div className=\"flex flex-col sm:flex-row items-end gap-2\">\n              <div className=\"flex-1 w-full\">\n                <label className=\"block text-xs font-bold text-slate-700 mb-1\">\n                  Unsold Dish:\n                </label>\n                <select\n                  value={selectedDishId}\n                  onChange={(e) => setSelectedDishId(e.target.value)}\n                  className=\"w-full px-3 py-2 text-xs bg-white border border-slate-300 rounded-lg focus:ring-2 focus:ring-orange-500\"\n                >\n                  <option value=\"\">-- Choose Unsold Dish --</option>\n                  {menuItems.map((m) => (\n                    <option key={m.id} value={m.id}>\n                      {m.name} (\342\202\261{m.price})\n                    </option>\n                  ))}\n                </select>\n              </div>\n\n              <div className=\"w-full sm:w-28\">\n                <label className=\"block text-xs font-bold text-slate-700 mb-1\">\n                  Qty Unsold:\n                </label>\n                <input\n                  type=\"number\"\n                  min=\"1\"\n                  value={unsoldQty}\n                  onChange={(e) => setUnsoldQty(parseInt(e.target.value) || 1)}\n                  className=\"w-full px-3 py-2 text-xs border border-slate-300 rounded-lg focus:ring-2 focus:ring-orange-500 font-bold\"\n                />\n              </div>\n\n              <button\n                type=\"button\"\n                onClick={handleAddUnsoldItem}\n                className=\"w-full sm:w-auto px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white font-bold rounded-lg text-xs flex items-center justify-center space-x-1 shadow-sm transition\"\n              >\n                <Plus className=\"w-4 h-4\" />\n                <span>Add Wastage</span>\n              </button>\n            </div>\n\n            {/* Wastage Table */}\n            {unsoldItemsList.length > 0 && (\n              <div className=\"border border-slate-200 rounded-xl overflow-hidden divide-y divide-slate-100 text-xs\">\n                {unsoldItemsList.map((item, idx) => (\n                  <div key={idx} className=\"p-2.5 flex items-center justify-between bg-slate-50/50\">\n                    <div>\n                      <span className=\"font-bold text-slate-800\">{item.dishName}</span>\n                      <span className=\"text-slate-500 text-[11px] ml-2\">\n                        {item.quantityUnsold} pcs @ \342\202\261{item.unitPrice}\n                      </span>\n                    </div>\n                    <div className=\"flex items-center space-x-3\">\n                      <span className=\"font-bold text-red-600\">-\342\202\261{item.totalLoss.toFixed(2)}</span>\n                      <button\n                        onClick={() => handleRemoveUnsoldItem(idx)}\n                        className=\"text-slate-400 hover:text-red-600\"\n                      >\n                        <Trash2 className=\"w-3.5 h-3.5\" />\n                      </button>\n                    </div>\n                  </div>\n                ))}\n\n                <div className=\"p-3 bg-red-50 text-red-900 font-bold flex justify-between\">\n                  <span>Total Calibrated Food Wastage Value:</span>\n                  <span>-\342\202\261{totalWastageValue.toFixed(2)}</span>\n                </div>\n              </div>\n            )}\n          </div>\n\n          {/* Audit Notes */}\n          <div className=\"bg-white rounded-xl shadow-sm border border-slate-200 p-4\">\n            <label className=\"block text-xs font-bold text-slate-700 mb-1\">\n              End-of-Day Audit Remarks / Notes:\n            </label>\n            <textarea\n              rows={2}\n              placeholder=\"e.g. Lunch rush peak performance. Minor leftover Pinakbet recorded.\"\n              value={auditNotes}\n              onChange={(e) => setAuditNotes(e.target.value)}\n              className=\"w-full px-3 py-2 text-xs border border-slate-300 rounded-lg focus:ring-2 focus:ring-orange-500\"\n            />\n          </div>\n\n        </div>\n\n        {/* RIGHT COLUMN: Computed Financial Dashboard (5 Cols) */}\n        <div className=\"lg:col-span-5 space-y-4\">\n          <div className=\"bg-slate-900 text-white rounded-2xl shadow-md p-5 space-y-4 border border-slate-800 sticky top-20\">\n            <h3 className=\"font-bold text-base text-orange-400 border-b border-slate-800 pb-2\">\n              Financial Summary & Net Profit\n            </h3>\n\n            <div className=\"space-y-2.5 text-xs text-slate-300\">\n              <div className=\"flex justify-between\">\n                <span>Completed Orders Count:</span>\n                <span className=\"font-bold text-white\">{todayTransactions.length} txns</span>\n              </div>\n\n              <div className=\"flex justify-between\">\n                <span>Gross Revenue:</span>\n                <span className=\"font-bold text-white\">\342\202\261{expectedGrossSales.toFixed(2)}</span>\n              </div>\n\n              <div className=\"pl-3 border-l-2 border-slate-800 space-y-1 text-[11px] text-slate-400\">\n                <div className=\"flex justify-between\">\n                  <span>\342\200\242 Cash Sales:</span>\n                  <span>\342\202\261{cashSales.toFixed(2)}</span>\n                </div>\n                <div className=\"flex justify-between\">\n                  <span>\342\200\242 E-Wallet (PayMongo):</span>\n                  <span>\342\202\261{eWalletSales.toFixed(2)}</span>\n                </div>\n                <div className=\"flex justify-between\">\n                  <span>\342\200\242 Listahan Credit:</span>\n                  <span>\342\202\261{creditSales.toFixed(2)}</span>\n                </div>\n              </div>\n\n              <div className=\"flex justify-between text-amber-300 pt-2 border-t border-slate-800\">\n                <span>Unsold Food Wastage Loss:</span>\n                <span>-\342\202\261{totalWastageValue.toFixed(2)}</span>\n              </div>\n\n              <div className=\"pt-3 border-t border-slate-800 flex justify-between items-baseline\">\n                <div>\n                  <span className=\"text-xs font-bold text-slate-400 uppercase tracking-wider block\">\n                    NET MARGIN / PROFIT\n                  </span>\n                  <span className=\"text-[10px] text-slate-500\">Less Tax & Food Wastage</span>\n                </div>\n                <span className=\"text-2xl font-black text-emerald-400\">\n                  \342\202\261{netProfit.toFixed(2)}\n                </span>\n              </div>\n            </div>\n\n            <button\n              onClick={handleFinalizeEOD}\n              className=\"w-full py-3 bg-orange-500 hover:bg-orange-600 text-slate-950 font-black rounded-xl text-sm shadow-md transition flex items-center justify-center space-x-2 cursor-pointer\"\n            >\n              <CheckCircle2 className=\"w-5 h-5\" />\n              <span>FINALIZE EOD AUDIT REPORT</span>\n            </button>\n          </div>\n\n          {/* Historical EOD Logs */}\n          <div className=\"bg-white rounded-xl shadow-sm border border-slate-200 p-4 space-y-3\">\n            <h4 className=\"font-bold text-xs text-slate-800 uppercase tracking-wider\">\n              Recent EOD Audits\n            </h4>\n\n            <div className=\"space-y-2 max-h-48 overflow-y-auto\">\n              {eodLogs.map((log) => (\n                <div key={log.id} className=\"p-2.5 bg-slate-50 border border-slate-200 rounded-lg text-xs flex items-center justify-between\">\n                  <div>\n                    <span className=\"font-bold text-slate-800 block\">{log.date}</span>\n                    <span className=\"text-[10px] text-slate-500\">By {log.closedBy}</span>\n                  </div>\n                  <div className=\"text-right\">\n                    <span className=\"font-bold text-emerald-700 block\">\342\202\261{log.netProfit.toFixed(2)}</span>\n                    <span className=\"text-[10px] text-slate-500\">{log.totalTransactionsCount} txns</span>\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n\n        </div>\n\n      </div>\n\n    </div>\n  );\n};\n"
    }
    diff {
      unified_diff {
