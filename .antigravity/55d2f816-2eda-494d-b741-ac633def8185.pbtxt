          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              <button"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                type=\"button\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                onClick={() => setIsPaymentModalOpen(false)}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                className=\"px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded-lg\""
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "              >"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
