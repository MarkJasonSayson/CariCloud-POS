      original_chunk {
        target_content: "  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6\">\n      \n      {/* Header Bar */}\n      <div className=\"bg-white rounded-xl shadow-sm border border-slate-200 p-4 flex flex-col md:flex-row items-center justify-between gap-4\">\n        <div>\n          <h2 className=\"text-xl font-bold text-slate-900 flex items-center gap-2\">\n            <UtensilsCrossed className=\"w-5 h-5 text-orange-600\" />\n            Daily Menu Digitization & Stock Control\n          </h2>\n          <p className=\"text-xs text-slate-500 mt-0.5\">\n            Manage carinderia rotating daily recipes, portion half-prices, and instant sold-out badges\n          </p>\n        </div>\n\n        <button\n          onClick={handleOpenAdd}\n          className=\"w-full md:w-auto px-4 py-2.5 bg-orange-600 hover:bg-orange-700 text-white font-bold rounded-xl text-xs flex items-center justify-center space-x-1.5 shadow-sm transition\"\n        >\n          <Plus className=\"w-4 h-4\" />\n          <span>Add New Dish Item</span>\n        </button>\n      </div>\n\n      {/* Filter and Search Bar */}\n      <div className=\"bg-white rounded-xl shadow-sm border border-slate-200 p-3.5 space-y-3\">\n        <div className=\"flex flex-col sm:flex-row items-center justify-between gap-3\">\n          <div className=\"relative w-full sm:w-80\">\n            <Search className=\"w-4 h-4 absolute left-3 top-2.5 text-slate-400\" />\n            <input\n              type=\"text\"\n              placeholder=\"Search dishes to edit stock or prices...\"\n              value={searchQuery}\n              onChange={(e) => setSearchQuery(e.target.value)}\n              className=\"w-full pl-9 pr-3 py-1.5 text-sm bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500 text-slate-800\"\n            />\n          </div>\n\n          <div className=\"flex space-x-1 overflow-x-auto w-full sm:w-auto pb-1 scrollbar-none\">\n            <button\n              onClick={() => setSelectedCategory(\'ALL\')}\n              className={`px-3 py-1.5 rounded-lg text-xs font-bold transition whitespace-nowrap ${\n                selectedCategory === \'ALL\'\n                  ? \'bg-slate-900 text-white shadow-xs\'\n                  : \'bg-slate-100 text-slate-700 hover:bg-slate-200\'\n              }`}\n            >\n              All ({menuItems.length})\n            </button>\n            {CATEGORIES.map((cat) => (\n              <button\n                key={cat}\n                onClick={() => setSelectedCategory(cat)}\n                className={`px-3 py-1.5 rounded-lg text-xs font-bold transition whitespace-nowrap ${\n                  selectedCategory === cat\n                    ? \'bg-orange-600 text-white shadow-xs\'\n                    : \'bg-slate-100 text-slate-700 hover:bg-slate-200\'\n                }`}\n              >\n                {cat}\n              </button>\n            ))}\n          </div>\n        </div>\n      </div>\n\n      {/* Menu Grid */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n        {filteredItems.map((item) => (\n          <div\n            key={item.id}\n            className={`bg-white rounded-xl border p-4 shadow-sm transition flex flex-col justify-between ${\n              item.isSoldOut ? \'border-red-200 bg-red-50/20\' : \'border-slate-200 hover:border-orange-300\'\n            }`}\n          >\n            <div className=\"space-y-2\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"bg-slate-100 text-slate-700 text-[10px] font-bold px-2 py-0.5 rounded uppercase tracking-wider\">\n                  {item.category}\n                </span>\n\n                {/* Real-time Sold Out Toggle */}\n                <button\n                  type=\"button\"\n                  onClick={() => onToggleSoldOut(item.id, !item.isSoldOut)}\n                  className={`px-2.5 py-1 rounded-full text-[11px] font-bold flex items-center space-x-1 transition cursor-pointer ${\n                    item.isSoldOut\n                      ? \'bg-red-600 text-white shadow-xs\'\n                      : \'bg-emerald-100 text-emerald-800 hover:bg-emerald-200\'\n                  }`}\n                >\n                  {item.isSoldOut ? (\n                    <>\n                      <XCircle className=\"w-3.5 h-3.5\" />\n                      <span>SOLD OUT</span>\n                    </>\n                  ) : (\n                    <>\n                      <CheckCircle className=\"w-3.5 h-3.5 text-emerald-600\" />\n                      <span>In Stock</span>\n                    </>\n                  )}\n                </button>\n              </div>\n\n              <div>\n                <h3 className=\"font-bold text-slate-900 text-base\">{item.name}</h3>\n                {item.description && (\n                  <p className=\"text-xs text-slate-500 mt-0.5 line-clamp-2\">{item.description}</p>\n                )}\n              </div>\n\n              <div className=\"flex items-center space-x-3 pt-2 text-xs font-bold text-slate-800\">\n                <div>\n                  <span className=\"text-[10px] text-slate-400 block font-medium\">Full Price:</span>\n                  <span className=\"text-base text-slate-900\">\342\202\261{item.price}</span>\n                </div>\n\n                {item.allowHalfOrder && (\n                  <div className=\"border-l border-slate-200 pl-3\">\n                    <span className=\"text-[10px] text-slate-400 block font-medium\">Half Portion:</span>\n                    <span className=\"text-base text-orange-600\">\342\202\261{item.halfPrice}</span>\n                  </div>\n                )}\n              </div>\n            </div>\n\n            {/* Actions */}\n            <div className=\"flex items-center justify-end space-x-2 pt-3 mt-3 border-t border-slate-100\">\n              <button\n                onClick={() => handleOpenEdit(item)}\n                className=\"px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-xs font-bold flex items-center space-x-1 transition\"\n              >\n                <Edit2 className=\"w-3.5 h-3.5\" />\n                <span>Edit</span>\n              </button>\n\n              <button\n                onClick={() => {\n                  if (confirm(`Are you sure you want to delete ${item.name}?`)) {\n                    onDeleteMenuItem(item.id);\n                  }\n                }}\n                className=\"px-2.5 py-1.5 text-red-600 hover:bg-red-50 rounded-lg text-xs font-bold transition\"\n              >\n                <Trash2 className=\"w-3.5 h-3.5\" />\n              </button>"
        replacement_content: "  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6\">\n      \n      {/* Employee Warning Notice if not Owner */}\n      {!isOwner && (\n        <div className=\"bg-amber-50 border border-amber-300 rounded-2xl p-4 flex items-center justify-between text-xs text-amber-900 shadow-2xs\">\n          <div className=\"flex items-center space-x-2 font-bold\">\n            <Lock className=\"w-4 h-4 text-amber-700 shrink-0\" />\n            <span>Employee Mode (View Only): Menu editing, prices, and stock additions are reserved for the Store Owner.</span>\n          </div>\n          <span className=\"text-[10px] font-mono bg-amber-100 text-amber-800 px-2 py-0.5 rounded border border-amber-300\">\n            Read-Only\n          </span>\n        </div>\n      )}\n\n      {/* Header Bar */}\n      <div className=\"bg-white rounded-2xl shadow-2xs border border-[#E8E2DD] p-4 flex flex-col md:flex-row items-center justify-between gap-4\">\n        <div>\n          <h2 className=\"text-xl font-extrabold text-[#2D241E] flex items-center gap-2\">\n            <UtensilsCrossed className=\"w-5 h-5 text-[#E65100]\" />\n            Daily Menu Digitization & Stock Control\n          </h2>\n          <p className=\"text-xs text-[#756D67] mt-0.5\">\n            Manage carinderia rotating daily recipes, portion half-prices, and instant sold-out badges\n          </p>\n        </div>\n\n        {isOwner ? (\n          <button\n            onClick={handleOpenAdd}\n            className=\"w-full md:w-auto px-4 py-2.5 bg-[#E65100] hover:bg-[#BF360C] text-white font-extrabold rounded-xl text-xs flex items-center justify-center space-x-1.5 shadow-2xs transition cursor-pointer\"\n          >\n            <Plus className=\"w-4 h-4\" />\n            <span>Add New Dish Item</span>\n          </button>\n        ) : (\n          <div className=\"text-xs font-bold text-[#756D67] bg-[#FCFAF7] border border-[#E8E2DD] px-3 py-2 rounded-xl flex items-center gap-1.5\">\n            <Lock className=\"w-3.5 h-3.5 text-[#E65100]\" />\n            <span>Only Owner Can Add Dishes</span>\n          </div>\n        )}\n      </div>\n\n      {/* Filter and Search Bar */}\n      <div className=\"bg-white rounded-2xl shadow-2xs border border-[#E8E2DD] p-3.5 space-y-3\">\n        <div className=\"flex flex-col sm:flex-row items-center justify-between gap-3\">\n          <div className=\"relative w-full sm:w-80\">\n            <Search className=\"w-4 h-4 absolute left-3 top-2.5 text-[#756D67]\" />\n            <input\n              type=\"text\"\n              placeholder=\"Search dishes...\"\n              value={searchQuery}\n              onChange={(e) => setSearchQuery(e.target.value)}\n              className=\"w-full pl-9 pr-3 py-1.5 text-sm bg-[#FCFAF7] border border-[#E8E2DD] rounded-xl focus:outline-none focus:ring-2 focus:ring-[#E65100] text-[#2D241E]\"\n            />\n          </div>\n\n          <div className=\"flex space-x-1.5 overflow-x-auto w-full sm:w-auto pb-1 scrollbar-none\">\n            <button\n              onClick={() => setSelectedCategory(\'ALL\')}\n              className={`px-3.5 py-1.5 rounded-xl text-xs font-bold transition whitespace-nowrap border ${\n                selectedCategory === \'ALL\'\n                  ? \'bg-[#E65100] text-white border-[#E65100] shadow-2xs\'\n                  : \'bg-white text-[#756D67] border-[#E8E2DD] hover:text-[#2D241E]\'\n              }`}\n            >\n              All ({menuItems.length})\n            </button>\n            {CATEGORIES.map((cat) => (\n              <button\n                key={cat}\n                onClick={() => setSelectedCategory(cat)}\n                className={`px-3.5 py-1.5 rounded-xl text-xs font-bold transition whitespace-nowrap border ${\n                  selectedCategory === cat\n                    ? \'bg-[#E65100] text-white border-[#E65100] shadow-2xs\'\n                    : \'bg-white text-[#756D67] border-[#E8E2DD] hover:text-[#2D241E]\'\n                }`}\n              >\n                {cat}\n              </button>\n            ))}\n          </div>\n        </div>\n      </div>\n\n      {/* Menu Grid */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n        {filteredItems.map((item) => (\n          <div\n            key={item.id}\n            className={`bg-white rounded-2xl border p-4 shadow-2xs transition flex flex-col justify-between ${\n              item.isSoldOut ? \'border-red-200 bg-red-50/20\' : \'border-[#E8E2DD] hover:border-[#E65100]\'\n            }`}\n          >\n            <div className=\"space-y-2\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"bg-[#FCFAF7] border border-[#E8E2DD] text-[#756D67] text-[10px] font-bold px-2 py-0.5 rounded-md uppercase tracking-wider\">\n                  {item.category}\n                </span>\n\n                {/* Real-time Sold Out Toggle */}\n                <button\n                  type=\"button\"\n                  disabled={!isOwner}\n                  onClick={() => {\n                    if (!isOwner) {\n                      alert(\'Only the store owner can toggle stock / sold-out status.\');\n                      return;\n                    }\n                    onToggleSoldOut(item.id, !item.isSoldOut);\n                  }}\n                  className={`px-2.5 py-1 rounded-full text-[11px] font-bold flex items-center space-x-1 transition cursor-pointer ${\n                    item.isSoldOut\n                      ? \'bg-red-600 text-white shadow-2xs\'\n                      : \'bg-emerald-100 text-emerald-800 hover:bg-emerald-200\'\n                  } ${!isOwner ? \'opacity-80 cursor-not-allowed\' : \'\'}`}\n                >\n                  {item.isSoldOut ? (\n                    <>\n                      <XCircle className=\"w-3.5 h-3.5\" />\n                      <span>SOLD OUT</span>\n                    </>\n                  ) : (\n                    <>\n                      <CheckCircle className=\"w-3.5 h-3.5 text-emerald-600\" />\n                      <span>In Stock</span>\n                    </>\n                  )}\n                </button>\n              </div>\n\n              <div>\n                <h3 className=\"font-extrabold text-[#2D241E] text-base\">{item.name}</h3>\n                {item.description && (\n                  <p className=\"text-xs text-[#756D67] mt-0.5 line-clamp-2\">{item.description}</p>\n                )}\n              </div>\n\n              <div className=\"flex items-center space-x-3 pt-2 text-xs font-bold text-[#2D241E]\">\n                <div>\n                  <span className=\"text-[10px] text-[#756D67] block font-medium\">Full Price:</span>\n                  <span className=\"text-base text-[#2D241E]\">\342\202\261{item.price}</span>\n                </div>\n\n                {item.allowHalfOrder && (\n                  <div className=\"border-l border-[#E8E2DD] pl-3\">\n                    <span className=\"text-[10px] text-[#756D67] block font-medium\">Half Portion:</span>\n                    <span className=\"text-base text-[#E65100]\">\342\202\261{item.halfPrice}</span>\n                  </div>\n                )}\n              </div>\n            </div>\n\n            {/* Actions */}\n            <div className=\"flex items-center justify-between pt-3 mt-3 border-t border-[#E8E2DD]\">\n              {isOwner ? (\n                <div className=\"flex items-center space-x-2 ml-auto\">\n                  <button\n                    onClick={() => handleOpenEdit(item)}\n                    className=\"px-3 py-1.5 bg-[#FCFAF7] hover:bg-[#FFF3E0] border border-[#E8E2DD] text-[#2D241E] hover:text-[#E65100] rounded-xl text-xs font-bold flex items-center space-x-1 transition cursor-pointer\"\n                  >\n                    <Edit2 className=\"w-3.5 h-3.5\" />\n                    <span>Edit</span>\n                  </button>\n\n                  <button\n                    onClick={() => {\n                      if (confirm(`Are you sure you want to delete ${item.name}?`)) {\n                        onDeleteMenuItem(item.id);\n                      }\n                    }}\n                    className=\"px-2.5 py-1.5 text-red-600 hover:bg-red-50 rounded-xl text-xs font-bold transition cursor-pointer\"\n                  >\n                    <Trash2 className=\"w-3.5 h-3.5\" />\n                  </button>\n                </div>\n              ) : (\n                <span className=\"text-[11px] text-[#756D67] italic flex items-center gap-1\">\n                  <Lock className=\"w-3 h-3 text-[#E65100]\" />\n                  Owner edit restricted\n                </span>\n              )}\n            </div>\n          </div>\n        ))}\n      </div>"
