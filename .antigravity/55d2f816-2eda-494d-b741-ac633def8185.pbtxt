    replacement_chunks {
      target_content: "  // --- USER SWITCHER ---\n  const handleSwitchUserRole = () => {\n    if (currentUser.role === \'ADMIN\') {\n      setCurrentUser({\n        id: \'u2\',\n        name: \'Cashier Staff\',\n        role: \'CASHIER\',\n        pin: settings.cashierPin,\n      });\n    } else {\n      // Prompt PIN override\n      setPinModalState({\n        isOpen: true,\n        reason: \'Switching to Administrator (Owner) account requires Admin Security PIN.\',\n        onSuccessCallback: () => {\n          setCurrentUser({\n            id: \'u1\',\n            name: \'Ate Maria (Owner)\',\n            role: \'ADMIN\',\n            pin: settings.adminPin,\n          });\n        },\n      });\n    }\n  };\n\n  // Compute Tax Relief Metrics\n  const taxReliefStats = useMemo(() => {\n    return db.getTaxReliefStats();\n  }, [transactions]);\n\n  return (\n    <div className=\"min-h-screen bg-[#FCFAF7] text-[#2D241E] font-sans flex flex-col selection:bg-[#E65100] selection:text-white\">\n      \n      {/* Top Header & Navigation */}\n      <Header\n        settings={settings}\n        currentUser={currentUser}\n        isOnline={isOnline}\n        pendingSyncCount={pendingSyncCount}\n        onSyncTrigger={handleTriggerManualSync}\n        onSwitchUser={handleSwitchUserRole}\n        activeTab={activeTab}\n        setActiveTab={setActiveTab}\n      />\n\n      {/* Main Content View Switcher */}\n      <main className=\"flex-1 pb-4\">\n        {activeTab === \'pos\' && (\n          <POSModule\n            menuItems={menuItems}\n            cart={cart}\n            onAddToCart={handleAddToCart}\n            onUpdateCartItemQuantity={handleUpdateCartItemQuantity}\n            onRemoveCartItem={handleRemoveCartItem}\n            onClearCart={handleClearCart}\n            isSeniorOrPwd={isSeniorOrPwd}\n            onToggleSeniorPwd={handleToggleSeniorPwd}\n            seniorPwdId={seniorPwdId}\n            seniorPwdName={seniorPwdName}\n            onOpenCheckout={() => setIsCheckoutOpen(true)}\n          />\n        )}\n\n        {activeTab === \'menu\' && (\n          <MenuManagementModule\n            menuItems={menuItems}\n            onToggleSoldOut={handleToggleSoldOut}\n            onSaveMenuItem={handleSaveMenuItem}\n            onDeleteMenuItem={handleDeleteMenuItem}\n          />\n        )}\n\n        {activeTab === \'listahan\' && (\n          <ListahanModule\n            customers={customers}\n            debtPayments={debtPayments}\n            onSaveCustomer={handleSaveCustomer}\n            onRecordPayment={handleRecordPayment}\n            receivedBy={currentUser.name}\n          />\n        )}\n\n        {activeTab === \'eod\' && (\n          <EODModule\n            transactions={transactions}\n            menuItems={menuItems}\n            eodLogs={eodLogs}\n            closedBy={currentUser.name}\n            onSaveEODRecord={handleSaveEODRecord}\n          />\n        )}\n\n        {activeTab === \'bplo\' && (\n          <BploTaxModule\n            stats={taxReliefStats}\n            settings={settings}\n            onUpgradeTier={handleSelectTier}\n          />\n        )}\n\n        {activeTab === \'subscription\' && (\n          <SubscriptionModule\n            activeTier={settings.activeTier}\n            onSelectTier={handleSelectTier}\n          />\n        )}\n\n        {activeTab === \'settings\' && (\n          <SettingsModule\n            settings={settings}\n            onSaveSettings={handleSaveSettings}\n            onUpgradeTier={handleSelectTier}\n          />\n        )}\n      </main>"
      replacement_content: "  // --- AUTH / USER MANAGEMENT ---\n  const handleLoginSuccess = (user: UserProfile) => {\n    setCurrentUser(user);\n    setIsLoggedIn(true);\n    setActiveTab(\'pos\');\n  };\n\n  const handleSignOut = () => {\n    setIsLoggedIn(false);\n    setCurrentUser(null);\n  };\n\n  const handleSwitchUserRole = () => {\n    handleSignOut();\n  };\n\n  // Compute Tax Relief Metrics\n  const taxReliefStats = useMemo(() => {\n    return db.getTaxReliefStats();\n  }, [transactions]);\n\n  // Render Login Landing Page if not logged in\n  if (!isLoggedIn || !currentUser) {\n    return (\n      <LoginLandingPage\n        settings={settings}\n        onLoginSuccess={handleLoginSuccess}\n      />\n    );\n  }\n\n  return (\n    <div className=\"min-h-screen bg-[#FCFAF7] text-[#2D241E] font-sans flex flex-col selection:bg-[#E65100] selection:text-white\">\n      \n      {/* Top Header & Navigation */}\n      <Header\n        settings={settings}\n        currentUser={currentUser}\n        isOnline={isOnline}\n        pendingSyncCount={pendingSyncCount}\n        onSyncTrigger={handleTriggerManualSync}\n        onSwitchUser={handleSwitchUserRole}\n        activeTab={activeTab}\n        setActiveTab={setActiveTab}\n      />\n\n      {/* Main Content View Switcher */}\n      <main className=\"flex-1 pb-4\">\n        {activeTab === \'pos\' && (\n          <POSModule\n            menuItems={menuItems}\n            cart={cart}\n            onAddToCart={handleAddToCart}\n            onUpdateCartItemQuantity={handleUpdateCartItemQuantity}\n            onRemoveCartItem={handleRemoveCartItem}\n            onClearCart={handleClearCart}\n            isSeniorOrPwd={isSeniorOrPwd}\n            onToggleSeniorPwd={handleToggleSeniorPwd}\n            seniorPwdId={seniorPwdId}\n            seniorPwdName={seniorPwdName}\n            onOpenCheckout={() => setIsCheckoutOpen(true)}\n          />\n        )}\n\n        {activeTab === \'receipts\' && (\n          <ReceiptsArchiveModule\n            transactions={transactions}\n            settings={settings}\n            onSelectReceipt={(tx) => setCompletedTxForReceipt(tx)}\n          />\n        )}\n\n        {activeTab === \'menu\' && (\n          <MenuManagementModule\n            menuItems={menuItems}\n            currentUserRole={currentUser.role}\n            onToggleSoldOut={handleToggleSoldOut}\n            onSaveMenuItem={handleSaveMenuItem}\n            onDeleteMenuItem={handleDeleteMenuItem}\n          />\n        )}\n\n        {activeTab === \'listahan\' && (\n          <ListahanModule\n            customers={customers}\n            debtPayments={debtPayments}\n            onSaveCustomer={handleSaveCustomer}\n            onRecordPayment={handleRecordPayment}\n            receivedBy={currentUser.name}\n          />\n        )}\n\n        {activeTab === \'eod\' && (\n          <EODModule\n            transactions={transactions}\n            menuItems={menuItems}\n            eodLogs={eodLogs}\n            closedBy={currentUser.name}\n            onSaveEODRecord={handleSaveEODRecord}\n          />\n        )}\n\n        {activeTab === \'bplo\' && (\n          <BploTaxModule\n            stats={taxReliefStats}\n            settings={settings}\n            onUpgradeTier={handleSelectTier}\n          />\n        )}\n\n        {activeTab === \'subscription\' && (\n          <SubscriptionModule\n            activeTier={settings.activeTier}\n            onSelectTier={handleSelectTier}\n          />\n        )}\n\n        {activeTab === \'settings\' && (\n          <SettingsModule\n            settings={settings}\n            onSaveSettings={handleSaveSettings}\n            onUpgradeTier={handleSelectTier}\n          />\n        )}\n      </main>"
    }
