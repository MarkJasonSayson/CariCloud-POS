  file_change {
    absolute_path_uri: "file:///src/components/SettingsModule.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  SlidersHorizontal, \n  Store, \n  ShieldCheck, \n  Lock, \n  Palette, \n  Users, \n  User, \n  CheckCircle2,\n  Plus,\n  Trash2,\n  Edit2,\n  UserPlus,\n  Key\n} from \'lucide-react\';\nimport { StoreSettings, OperationalMode, SubscriptionTierLevel, UserProfile } from \'../types\';\n\ninterface SettingsModuleProps {\n  settings: StoreSettings;\n  staffAccounts: UserProfile[];\n  onSaveSettings: (settings: StoreSettings) => void;\n  onUpgradeTier: (tier: SubscriptionTierLevel) => void;\n  onSaveStaffAccount: (user: UserProfile) => void;\n  onDeleteStaffAccount: (userId: string) => void;\n}\n\nexport const SettingsModule: React.FC<SettingsModuleProps> = ({\n  settings,\n  staffAccounts,\n  onSaveSettings,\n  onUpgradeTier,\n  onSaveStaffAccount,\n  onDeleteStaffAccount,\n}) => {\n  const [storeName, setStoreName] = useState(settings.storeName);\n  const [branchName, setBranchName] = useState(settings.branchName);\n  const [address, setAddress] = useState(settings.address);\n  const [tinNumber, setTinNumber] = useState(settings.tinNumber);\n  const [bploPermitNo, setBploPermitNo] = useState(settings.bploPermitNo);\n  const [contactNumber, setContactNumber] = useState(settings.contactNumber);\n  const [operationalMode, setOperationalMode] = useState<OperationalMode>(settings.operationalMode);\n  const [themeColor, setThemeColor] = useState<\'orange\' | \'amber\' | \'emerald\' | \'slate\'>(settings.themeColor);\n  const [adminPin, setAdminPin] = useState(settings.adminPin);\n  const [cashierPin, setCashierPin] = useState(settings.cashierPin);\n\n  // Employee Management Modal State\n  const [isEmpModalOpen, setIsEmpModalOpen] = useState(false);\n  const [editingEmp, setEditingEmp] = useState<UserProfile | null>(null);\n  const [empName, setEmpName] = useState(\'\');\n  const [empPin, setEmpPin] = useState(\'0000\');\n\n  const isTier2Unlocked = settings.activeTier >= 2;\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    const updated: StoreSettings = {\n      ...settings,\n      storeName: storeName.trim(),\n      branchName: branchName.trim(),\n      address: address.trim(),\n      tinNumber: tinNumber.trim(),\n      bploPermitNo: bploPermitNo.trim(),\n      contactNumber: contactNumber.trim(),\n      operationalMode,\n      themeColor,\n      adminPin: adminPin.trim() || \'1234\',\n      cashierPin: cashierPin.trim() || \'0000\',\n    };\n\n    onSaveSettings(updated);\n    alert(\'System settings updated successfully!\');\n  };\n\n  const handleOpenAddEmp = () => {\n    setEditingEmp(null);\n    setEmpName(\'\');\n    setEmpPin(\'0000\');\n    setIsEmpModalOpen(true);\n  };\n\n  const handleOpenEditEmp = (emp: UserProfile) => {\n    setEditingEmp(emp);\n    setEmpName(emp.name);\n    setEmpPin(emp.pin);\n    setIsEmpModalOpen(true);\n  };\n\n  const handleSaveEmpForm = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!empName.trim()) {\n      alert(\'Please enter a valid employee staff name.\');\n      return;\n    }\n    if (!empPin || empPin.length !== 4) {\n      alert(\'Please enter a valid 4-digit PIN for the employee.\');\n      return;\n    }\n\n    const user: UserProfile = {\n      id: editingEmp ? editingEmp.id : \'u-emp-\' + Date.now(),\n      name: empName.trim(),\n      role: \'CASHIER\',\n      pin: empPin.trim(),\n      avatar: `https://images.unsplash.com/photo-${1570000000000 + Math.floor(Math.random() * 100000)}?auto=format&fit=crop&w=150&q=80`,\n    };\n\n    onSaveStaffAccount(user);\n    setIsEmpModalOpen(false);\n    alert(`Employee account ${user.name} saved successfully!`);\n  };\n\n  return (\n    <div className=\"max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6\">\n      \n      <div className=\"bg-white rounded-xl shadow-sm border border-slate-200 p-4 flex items-center justify-between\">\n        <div>\n          <h2 className=\"text-xl font-bold text-slate-900 flex items-center gap-2\">\n            <SlidersHorizontal className=\"w-5 h-5 text-orange-600\" />\n            Core System Configuration & Multi-Tenant Settings\n          </h2>\n          <p className=\"text-xs text-slate-500 mt-0.5\">\n            Configure store metadata, employee staff accounts, multi-tenant governance, and security PINs\n          </p>\n        </div>\n      </div>\n\n      <form onSubmit={handleSubmit} className=\"space-y-6\">\n        \n        {/* OPERATIONAL MODE SWITCH */}\n        <div className=\"bg-white rounded-2xl shadow-sm border border-slate-200 p-5 space-y-4\">\n          <h3 className=\"font-bold text-slate-900 text-sm flex items-center gap-2 border-b border-slate-100 pb-2\">\n            <Users className=\"w-4 h-4 text-orange-600\" />\n            Operational Workspace Architecture\n          </h3>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            \n            <button\n              type=\"button\"\n              onClick={() => setOperationalMode(\'SINGLE_OPERATOR\')}\n              className={`p-4 rounded-xl border text-left flex flex-col justify-between transition ${\n                operationalMode === \'SINGLE_OPERATOR\'\n                  ? \'bg-orange-50/60 border-orange-500 ring-2 ring-orange-500/20\'\n                  : \'bg-slate-50 border-slate-200 hover:bg-slate-100\'\n              }`}\n            >\n              <div>\n                <div className=\"flex items-center justify-between mb-1\">\n                  <span className=\"font-bold text-slate-900 text-sm\">Single Operator Mode</span>\n                  <User className=\"w-4 h-4 text-orange-600\" />\n                </div>\n                <p className=\"text-xs text-slate-600 leading-relaxed\">\n                  Synthesizes Admin and Staff workflows into a single unified workspace. Best for solo owners.\n                </p>\n              </div>\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={() => setOperationalMode(\'MULTI_TENANT\')}\n              className={`p-4 rounded-xl border text-left flex flex-col justify-between transition ${\n                operationalMode === \'MULTI_TENANT\'\n                  ? \'bg-orange-50/60 border-orange-500 ring-2 ring-orange-500/20\'\n                  : \'bg-slate-50 border-slate-200 hover:bg-slate-100\'\n              }`}\n            >\n              <div>\n                <div className=\"flex items-center justify-between mb-1\">\n                  <span className=\"font-bold text-slate-900 text-sm\">Multi-Tenant Mode</span>\n                  <Users className=\"w-4 h-4 text-orange-600\" />\n                </div>\n                <p className=\"text-xs text-slate-600 leading-relaxed\">\n                  Strictly separates Administrator governance from Cashier Staff workspaces with PIN security and employee account creation.\n                </p>\n              </div>\n            </button>\n\n          </div>\n        </div>\n\n        {/* MULTI-TENANT EMPLOYEE MANAGEMENT SECTION */}\n        {operationalMode === \'MULTI_TENANT\' && (\n          <div className=\"bg-white rounded-2xl shadow-sm border border-orange-200 p-5 space-y-4\">\n            <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-3\">\n              <div>\n                <h3 className=\"font-bold text-slate-900 text-sm flex items-center gap-2\">\n                  <UserPlus className=\"w-4 h-4 text-orange-600\" />\n                  Multi-Tenant Employee Staff Accounts\n                </h3>\n                <p className=\"text-xs text-slate-500 mt-0.5\">\n                  Add and manage individual employee cashier accounts for your store system.\n                </p>\n              </div>\n\n              <button\n                type=\"button\"\n                onClick={handleOpenAddEmp}\n                className=\"px-3.5 py-2 bg-orange-600 hover:bg-orange-700 text-white font-bold rounded-xl text-xs flex items-center justify-center space-x-1.5 shadow-xs transition cursor-pointer\"\n              >\n                <Plus className=\"w-4 h-4\" />\n                <span>Add Employee Account</span>\n              </button>\n            </div>\n\n            {/* Employee Accounts Grid */}\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n              {staffAccounts\n                .filter((s) => s.role === \'CASHIER\')\n                .map((emp) => (\n                  <div\n                    key={emp.id}\n                    className=\"bg-[#FCFAF7] border border-[#E8E2DD] rounded-xl p-3.5 flex items-center justify-between gap-3\"\n                  >\n                    <div className=\"flex items-center space-x-3 min-w-0\">\n                      <div className=\"w-9 h-9 rounded-lg bg-amber-100 text-amber-800 font-bold flex items-center justify-center shrink-0\">\n                        <User className=\"w-5 h-5\" />\n                      </div>\n                      <div className=\"min-w-0\">\n                        <h4 className=\"font-bold text-xs text-[#2D241E] truncate\">{emp.name}</h4>\n                        <div className=\"text-[10px] text-[#756D67] flex items-center gap-1 mt-0.5\">\n                          <Key className=\"w-3 h-3 text-orange-600\" />\n                          <span>PIN: <code className=\"font-mono text-[#2D241E] font-bold\">{emp.pin}</code></span>\n                        </div>\n                      </div>\n                    </div>\n\n                    <div className=\"flex items-center space-x-1 shrink-0\">\n                      <button\n                        type=\"button\"\n                        onClick={() => handleOpenEditEmp(emp)}\n                        className=\"p-1.5 hover:bg-white text-slate-700 rounded-lg transition\"\n                        title=\"Edit PIN or Name\"\n                      >\n                        <Edit2 className=\"w-3.5 h-3.5\" />\n                      </button>\n                      <button\n                        type=\"button\"\n                        onClick={() => {\n                          if (confirm(`Are you sure you want to remove employee ${emp.name}?`)) {\n                            onDeleteStaffAccount(emp.id);\n                          }\n                        }}\n                        className=\"p-1.5 hover:bg-red-50 text-red-600 rounded-lg transition\"\n                        title=\"Delete Account\"\n                      >\n                        <Trash2 className=\"w-3.5 h-3.5\" />\n                      </button>\n                    </div>\n                  </div>\n                ))}\n            </div>\n          </div>\n        )}\n\n        {/* SECURITY PINS */}\n        <div className=\"bg-white rounded-2xl shadow-sm border border-slate-200 p-5 space-y-4\">\n          <h3 className=\"font-bold text-slate-900 text-sm flex items-center gap-2 border-b border-slate-100 pb-2\">\n            <Lock className=\"w-4 h-4 text-orange-600\" />\n            Default Governance PINs\n          </h3>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            <div>\n              <label className=\"block text-xs font-bold text-slate-700 mb-1\">\n                Admin / Owner Digital Override PIN (Default: 1234)\n              </label>\n              <input\n                type=\"password\"\n                maxLength={4}\n                value={adminPin}\n                onChange={(e) => setAdminPin(e.target.value)}\n                className=\"w-full font-mono text-center tracking-widest font-black text-lg px-3 py-2 border border-slate-300 rounded-xl focus:ring-2 focus:ring-orange-500\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-bold text-slate-700 mb-1\">\n                Default Cashier Staff Access PIN (Default: 0000)\n              </label>\n              <input\n                type=\"password\"\n                maxLength={4}\n                value={cashierPin}\n                onChange={(e) => setCashierPin(e.target.value)}\n                className=\"w-full font-mono text-center tracking-widest font-black text-lg px-3 py-2 border border-slate-300 rounded-xl focus:ring-2 focus:ring-orange-500\"\n              />\n            </div>\n          </div>\n        </div>\n\n        {/* THEME PERSONALIZATION (Tier 2 feature) */}\n        <div className=\"bg-white rounded-2xl shadow-sm border border-slate-200 p-5 space-y-4\">\n          <div className=\"flex items-center justify-between border-b border-slate-100 pb-2\">\n            <h3 className=\"font-bold text-slate-900 text-sm flex items-center gap-2\">\n              <Palette className=\"w-4 h-4 text-orange-600\" />\n              Internal UI Personalization (Tier 2 Feature)\n            </h3>\n            {!isTier2Unlocked && (\n              <span className=\"text-[10px] bg-amber-100 text-amber-800 font-bold px-2 py-0.5 rounded\">\n                Tier 2 Locked\n              </span>\n            )}\n          </div>\n\n          <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3\">\n            {[\n              { id: \'orange\', name: \'Marikina Warm Orange\', hex: \'bg-orange-600\' },\n              { id: \'amber\', name: \'Terracotta Amber\', hex: \'bg-amber-600\' },\n              { id: \'emerald\', name: \'Fresh Emerald\', hex: \'bg-emerald-600\' },\n              { id: \'slate\', name: \'Dark Slate Premium\', hex: \'bg-slate-800\' },\n            ].map((t) => (\n              <button\n                key={t.id}\n                type=\"button\"\n                onClick={() => {\n                  if (!isTier2Unlocked) {\n                    alert(\'UI Theme Personalization requires SaaS Tier 2 (\342\202\26199/mo). Upgrade below.\');\n                    onUpgradeTier(2);\n                  } else {\n                    setThemeColor(t.id as any);\n                  }\n                }}\n                className={`p-3 rounded-xl border flex flex-col items-center gap-2 text-xs font-bold transition ${\n                  themeColor === t.id\n                    ? \'border-slate-900 bg-slate-50 ring-2 ring-slate-900/10\'\n                    : \'border-slate-200 hover:border-slate-300\'\n                }`}\n              >\n                <div className={`w-6 h-6 rounded-full ${t.hex} shadow-sm`} />\n                <span>{t.name}</span>\n              </button>\n            ))}\n          </div>\n        </div>\n\n        {/* STORE METADATA */}\n        <div className=\"bg-white rounded-2xl shadow-sm border border-slate-200 p-5 space-y-4\">\n          <h3 className=\"font-bold text-slate-900 text-sm flex items-center gap-2 border-b border-slate-100 pb-2\">\n            <Store className=\"w-4 h-4 text-orange-600\" />\n            Eatery Legal & Receipt Metadata\n          </h3>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            <div>\n              <label className=\"block text-xs font-bold text-slate-700 mb-1\">\n                Eatery Name *\n              </label>\n              <input\n                type=\"text\"\n                required\n                value={storeName}\n                onChange={(e) => setStoreName(e.target.value)}\n                className=\"w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-orange-500\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-bold text-slate-700 mb-1\">\n                Branch / Location Name *\n              </label>\n              <input\n                type=\"text\"\n                required\n                value={branchName}\n                onChange={(e) => setBranchName(e.target.value)}\n                className=\"w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-orange-500\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-bold text-slate-700 mb-1\">\n                Marikina Business Address\n              </label>\n              <input\n                type=\"text\"\n                value={address}\n                onChange={(e) => setAddress(e.target.value)}\n                className=\"w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-orange-500\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-bold text-slate-700 mb-1\">\n                Contact Phone / Landline\n              </label>\n              <input\n                type=\"text\"\n                value={contactNumber}\n                onChange={(e) => setContactNumber(e.target.value)}\n                className=\"w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-orange-500\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-bold text-slate-700 mb-1\">\n                BIR Tax Identification Number (TIN)\n              </label>\n              <input\n                type=\"text\"\n                value={tinNumber}\n                onChange={(e) => setTinNumber(e.target.value)}\n                className=\"w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-orange-500\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-bold text-slate-700 mb-1\">\n                Marikina BPLO Permit Number\n              </label>\n              <input\n                type=\"text\"\n                value={bploPermitNo}\n                onChange={(e) => setBploPermitNo(e.target.value)}\n                className=\"w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-orange-500\"\n              />\n            </div>\n          </div>\n        </div>\n\n        {/* Submit Button */}\n        <div className=\"flex justify-end pt-2\">\n          <button\n            type=\"submit\"\n            className=\"px-6 py-3 bg-orange-600 hover:bg-orange-700 text-white font-bold rounded-xl text-sm shadow-md transition flex items-center space-x-2\"\n          >\n            <CheckCircle2 className=\"w-5 h-5\" />\n            <span>SAVE SYSTEM CONFIGURATION</span>\n          </button>\n        </div>\n\n      </form>\n\n      {/* Add / Edit Employee Modal */}\n      {isEmpModalOpen && (\n        <div className=\"fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 flex items-center justify-center p-4\">\n          <form\n            onSubmit={handleSaveEmpForm}\n            className=\"bg-white rounded-2xl shadow-xl max-w-md w-full p-5 space-y-4 border border-[#E8E2DD]\"\n          >\n            <h3 className=\"font-bold text-base text-[#2D241E] border-b border-[#E8E2DD] pb-2 flex items-center gap-2\">\n              <UserPlus className=\"w-5 h-5 text-orange-600\" />\n              <span>{editingEmp ? \'Edit Employee Account\' : \'Add New Employee Account\'}</span>\n            </h3>\n\n            <div className=\"space-y-3\">\n              <div>\n                <label className=\"block text-xs font-bold text-[#2D241E] mb-1\">\n                  Employee Staff Name *\n                </label>\n                <input\n                  type=\"text\"\n                  required\n                  placeholder=\"e.g. Maria Clara (Shift Cashier)\"\n                  value={empName}\n                  onChange={(e) => setEmpName(e.target.value)}\n                  className=\"w-full px-3 py-2 text-sm border border-[#E8E2DD] rounded-xl focus:ring-2 focus:ring-[#E65100] focus:outline-none\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-bold text-[#2D241E] mb-1\">\n                  4-Digit Security PIN *\n                </label>\n                <input\n                  type=\"password\"\n                  maxLength={4}\n                  required\n                  placeholder=\"0000\"\n                  value={empPin}\n                  onChange={(e) => setEmpPin(e.target.value)}\n                  className=\"w-full font-mono text-center tracking-widest text-lg font-black px-3 py-2 border border-[#E8E2DD] rounded-xl focus:ring-2 focus:ring-[#E65100] focus:outline-none\"\n                />\n              </div>\n            </div>\n\n            <div className=\"flex items-center justify-end space-x-2 pt-3 border-t border-[#E8E2DD]\">\n              <button\n                type=\"button\"\n                onClick={() => setIsEmpModalOpen(false)}\n                className=\"px-4 py-2 text-xs font-semibold text-[#756D67] hover:bg-[#FCFAF7] rounded-xl\"\n              >\n                Cancel\n              </button>\n              <button\n                type=\"submit\"\n                className=\"px-5 py-2 text-xs font-bold bg-[#E65100] hover:bg-[#BF360C] text-white rounded-xl shadow-2xs cursor-pointer\"\n              >\n                Save Employee\n              </button>\n            </div>\n          </form>\n        </div>\n      )}\n\n    </div>\n  );\n};\n"
