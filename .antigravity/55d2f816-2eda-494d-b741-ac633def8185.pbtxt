    instruction: "Add image URLs to initial menu items and export INITIAL_STAFF_ACCOUNTS"
    replacement_infos {
      original_chunk {
        target_content: "import { MenuItem, CustomerCredit, StoreSettings, EODRecord, Transaction } from \'../types\';\n\nexport const INITIAL_MENU_ITEMS: MenuItem[] = [\n  {\n    id: \'m1\',\n    name: \'Pork Adobo\',\n    category: \'Ulam\',\n    price: 70,\n    halfPrice: 35,\n    isSoldOut: false,\n    allowHalfOrder: true,\n    description: \'Tender pork belly braised in soy sauce, vinegar, garlic, and bay leaves.\',\n  },\n  {\n    id: \'m2\',\n    name: \'Sinigang na Baboy\',\n    category: \'Ulam\',\n    price: 80,\n    halfPrice: 40,\n    isSoldOut: false,\n    allowHalfOrder: true,\n    description: \'Savory tamarind soup with pork ribs, kangkong, and radish.\',\n  },\n  {\n    id: \'m3\',\n    name: \'Bicol Express\',\n    category: \'Ulam\',\n    price: 75,\n    halfPrice: 38,\n    isSoldOut: false,\n    allowHalfOrder: true,\n    description: \'Spicy pork cooked in coconut cream with chili and shrimp paste.\',\n  },\n  {\n    id: \'m4\',\n    name: \'Special Pinakbet\',\n    category: \'Ulam\',\n    price: 50,\n    halfPrice: 25,\n    isSoldOut: false,\n    allowHalfOrder: true,\n    description: \'Saut\303\251ed native vegetables with bagnet bits and bagoong.\',\n  },\n  {\n    id: \'m5\',\n    name: \'Special Dinuguan\',\n    category: \'Ulam\',\n    price: 70,\n    halfPrice: 35,\n    isSoldOut: false,\n    allowHalfOrder: true,\n    description: \'Rich pork blood stew seasoned with green chili and vinegar.\',\n  },\n  {\n    id: \'m6\',\n    name: \'Beef Kare-Kare\',\n    category: \'Ulam\',\n    price: 90,\n    halfPrice: 45,\n    isSoldOut: false,\n    allowHalfOrder: true,\n    description: \'Rich peanut sauce stew with tender beef, eggplant, and string beans.\',\n  },\n  {\n    id: \'m7\',\n    name: \'Pork Menudo\',\n    category: \'Ulam\',\n    price: 75,\n    halfPrice: 38,\n    isSoldOut: false,\n    allowHalfOrder: true,\n    description: \'Pork stew with liver, potatoes, carrots, and hotdog slices in tomato sauce.\',\n  },\n  {\n    id: \'m8\',\n    name: \'Lumpiang Shanghai (4 pcs)\',\n    category: \'Ulam\',\n    price: 40,\n    halfPrice: 20,\n    isSoldOut: false,\n    allowHalfOrder: true,\n    description: \'Crispy fried pork spring rolls with sweet chili sauce.\',\n  },\n  {\n    id: \'m9\',\n    name: \'Plain Rice\',\n    category: \'Rice\',\n    price: 15,\n    isSoldOut: false,\n    allowHalfOrder: false,\n    description: \'Freshly steamed local white rice.\',\n  },\n  {\n    id: \'m10\',\n    name: \'Garlic Rice\',\n    category: \'Rice\',\n    price: 20,\n    isSoldOut: false,\n    allowHalfOrder: false,\n    description: \'Fragrant sinangag rice cooked with toasted garlic.\',\n  },\n  {\n    id: \'m11\',\n    name: \"Sago\'t Gulaman\",\n    category: \'Drinks\',\n    price: 20,\n    isSoldOut: false,\n    allowHalfOrder: false,\n    description: \'Refreshing cold beverage with tapioca pearls and gelatin in brown sugar syrup.\',\n  },\n  {\n    id: \'m12\',\n    name: \'Cold Pineapple Juice\',\n    category: \'Drinks\',\n    price: 25,\n    isSoldOut: false,\n    allowHalfOrder: false,\n    description: \'Chilled canned fruit juice.\',\n  },\n  {\n    id: \'m13\',\n    name: \'House Iced Tea\',\n    category: \'Drinks\',\n    price: 20,\n    isSoldOut: false,\n    allowHalfOrder: false,\n    description: \'Brewed iced tea with calamansi zest.\',\n  },\n  {\n    id: \'m14\',\n    name: \"Tokwa\'t Baboy\",\n    category: \'Snacks\',\n    price: 45,\n    isSoldOut: false,\n    allowHalfOrder: false,\n    description: \'Deep-fried tofu cubes and boiled pork mask in soy-vinegar dressing.\',\n  },\n  {\n    id: \'m15\',\n    name: \'Pancit Canton\',\n    category: \'Snacks\',\n    price: 50,\n    halfPrice: 25,\n    isSoldOut: false,\n    allowHalfOrder: true,\n    description: \'Stir-fried egg noodles with vegetables and pork strips.\',\n  },\n  {\n    id: \'m16\',\n    name: \'Special Halo-Halo\',\n    category: \'Specials\',\n    price: 60,\n    isSoldOut: false,\n    allowHalfOrder: false,\n    description: \'Shaved ice dessert topped with ube halaya, leche flan, and pinipig.\',\n  },\n];"
