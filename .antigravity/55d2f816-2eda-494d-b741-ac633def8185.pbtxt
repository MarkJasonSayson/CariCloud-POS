  file_change {
    absolute_path_uri: "file:///src/App.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect, useMemo, useCallback } from \'react\';\nimport { \n  MenuItem, \n  CartItem, \n  Transaction, \n  CustomerCredit, \n  EODRecord, \n  StoreSettings, \n  UserProfile, \n  SelectedModifier, \n  SubscriptionTierLevel,\n  DebtPaymentRecord\n} from \'./types\';\nimport { db } from \'./services/db\';\nimport { Header } from \'./components/Header\';\nimport { LoginLandingPage } from \'./components/LoginLandingPage\';\nimport { POSModule } from \'./components/POSModule\';\nimport { ReceiptsArchiveModule } from \'./components/ReceiptsArchiveModule\';\nimport { CheckoutModal } from \'./components/CheckoutModal\';\nimport { ReceiptModal } from \'./components/ReceiptModal\';\nimport { MenuManagementModule } from \'./components/MenuManagementModule\';\nimport { EODModule } from \'./components/EODModule\';\nimport { ListahanModule } from \'./components/ListahanModule\';\nimport { BploTaxModule } from \'./components/BploTaxModule\';\nimport { SubscriptionModule } from \'./components/SubscriptionModule\';\nimport { SettingsModule } from \'./components/SettingsModule\';\nimport { PinOverrideModal } from \'./components/PinOverrideModal\';\n\nexport default function App() {\n  // --- AUTH / LOGIN LANDING STATE ---\n  const [isLoggedIn, setIsLoggedIn] = useState<boolean>(false);\n\n  // --- APPLICATION STATE ---\n  const [activeTab, setActiveTab] = useState<string>(\'pos\');\n  const [isOnline, setIsOnline] = useState<boolean>(true);\n  const [pendingSyncCount, setPendingSyncCount] = useState<number>(0);\n\n  // Store Configuration & Settings\n  const [settings, setSettings] = useState<StoreSettings>(() => db.getSettings());\n\n  // User Profile State\n  const [currentUser, setCurrentUser] = useState<UserProfile>({\n    id: \'u1\',\n    name: \'Ate Maria (Owner)\',\n    role: \'ADMIN\',\n    pin: \'1234\',\n  });\n\n  // Data Collections\n  const [menuItems, setMenuItems] = useState<MenuItem[]>(() => db.getMenu());\n  const [customers, setCustomers] = useState<CustomerCredit[]>(() => db.getCustomers());\n  const [transactions, setTransactions] = useState<Transaction[]>(() => db.getTransactions());\n  const [eodLogs, setEodLogs] = useState<EODRecord[]>(() => db.getEODLogs());\n  const [debtPayments, setDebtPayments] = useState<DebtPaymentRecord[]>(() => db.getDebtPayments());\n\n  // Cart & POS State\n  const [cart, setCart] = useState<CartItem[]>([]);\n  const [isSeniorOrPwd, setIsSeniorOrPwd] = useState<boolean>(false);\n  const [seniorPwdId, setSeniorPwdId] = useState<string>(\'\');\n  const [seniorPwdName, setSeniorPwdName] = useState<string>(\'\');\n\n  // Modals State\n  const [isCheckoutOpen, setIsCheckoutOpen] = useState<boolean>(false);\n  const [completedTxForReceipt, setCompletedTxForReceipt] = useState<Transaction | null>(null);\n\n  // PIN Override Modal State\n  const [pinModalState, setPinModalState] = useState<{\n    isOpen: boolean;\n    reason: string;\n    onSuccessCallback: () => void;\n  }>({\n    isOpen: false,\n    reason: \'\',\n    onSuccessCallback: () => {},\n  });\n\n  // Network Online Status Listener\n  useEffect(() => {\n    const handleOnline = () => setIsOnline(true);\n    const handleOffline = () => setIsOnline(false);\n\n    window.addEventListener(\'online\', handleOnline);\n    window.addEventListener(\'offline\', handleOffline);\n\n    setIsOnline(navigator.onLine);\n    setPendingSyncCount(db.getSyncQueue().length);\n\n    return () => {\n      window.removeEventListener(\'online\', handleOnline);\n      window.removeEventListener(\'offline\', handleOffline);\n    };\n  }, []);\n\n  // --- MANUAL SYNC TRIGGER ---\n  const handleTriggerManualSync = () => {\n    setIsOnline(true);\n    db.clearSyncQueue();\n    setPendingSyncCount(0);\n    alert(\'Synchronization complete! All local IndexedDB records synced with server.\');\n  };\n\n  // --- CART HANDLERS ---\n  const handleAddToCart = (item: MenuItem, isHalfOrder: boolean, modifiers: SelectedModifier[] = []) => {\n    const basePrice = isHalfOrder && item.halfPrice ? item.halfPrice : item.price;\n    const modifierTotal = modifiers.reduce((sum, m) => sum + m.price, 0);\n    const unitPrice = basePrice + modifierTotal;\n\n    const cartItemId = `${item.id}-${isHalfOrder ? \'half\' : \'full\'}-${modifiers.map((m) => m.name).sort().join(\'-\')}`;\n\n    setCart((prevCart) => {\n      const existingIdx = prevCart.findIndex((i) => i.cartItemId === cartItemId);\n      if (existingIdx >= 0) {\n        const updated = [...prevCart];\n        const currentQty = updated[existingIdx].quantity + 1;\n        updated[existingIdx] = {\n          ...updated[existingIdx],\n          quantity: currentQty,\n          totalPrice: currentQty * unitPrice,\n        };\n        return updated;\n      } else {\n        const newItem: CartItem = {\n          cartItemId,\n          menuItem: item,\n          isHalfOrder,\n          quantity: 1,\n          selectedModifiers: modifiers,\n          unitPrice,\n          totalPrice: unitPrice,\n        };\n        return [...prevCart, newItem];\n      }\n    });\n  };\n\n  const handleUpdateCartItemQuantity = (cartItemId: string, newQty: number) => {\n    if (newQty <= 0) {\n      handleRemoveCartItem(cartItemId);\n      return;\n    }\n    setCart((prevCart) =>\n      prevCart.map((item) =>\n        item.cartItemId === cartItemId\n          ? {\n              ...item,\n              quantity: newQty,\n              totalPrice: newQty * item.unitPrice,\n            }\n          : item\n      )\n    );\n  };\n\n  const handleRemoveCartItem = (cartItemId: string) => {\n    setCart((prevCart) => prevCart.filter((i) => i.cartItemId !== cartItemId));\n  };\n\n  const handleClearCart = () => {\n    setCart([]);\n    setIsSeniorOrPwd(false);\n    setSeniorPwdId(\'\');\n    setSeniorPwdName(\'\');\n  };\n\n  // Senior / PWD Statutory Discount Handler\n  const handleToggleSeniorPwd = (enable: boolean, idNum: string = \'\', name: string = \'\') => {\n    setIsSeniorOrPwd(enable);\n    if (enable) {\n      setSeniorPwdId(idNum);\n      setSeniorPwdName(name);\n    } else {\n      setSeniorPwdId(\'\');\n      setSeniorPwdName(\'\');\n    }\n  };\n\n  // Math Computations for Cart Subtotal & VAT Exemption\n  const cartSubtotal = useMemo(() => {\n    return cart.reduce((sum, item) => sum + item.totalPrice, 0);\n  }, [cart]);\n\n  const discountDetails = useMemo(() => {\n    if (!isSeniorOrPwd || cartSubtotal <= 0) {\n      return {\n        isSeniorOrPwd: false,\n        vatExemptAmount: 0,\n        discountAmount: 0,\n        finalTotal: cartSubtotal,\n      };\n    }\n\n    // Philippine Statutory Discount Formula: Gross / 1.12 = Net Vatable Base. Net Vatable Base * 0.20 = SC/PWD Discount\n    const vatableBase = cartSubtotal / 1.12;\n    const vatExemptAmount = cartSubtotal - vatableBase;\n    const discountAmount = vatableBase * 0.20;\n    const finalTotal = Math.max(0, cartSubtotal - vatExemptAmount - discountAmount);\n\n    return {\n      isSeniorOrPwd: true,\n      idNumber: seniorPwdId,\n      customerName: seniorPwdName,\n      vatExemptAmount,\n      discountAmount,\n      finalTotal,\n    };\n  }, [isSeniorOrPwd, cartSubtotal, seniorPwdId, seniorPwdName]);\n\n  // --- CHECKOUT TRANSACTION COMPLETION ---\n  const handleCompleteTransaction = (tx: Transaction) => {\n    const savedTx = db.addTransaction(tx, isOnline);\n    setTransactions(db.getTransactions());\n    setCustomers(db.getCustomers()); // Refresh debt if Listahan was used\n    handleClearCart();\n    setIsCheckoutOpen(false);\n    setCompletedTxForReceipt(savedTx);\n  };\n\n  // --- MENU MANAGEMENT HANDLERS ---\n  const handleToggleSoldOut = (itemId: string, isSoldOut: boolean) => {\n    const updated = db.toggleSoldOut(itemId, isSoldOut);\n    setMenuItems(updated);\n  };\n\n  const handleSaveMenuItem = (item: MenuItem) => {\n    const updated = db.saveMenuItem(item);\n    setMenuItems(updated);\n  };\n\n  const handleDeleteMenuItem = (itemId: string) => {\n    const updated = db.deleteMenuItem(itemId);\n    setMenuItems(updated);\n  };\n\n  // --- LISTAHAN CREDIT HANDLERS ---\n  const handleSaveCustomer = (cust: CustomerCredit) => {\n    const updated = db.saveCustomer(cust);\n    setCustomers(updated);\n  };\n\n  const handleRecordPayment = (customerId: string, amount: number, notes?: string) => {\n    const res = db.recordCustomerPayment(customerId, amount, currentUser.name, notes);\n    if (res) {\n      setCustomers(db.getCustomers());\n      setDebtPayments(db.getDebtPayments());\n    }\n  };\n\n  // --- EOD HANDLER ---\n  const handleSaveEODRecord = (record: EODRecord) => {\n    const updated = db.addEODRecord(record);\n    setEodLogs(updated);\n  };\n\n  // --- STORE SETTINGS HANDLERS ---\n  const handleSaveSettings = (newSettings: StoreSettings) => {\n    db.saveSettings(newSettings);\n    setSettings(newSettings);\n    alert(\'Store Settings successfully updated!\');\n  };\n\n  const handleSelectTier = (tier: SubscriptionTierLevel) => {\n    const updatedSettings = { ...settings, activeTier: tier };\n    db.saveSettings(updatedSettings);\n    setSettings(updatedSettings);\n    alert(`CariCloud SaaS Plan updated to Tier ${tier}!`);\n  };\n\n  // --- LOGOUT / SWITCH USER ---\n  const handleSwitchUserRole = () => {\n    setIsLoggedIn(false);\n  };\n\n  // Compute Tax Relief Metrics\n  const taxReliefStats = useMemo(() => {\n    return db.getTaxReliefStats();\n  }, [transactions]);\n\n  // RENDER LANDING / LOGIN PAGE IF NOT LOGGED IN\n  if (!isLoggedIn) {\n    return (\n      <LoginLandingPage\n        settings={settings}\n        onLoginSuccess={(user) => {\n          setCurrentUser(user);\n          setIsLoggedIn(true);\n          setActiveTab(\'pos\');\n        }}\n      />\n    );\n  }\n\n  return (\n    <div className=\"min-h-screen bg-[#FCFAF7] text-[#2D241E] font-sans flex flex-col selection:bg-[#E65100] selection:text-white\">\n      \n      {/* Top Header & Navigation */}\n      <Header\n        settings={settings}\n        currentUser={currentUser}\n        isOnline={isOnline}\n        pendingSyncCount={pendingSyncCount}\n        onSyncTrigger={handleTriggerManualSync}\n        onSwitchUser={handleSwitchUserRole}\n        activeTab={activeTab}\n        setActiveTab={setActiveTab}\n      />\n\n      {/* Main Content View Switcher */}\n      <main className=\"flex-1 pb-4\">\n        {activeTab === \'pos\' && (\n          <POSModule\n            menuItems={menuItems}\n            cart={cart}\n            onAddToCart={handleAddToCart}\n            onUpdateCartItemQuantity={handleUpdateCartItemQuantity}\n            onRemoveCartItem={handleRemoveCartItem}\n            onClearCart={handleClearCart}\n            isSeniorOrPwd={isSeniorOrPwd}\n            onToggleSeniorPwd={handleToggleSeniorPwd}\n            seniorPwdId={seniorPwdId}\n            seniorPwdName={seniorPwdName}\n            onOpenCheckout={() => setIsCheckoutOpen(true)}\n          />\n        )}\n\n        {activeTab === \'receipts\' && (\n          <ReceiptsArchiveModule\n            transactions={transactions}\n            settings={settings}\n            onSelectReceipt={(tx) => setCompletedTxForReceipt(tx)}\n          />\n        )}\n\n        {activeTab === \'menu\' && (\n          <MenuManagementModule\n            menuItems={menuItems}\n            currentUserRole={currentUser.role}\n            onToggleSoldOut={handleToggleSoldOut}\n            onSaveMenuItem={handleSaveMenuItem}\n            onDeleteMenuItem={handleDeleteMenuItem}\n          />\n        )}\n\n        {activeTab === \'listahan\' && (\n          <ListahanModule\n            customers={customers}\n            debtPayments={debtPayments}\n            onSaveCustomer={handleSaveCustomer}\n            onRecordPayment={handleRecordPayment}\n            receivedBy={currentUser.name}\n          />\n        )}\n\n        {activeTab === \'eod\' && (\n          <EODModule\n            transactions={transactions}\n            menuItems={menuItems}\n            eodLogs={eodLogs}\n            closedBy={currentUser.name}\n            onSaveEODRecord={handleSaveEODRecord}\n          />\n        )}\n\n        {activeTab === \'bplo\' && (\n          <BploTaxModule\n            stats={taxReliefStats}\n            settings={settings}\n            onUpgradeTier={handleSelectTier}\n          />\n        )}\n\n        {activeTab === \'subscription\' && (\n          <SubscriptionModule\n            activeTier={settings.activeTier}\n            onSelectTier={handleSelectTier}\n          />\n        )}\n\n        {activeTab === \'settings\' && (\n          <SettingsModule\n            settings={settings}\n            onSaveSettings={handleSaveSettings}\n            onUpgradeTier={handleSelectTier}\n          />\n        )}\n      </main>\n\n      {/* Clean Utility Theme Status Bar */}\n      <div className=\"h-8 bg-[#FDEBD0] text-[#784515] border-t border-[#E8E2DD] flex items-center px-4 sm:px-6 text-[11px] font-semibold tracking-wide justify-between shrink-0 sticky bottom-0 z-20 shadow-xs\">\n        <span className=\"truncate\">\n          \342\200\242 MARIKINA TAX RELIEF TRACKER: Gross \342\202\261{taxReliefStats.currentAnnualGross.toLocaleString()} / \342\202\261{taxReliefStats.annualGrossThreshold.toLocaleString()} cap. ({Math.max(0, taxReliefStats.annualGrossThreshold - taxReliefStats.currentAnnualGross).toLocaleString()} remaining)\n        </span>\n        <span className=\"ml-4 font-mono text-[10px] uppercase shrink-0 bg-[#784515]/10 px-2 py-0.5 rounded\">\n          OPERATOR: {currentUser.role === \'ADMIN\' ? \'OWNER\' : \'EMPLOYEE\'} | OOS SYNC: {isOnline ? \'ACTIVE\' : `OFFLINE (${pendingSyncCount} QUEUED)`}\n        </span>\n      </div>\n\n      {/* CHECKOUT SETTLEMENT MODAL */}\n      <CheckoutModal\n        isOpen={isCheckoutOpen}\n        onClose={() => setIsCheckoutOpen(false)}\n        cart={cart}\n        subtotal={cartSubtotal}\n        discount={discountDetails}\n        totalAmount={discountDetails.finalTotal}\n        customers={customers}\n        cashierName={currentUser.name}\n        adminPin={settings.adminPin}\n        onComplete={handleCompleteTransaction}\n        onOpenPinModal={(reason, onSuccess) => {\n          setPinModalState({\n            isOpen: true,\n            reason,\n            onSuccessCallback: onSuccess,\n          });\n        }}\n      />\n\n      {/* RECEIPT MODAL */}\n      <ReceiptModal\n        transaction={completedTxForReceipt}\n        settings={settings}\n        onClose={() => setCompletedTxForReceipt(null)}\n      />\n\n      {/* SECURITY PIN OVERRIDE MODAL */}\n      <PinOverrideModal\n        isOpen={pinModalState.isOpen}\n        onClose={() => setPinModalState((prev) => ({ ...prev, isOpen: false }))}\n        reason={pinModalState.reason}\n        expectedPin={settings.adminPin}\n        onSuccess={pinModalState.onSuccessCallback}\n      />\n\n    </div>\n  );\n}\n"
    }
