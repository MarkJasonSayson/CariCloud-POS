  file_change {
    absolute_path_uri: "file:///src/components/MenuManagementModule.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  Plus, \n  Edit2, \n  Trash2, \n  Search, \n  CheckCircle, \n  XCircle, \n  AlertCircle, \n  Tag, \n  SlidersHorizontal,\n  UtensilsCrossed,\n  Lock,\n  ShieldAlert\n} from \'lucide-react\';\nimport { MenuItem, Category, Role } from \'../types\';\n\ninterface MenuManagementModuleProps {\n  menuItems: MenuItem[];\n  currentUserRole: Role;\n  onToggleSoldOut: (itemId: string, isSoldOut: boolean) => void;\n  onSaveMenuItem: (item: MenuItem) => void;\n  onDeleteMenuItem: (itemId: string) => void;\n}\n\nconst CATEGORIES: Category[] = [\'Ulam\', \'Rice\', \'Drinks\', \'Snacks\', \'Specials\'];\n\nexport const MenuManagementModule: React.FC<MenuManagementModuleProps> = ({\n  menuItems,\n  currentUserRole,\n  onToggleSoldOut,\n  onSaveMenuItem,\n  onDeleteMenuItem,\n}) => {\n  const isOwner = currentUserRole === \'ADMIN\';\n\n  const [selectedCategory, setSelectedCategory] = useState<Category | \'ALL\'>(\'ALL\');\n  const [searchQuery, setSearchQuery] = useState<string>(\'\');\n  const [editingItem, setEditingItem] = useState<MenuItem | null>(null);\n  const [isModalOpen, setIsModalOpen] = useState<boolean>(false);\n\n  // Form State\n  const [formName, setFormName] = useState(\'\');\n  const [formCategory, setFormCategory] = useState<Category>(\'Ulam\');\n  const [formPrice, setFormPrice] = useState<number>(70);\n  const [formAllowHalf, setFormAllowHalf] = useState<boolean>(true);\n  const [formHalfPrice, setFormHalfPrice] = useState<number>(35);\n  const [formDesc, setFormDesc] = useState(\'\');\n\n  const filteredItems = menuItems.filter((item) => {\n    const matchesCat = selectedCategory === \'ALL\' || item.category === selectedCategory;\n    const matchesSearch = item.name.toLowerCase().includes(searchQuery.toLowerCase());\n    return matchesCat && matchesSearch;\n  });\n\n  const handleOpenAdd = () => {\n    if (!isOwner) {\n      alert(\'Access Denied: Only store owners can add or edit menu items.\');\n      return;\n    }\n    setEditingItem(null);\n    setFormName(\'\');\n    setFormCategory(\'Ulam\');\n    setFormPrice(70);\n    setFormAllowHalf(true);\n    setFormHalfPrice(35);\n    setFormDesc(\'\');\n    setIsModalOpen(true);\n  };\n\n  const handleOpenEdit = (item: MenuItem) => {\n    if (!isOwner) {\n      alert(\'Access Denied: Only store owners can edit dish items and prices.\');\n      return;\n    }\n    setEditingItem(item);\n    setFormName(item.name);\n    setFormCategory(item.category);\n    setFormPrice(item.price);\n    setFormAllowHalf(item.allowHalfOrder);\n    setFormHalfPrice(item.halfPrice || Math.round(item.price / 2));\n    setFormDesc(item.description || \'\');\n    setIsModalOpen(true);\n  };\n\n  const handleSaveForm = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!isOwner) return;\n\n    if (!formName.trim()) {\n      alert(\'Please enter a valid dish name.\');\n      return;\n    }\n\n    const newItem: MenuItem = {\n      id: editingItem ? editingItem.id : \'m-\' + Date.now(),\n      name: formName.trim(),\n      category: formCategory,\n      price: formPrice,\n      allowHalfOrder: formAllowHalf,\n      halfPrice: formAllowHalf ? formHalfPrice : undefined,\n      isSoldOut: editingItem ? editingItem.isSoldOut : false,\n      description: formDesc.trim() || undefined,\n    };\n\n    onSaveMenuItem(newItem);\n    setIsModalOpen(false);\n  };\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6\">\n      \n      {/* Employee Restricted Notice Banner */}\n      {!isOwner && (\n        <div className=\"bg-amber-50 border border-amber-300 rounded-2xl p-4 flex items-start space-x-3 text-amber-900 shadow-2xs\">\n          <ShieldAlert className=\"w-5 h-5 text-amber-600 shrink-0 mt-0.5\" />\n          <div className=\"text-xs space-y-1\">\n            <h4 className=\"font-extrabold text-amber-900\">\n              Employee Read-Only View: Owner Permissions Required\n            </h4>\n            <p className=\"text-amber-800\">\n              You are currently logged in as an Employee Cashier. Menu editing (adding dishes, modifying prices, or deleting items) is strictly restricted to the Store Owner.\n            </p>\n          </div>\n        </div>\n      )}\n\n      {/* Header Bar */}\n      <div className=\"bg-white rounded-2xl shadow-2xs border border-[#E8E2DD] p-5 flex flex-col md:flex-row items-center justify-between gap-4\">\n        <div>\n          <h2 className=\"text-xl font-extrabold text-[#2D241E] flex items-center gap-2\">\n            <UtensilsCrossed className=\"w-5 h-5 text-[#E65100]\" />\n            Daily Menu Digitization & Stock Control\n          </h2>\n          <p className=\"text-xs text-[#756D67] mt-0.5\">\n            Manage carinderia rotating daily recipes, portion half-prices, and instant sold-out badges\n          </p>\n        </div>\n\n        {isOwner ? (\n          <button\n            onClick={handleOpenAdd}\n            className=\"w-full md:w-auto px-4 py-2.5 bg-[#E65100] hover:bg-[#BF360C] text-white font-extrabold rounded-xl text-xs flex items-center justify-center space-x-1.5 shadow-2xs transition cursor-pointer\"\n          >\n            <Plus className=\"w-4 h-4\" />\n            <span>Add New Dish Item</span>\n          </button>\n        ) : (\n          <div className=\"px-3.5 py-2 bg-[#FCFAF7] border border-[#E8E2DD] text-[#756D67] font-semibold rounded-xl text-xs flex items-center gap-1.5\">\n            <Lock className=\"w-3.5 h-3.5 text-amber-600\" />\n            <span>Owner Only Action</span>\n          </div>\n        )}\n      </div>\n\n      {/* Filter and Search Bar */}\n      <div className=\"bg-white rounded-2xl shadow-2xs border border-[#E8E2DD] p-3.5 space-y-3\">\n        <div className=\"flex flex-col sm:flex-row items-center justify-between gap-3\">\n          <div className=\"relative w-full sm:w-80\">\n            <Search className=\"w-4 h-4 absolute left-3 top-2.5 text-[#756D67]\" />\n            <input\n              type=\"text\"\n              placeholder=\"Search dishes to inspect stock or prices...\"\n              value={searchQuery}\n              onChange={(e) => setSearchQuery(e.target.value)}\n              className=\"w-full pl-9 pr-3 py-1.5 text-sm bg-[#FCFAF7] border border-[#E8E2DD] rounded-xl focus:outline-none focus:ring-2 focus:ring-[#E65100] text-[#2D241E]\"\n            />\n          </div>\n\n          <div className=\"flex space-x-1.5 overflow-x-auto w-full sm:w-auto pb-1 scrollbar-none\">\n            <button\n              onClick={() => setSelectedCategory(\'ALL\')}\n              className={`px-3.5 py-1.5 rounded-xl text-xs font-bold transition whitespace-nowrap border ${\n                selectedCategory === \'ALL\'\n                  ? \'bg-[#E65100] text-white border-[#E65100] shadow-2xs\'\n                  : \'bg-white text-[#756D67] border-[#E8E2DD] hover:text-[#2D241E]\'\n              }`}\n            >\n              All ({menuItems.length})\n            </button>\n            {CATEGORIES.map((cat) => (\n              <button\n                key={cat}\n                onClick={() => setSelectedCategory(cat)}\n                className={`px-3.5 py-1.5 rounded-xl text-xs font-bold transition whitespace-nowrap border ${\n                  selectedCategory === cat\n                    ? \'bg-[#E65100] text-white border-[#E65100] shadow-2xs\'\n                    : \'bg-white text-[#756D67] border-[#E8E2DD] hover:text-[#2D241E]\'\n                }`}\n              >\n                {cat}\n              </button>\n            ))}\n          </div>\n        </div>\n      </div>\n\n      {/* Menu Grid */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n        {filteredItems.map((item) => (\n          <div\n            key={item.id}\n            className={`bg-white rounded-2xl border p-4 shadow-2xs transition flex flex-col justify-between ${\n              item.isSoldOut ? \'border-red-200 bg-red-50/20\' : \'border-[#E8E2DD] hover:border-[#E65100]\'\n            }`}\n          >\n            <div className=\"space-y-2\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"bg-[#FCFAF7] text-[#2D241E] border border-[#E8E2DD] text-[10px] font-bold px-2 py-0.5 rounded-full uppercase tracking-wider\">\n                  {item.category}\n                </span>\n\n                {/* Real-time Sold Out Toggle */}\n                <button\n                  type=\"button\"\n                  disabled={!isOwner}\n                  onClick={() => {\n                    if (isOwner) {\n                      onToggleSoldOut(item.id, !item.isSoldOut);\n                    } else {\n                      alert(\'Only the store owner can toggle dish sold-out status.\');\n                    }\n                  }}\n                  className={`px-2.5 py-1 rounded-full text-[11px] font-bold flex items-center space-x-1 transition ${\n                    item.isSoldOut\n                      ? \'bg-red-600 text-white shadow-2xs\'\n                      : \'bg-emerald-50 text-emerald-800 border border-emerald-200\'\n                  } ${isOwner ? \'cursor-pointer hover:opacity-90\' : \'cursor-not-allowed opacity-80\'}`}\n                >\n                  {item.isSoldOut ? (\n                    <>\n                      <XCircle className=\"w-3.5 h-3.5\" />\n                      <span>SOLD OUT</span>\n                    </>\n                  ) : (\n                    <>\n                      <CheckCircle className=\"w-3.5 h-3.5 text-emerald-600\" />\n                      <span>In Stock</span>\n                    </>\n                  )}\n                </button>\n              </div>\n\n              <div>\n                <h3 className=\"font-extrabold text-[#2D241E] text-base\">{item.name}</h3>\n                {item.description && (\n                  <p className=\"text-xs text-[#756D67] mt-0.5 line-clamp-2\">{item.description}</p>\n                )}\n              </div>\n\n              <div className=\"flex items-center space-x-3 pt-2 text-xs font-bold text-[#2D241E]\">\n                <div>\n                  <span className=\"text-[10px] text-[#756D67] block font-medium\">Full Price:</span>\n                  <span className=\"text-base text-[#2D241E] font-black\">\342\202\261{item.price.toFixed(2)}</span>\n                </div>\n\n                {item.allowHalfOrder && (\n                  <div className=\"border-l border-[#E8E2DD] pl-3\">\n                    <span className=\"text-[10px] text-[#756D67] block font-medium\">Half Portion:</span>\n                    <span className=\"text-base text-[#E65100] font-black\">\342\202\261{(item.halfPrice || item.price/2).toFixed(2)}</span>\n                  </div>\n                )}\n              </div>\n            </div>\n\n            {/* Actions Panel */}\n            <div className=\"flex items-center justify-between pt-3 mt-3 border-t border-[#E8E2DD]\">\n              <span className=\"text-[11px] text-[#756D67] font-medium\">\n                {isOwner ? \'Owner Controls\' : \'Read Only\'}\n              </span>\n\n              <div className=\"flex items-center space-x-2\">\n                <button\n                  disabled={!isOwner}\n                  onClick={() => handleOpenEdit(item)}\n                  className={`px-3 py-1.5 rounded-xl text-xs font-bold flex items-center space-x-1 transition border ${\n                    isOwner\n                      ? \'bg-[#FCFAF7] hover:bg-[#FFF3E0] border-[#E8E2DD] text-[#2D241E] hover:text-[#E65100] cursor-pointer\'\n                      : \'bg-stone-50 border-stone-200 text-stone-400 cursor-not-allowed\'\n                  }`}\n                >\n                  <Edit2 className=\"w-3.5 h-3.5\" />\n                  <span>Edit</span>\n                </button>\n\n                <button\n                  disabled={!isOwner}\n                  onClick={() => {\n                    if (!isOwner) return;\n                    if (confirm(`Are you sure you want to delete ${item.name}?`)) {\n                      onDeleteMenuItem(item.id);\n                    }\n                  }}\n                  className={`px-2.5 py-1.5 rounded-xl text-xs font-bold transition border ${\n                    isOwner\n                      ? \'text-red-600 hover:bg-red-50 border-red-200 cursor-pointer\'\n                      : \'text-stone-300 border-stone-200 cursor-not-allowed\'\n                  }`}\n                >\n                  <Trash2 className=\"w-3.5 h-3.5\" />\n                </button>\n              </div>\n            </div>\n          </div>\n        ))}\n      </div>\n\n      {/* Add / Edit Modal (Only editable by owner) */}\n      {isModalOpen && isOwner && (\n        <div className=\"fixed inset-0 bg-[#2D241E]/60 backdrop-blur-xs z-50 flex items-center justify-center p-4\">\n          <form\n            onSubmit={handleSaveForm}\n            className=\"bg-white rounded-2xl shadow-xl max-w-md w-full p-5 space-y-4 border border-[#E8E2DD]\"\n          >\n            <h3 className=\"font-extrabold text-base text-[#2D241E] border-b border-[#E8E2DD] pb-2\">\n              {editingItem ? \'Edit Dish Item\' : \'Add New Dish Item\'}\n            </h3>\n\n            <div className=\"space-y-3\">\n              <div>\n                <label className=\"block text-xs font-bold text-[#2D241E] mb-1\">\n                  Dish Name *\n                </label>\n                <input\n                  type=\"text\"\n                  required\n                  placeholder=\"e.g. Pork Sinigang na Baboy\"\n                  value={formName}\n                  onChange={(e) => setFormName(e.target.value)}\n                  className=\"w-full px-3 py-2 text-sm border border-[#E8E2DD] rounded-xl focus:ring-2 focus:ring-[#E65100] focus:outline-none\"\n                />\n              </div>\n\n              <div className=\"grid grid-cols-2 gap-3\">\n                <div>\n                  <label className=\"block text-xs font-bold text-[#2D241E] mb-1\">\n                    Category\n                  </label>\n                  <select\n                    value={formCategory}\n                    onChange={(e) => setFormCategory(e.target.value as Category)}\n                    className=\"w-full px-3 py-2 text-sm bg-white border border-[#E8E2DD] rounded-xl focus:ring-2 focus:ring-[#E65100] focus:outline-none\"\n                  >\n                    {CATEGORIES.map((c) => (\n                      <option key={c} value={c}>\n                        {c}\n                      </option>\n                    ))}\n                  </select>\n                </div>\n\n                <div>\n                  <label className=\"block text-xs font-bold text-[#2D241E] mb-1\">\n                    Base Price (\342\202\261) *\n                  </label>\n                  <input\n                    type=\"number\"\n                    min=\"1\"\n                    required\n                    value={formPrice}\n                    onChange={(e) => {\n                      const val = parseFloat(e.target.value) || 0;\n                      setFormPrice(val);\n                      setFormHalfPrice(Math.round(val / 2));\n                    }}\n                    className=\"w-full px-3 py-2 text-sm border border-[#E8E2DD] rounded-xl focus:ring-2 focus:ring-[#E65100] focus:outline-none font-bold\"\n                  />\n                </div>\n              </div>\n\n              {/* Half-Order Portion Scaling Switch */}\n              <div className=\"bg-[#FCFAF7] border border-[#E8E2DD] rounded-xl p-3 space-y-2\">\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"text-xs font-bold text-[#2D241E]\">\n                    Allow Half-Order Portion Scaling?\n                  </span>\n                  <input\n                    type=\"checkbox\"\n                    checked={formAllowHalf}\n                    onChange={(e) => setFormAllowHalf(e.target.checked)}\n                    className=\"w-4 h-4 text-[#E65100] rounded focus:ring-[#E65100] cursor-pointer\"\n                  />\n                </div>\n\n                {formAllowHalf && (\n                  <div>\n                    <label className=\"block text-[11px] font-bold text-[#756D67] mb-1\">\n                      Half Portion Price (\342\202\261)\n                    </label>\n                    <input\n                      type=\"number\"\n                      min=\"1\"\n                      value={formHalfPrice}\n                      onChange={(e) => setFormHalfPrice(parseFloat(e.target.value) || 0)}\n                      className=\"w-full px-3 py-1.5 text-sm border border-[#E8E2DD] rounded-xl focus:ring-2 focus:ring-[#E65100] focus:outline-none font-bold text-[#E65100]\"\n                    />\n                  </div>\n                )}\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-bold text-[#2D241E] mb-1\">\n                  Description / Ingredients (Optional)\n                </label>\n                <textarea\n                  rows={2}\n                  placeholder=\"e.g. Tender pork stewed in sour tamarind broth...\"\n                  value={formDesc}\n                  onChange={(e) => setFormDesc(e.target.value)}\n                  className=\"w-full px-3 py-2 text-sm border border-[#E8E2DD] rounded-xl focus:ring-2 focus:ring-[#E65100] focus:outline-none\"\n                />\n              </div>\n            </div>\n\n            <div className=\"flex items-center justify-end space-x-2 pt-3 border-t border-[#E8E2DD]\">\n              <button\n                type=\"button\"\n                onClick={() => setIsModalOpen(false)}\n                className=\"px-4 py-2 text-xs font-semibold text-[#756D67] hover:bg-[#FCFAF7] rounded-xl\"\n              >\n                Cancel\n              </button>\n              <button\n                type=\"submit\"\n                className=\"px-5 py-2 text-xs font-extrabold bg-[#E65100] hover:bg-[#BF360C] text-white rounded-xl shadow-2xs\"\n              >\n                Save Dish\n              </button>\n            </div>\n          </form>\n        </div>\n      )}\n\n    </div>\n  );\n};\n"
    }
