        }
        lines {
          text: "              <div>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                <label className=\"block text-xs font-bold text-slate-800 mb-1\">"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  Payment Notes / Receipt Ref"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                </label>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                <input"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  type=\"text\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
