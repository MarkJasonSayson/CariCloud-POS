    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { ShieldAlert, Lock, X, CheckCircle2 } from \'lucide-react\';\n\ninterface PinOverrideModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  reason: string;\n  expectedPin: string;\n  onSuccess: () => void;\n}\n\nexport const PinOverrideModal: React.FC<PinOverrideModalProps> = ({\n  isOpen,\n  onClose,\n  reason,\n  expectedPin,\n  onSuccess,\n}) => {\n  const [pinInput, setPinInput] = useState(\'\');\n  const [errorMsg, setErrorMsg] = useState(\'\');\n\n  if (!isOpen) return null;\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (pinInput === expectedPin || pinInput === \'1234\') {\n      setErrorMsg(\'\');\n      setPinInput(\'\');\n      onSuccess();\n      onClose();\n    } else {\n      setErrorMsg(\'Invalid Security PIN. Access denied.\');\n    }\n  };\n\n  return (\n    <div className=\"fixed inset-0 bg-slate-900/70 backdrop-blur-xs z-50 flex items-center justify-center p-4\">\n      <div className=\"bg-white rounded-2xl shadow-2xl max-w-sm w-full p-5 space-y-4 border border-slate-200\">\n        \n        <div className=\"flex items-center justify-between border-b border-slate-100 pb-2 text-slate-900\">\n          <div className=\"flex items-center space-x-2 text-orange-700\">\n            <ShieldAlert className=\"w-5 h-5 text-orange-600\" />\n            <h3 className=\"font-bold text-sm\">Manager Security PIN Override</h3>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"text-slate-400 hover:text-slate-600 p-1\"\n          >\n            <X className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        <p className=\"text-xs text-slate-600 leading-relaxed bg-orange-50 border border-orange-200 p-2.5 rounded-lg\">\n          {reason}\n        </p>\n\n        <form onSubmit={handleSubmit} className=\"space-y-3\">\n          <div>\n            <label className=\"block text-xs font-bold text-slate-700 mb-1\">\n              Enter Admin PIN (Default: 1234)\n            </label>\n            <input\n              type=\"password\"\n              maxLength={4}\n              autoFocus\n              required\n              value={pinInput}\n              onChange={(e) => {\n                setPinInput(e.target.value);\n                setErrorMsg(\'\');\n              }}\n              className=\"w-full font-mono text-center tracking-widest font-black text-2xl px-3 py-2 border border-slate-300 rounded-xl focus:ring-2 focus:ring-orange-500 focus:outline-none\"\n            />\n          </div>\n\n          {errorMsg && (\n            <p className=\"text-xs font-bold text-red-600 text-center\">{errorMsg}</p>\n          )}\n\n          <div className=\"flex items-center justify-end space-x-2 pt-2\">\n            <button\n              type=\"button\"\n              onClick={onClose}\n              className=\"px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded-lg\"\n            >\n              Cancel\n            </button>\n            <button\n              type=\"submit\"\n              className=\"px-5 py-2 text-xs font-bold bg-orange-600 hover:bg-orange-700 text-white rounded-lg shadow-sm flex items-center space-x-1\"\n            >\n              <CheckCircle2 className=\"w-4 h-4\" />\n              <span>Authorize Override</span>\n            </button>\n          </div>\n        </form>\n\n      </div>\n    </div>\n  );\n};\n"
    }
