        }
        lines {
          text: "                <label className=\"block text-xs font-bold text-slate-700 mb-1\">"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                  className=\"w-full text-xl font-black text-emerald-700 px-4 py-3 border border-slate-200 rounded-2xl focus:ring-2 focus:ring-emerald-500 focus:outline-none\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
