    instruction: "Enable cash payment recording for Employees and add rich Account Payment History section and customer history modal"
    replacement_infos {
      original_chunk {
        target_content: "import React, { useState } from \'react\';\nimport { \n  BookOpen, \n  Plus, \n  Search, \n  DollarSign, \n  AlertTriangle, \n  CheckCircle2, \n  UserPlus, \n  History, \n  Phone, \n  MapPin,\n  ShieldAlert,\n  Edit,\n  Eye,\n  Lock\n} from \'lucide-react\';\nimport { CustomerCredit, DebtPaymentRecord, Role } from \'../types\';\n\ninterface ListahanModuleProps {\n  customers: CustomerCredit[];\n  debtPayments: DebtPaymentRecord[];\n  onSaveCustomer: (customer: CustomerCredit) => void;\n  onRecordPayment: (customerId: string, amount: number, receivedBy: string, notes?: string) => void;\n  receivedBy: string;\n  currentUserRole?: Role;\n}\n\nexport const ListahanModule: React.FC<ListahanModuleProps> = ({\n  customers,\n  debtPayments,\n  onSaveCustomer,\n  onRecordPayment,\n  receivedBy,\n  currentUserRole = \'ADMIN\',\n}) => {\n  const isOwner = currentUserRole === \'ADMIN\';\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  const [selectedCustomer, setSelectedCustomer] = useState<CustomerCredit | null>(null);\n\n  // Modals State\n  const [isCustomerModalOpen, setIsCustomerModalOpen] = useState(false);\n  const [isPaymentModalOpen, setIsPaymentModalOpen] = useState(false);\n\n  // New/Edit Customer Form\n  const [editingCustId, setEditingCustId] = useState<string | null>(null);\n  const [custName, setCustName] = useState(\'\');\n  const [custContact, setCustContact] = useState(\'\');\n  const [custAddress, setCustAddress] = useState(\'\');\n  const [custLimit, setCustLimit] = useState<number>(1000);\n  const [custApproved, setCustApproved] = useState<boolean>(true);\n  const [custNotes, setCustNotes] = useState(\'\');\n\n  // Payment Form\n  const [payAmount, setPayAmount] = useState<number>(100);\n  const [payNotes, setPayNotes] = useState(\'\');\n\n  const filteredCustomers = customers.filter((c) =>\n    c.name.toLowerCase().includes(searchQuery.toLowerCase()) ||\n    c.contact.includes(searchQuery)\n  );\n\n  const totalOutstandingUtang = customers.reduce((sum, c) => sum + c.currentDebt, 0);\n\n  const handleOpenAddCustomer = () => {\n    setEditingCustId(null);\n    setCustName(\'\');\n    setCustContact(\'\');\n    setCustAddress(\'\');\n    setCustLimit(1000);\n    setCustApproved(true);\n    setCustNotes(\'\');\n    setIsCustomerModalOpen(true);\n  };\n\n  const handleOpenEditCustomer = (c: CustomerCredit) => {\n    setEditingCustId(c.id);\n    setCustName(c.name);\n    setCustContact(c.contact);\n    setCustAddress(c.address || \'\');\n    setCustLimit(c.creditLimit);\n    setCustApproved(c.isApproved);\n    setCustNotes(c.notes || \'\');\n    setIsCustomerModalOpen(true);\n  };\n\n  const handleSaveCustomerForm = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!custName.trim()) {\n      alert(\'Please enter a customer name.\');\n      return;\n    }\n\n    const target = editingCustId ? customers.find((c) => c.id === editingCustId) : null;\n\n    const newCustomer: CustomerCredit = {\n      id: editingCustId || \'c-\' + Date.now(),\n      name: custName.trim(),\n      contact: custContact.trim(),\n      address: custAddress.trim() || undefined,\n      creditLimit: custLimit,\n      currentDebt: target ? target.currentDebt : 0,\n      isApproved: custApproved,\n      notes: custNotes.trim() || undefined,\n      updatedAt: new Date().toISOString(),\n    };\n\n    onSaveCustomer(newCustomer);\n    setIsCustomerModalOpen(false);\n  };\n\n  const handleOpenPaymentModal = (c: CustomerCredit) => {\n    setSelectedCustomer(c);\n    setPayAmount(c.currentDebt);\n    setPayNotes(\'Cash payment received\');\n    setIsPaymentModalOpen(true);\n  };\n\n  const handleExecutePayment = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!selectedCustomer) return;\n    if (payAmount <= 0) {\n      alert(\'Payment amount must be greater than zero.\');\n      return;\n    }\n\n    onRecordPayment(selectedCustomer.id, payAmount, receivedBy, payNotes);\n    setIsPaymentModalOpen(false);\n    alert(`Payment of \342\202\261${payAmount} recorded for ${selectedCustomer.name}!`);\n  };\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6\">\n      \n      {/* Top Banner */}\n      {!isOwner && (\n        <div className=\"bg-amber-50 border border-amber-200 rounded-xl p-3 text-xs text-amber-900 font-semibold flex items-center justify-between shadow-2xs\">\n          <div className=\"flex items-center space-x-2\">\n            <Eye className=\"w-4 h-4 text-amber-700 shrink-0\" />\n            <span>\n              <strong>Employee View Mode:</strong> You can view customer credit limits, current debts, and payment history. Adding customers, collecting payments, or modifying limits requires Owner account.\n            </span>\n          </div>\n          <span className=\"bg-amber-100 text-amber-800 text-[10px] font-bold px-2 py-0.5 rounded border border-amber-300 shrink-0\">\n            Read-Only Access\n          </span>\n        </div>\n      )}\n\n      <div className=\"bg-white rounded-xl shadow-sm border border-slate-200 p-4 flex flex-col md:flex-row items-center justify-between gap-4\">\n        <div>\n          <h2 className=\"text-xl font-bold text-slate-900 flex items-center gap-2\">\n            <BookOpen className=\"w-5 h-5 text-orange-600\" />\n            Digital Customer Credit Ledger (\"Listahan\")\n          </h2>\n          <p className=\"text-xs text-slate-500 mt-0.5\">\n            Replaces paper notebook tracking for suki customers with authorized credit limits & payment collection\n          </p>\n        </div>\n\n        {/* Total Utang Balance Card */}\n        <div className=\"flex items-center space-x-3 bg-orange-50 border border-orange-200 p-3 rounded-xl w-full md:w-auto\">\n          <div>\n            <span className=\"text-[10px] text-orange-800 font-bold uppercase tracking-wider block\">\n              Total Suki Outstanding Debt\n            </span>\n            <span className=\"text-2xl font-black text-orange-600\">\n              \342\202\261{totalOutstandingUtang.toFixed(2)}\n            </span>\n          </div>\n          {isOwner ? (\n            <button\n              onClick={handleOpenAddCustomer}\n              className=\"ml-auto px-3 py-2 bg-orange-600 hover:bg-orange-700 text-white font-bold rounded-lg text-xs flex items-center gap-1 shadow-xs transition cursor-pointer\"\n            >\n              <UserPlus className=\"w-4 h-4\" />\n              <span>Add Suki</span>\n            </button>\n          ) : (\n            <div className=\"ml-auto px-2.5 py-1.5 bg-slate-100 border border-slate-200 text-slate-500 text-[11px] font-bold rounded-lg flex items-center gap-1\">\n              <Lock className=\"w-3.5 h-3.5\" />\n              <span>Owner Action</span>\n            </div>\n          )}\n        </div>\n      </div>\n\n      {/* Search Bar */}\n      <div className=\"bg-white rounded-xl shadow-sm border border-slate-200 p-3.5\">\n        <div className=\"relative max-w-md\">\n          <Search className=\"w-4 h-4 absolute left-3 top-2.5 text-slate-400\" />\n          <input\n            type=\"text\"\n            placeholder=\"Search Suki by name or phone number...\"\n            value={searchQuery}\n            onChange={(e) => setSearchQuery(e.target.value)}\n            className=\"w-full pl-9 pr-3 py-1.5 text-sm bg-slate-50 border border-slate-200 rounded-lg focus:ring-2 focus:ring-orange-500 text-slate-800\"\n          />\n        </div>\n      </div>\n\n      {/* Customer Credit Directory Cards */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n        {filteredCustomers.map((c) => {\n          const isAtRisk = c.currentDebt >= c.creditLimit * 0.85;\n          const usagePercent = Math.min(100, Math.round((c.currentDebt / c.creditLimit) * 100));\n\n          return (\n            <div\n              key={c.id}\n              className={`bg-white rounded-xl border p-4 shadow-sm transition flex flex-col justify-between ${\n                isAtRisk ? \'border-amber-300 bg-amber-50/10\' : \'border-slate-200 hover:border-orange-300\'\n              }`}\n            >\n              <div className=\"space-y-3\">\n                <div className=\"flex items-start justify-between\">\n                  <div>\n                    <h3 className=\"font-bold text-slate-900 text-base flex items-center gap-1.5\">\n                      <span>{c.name}</span>\n                      {!c.isApproved && (\n                        <span className=\"bg-red-100 text-red-800 text-[9px] font-black px-1.5 py-0.2 rounded uppercase\">\n                          SUSPENDED\n                        </span>\n                      )}\n                    </h3>\n                    <p className=\"text-xs text-slate-500 flex items-center gap-1 mt-0.5\">\n                      <Phone className=\"w-3 h-3 text-slate-400\" />\n                      <span>{c.contact}</span>\n                    </p>\n                  </div>\n\n                  {isOwner && (\n                    <button\n                      onClick={() => handleOpenEditCustomer(c)}\n                      className=\"p-1 text-slate-400 hover:text-slate-700 hover:bg-slate-100 rounded-lg transition cursor-pointer\"\n                    >\n                      <Edit className=\"w-4 h-4\" />\n                    </button>\n                  )}\n                </div>\n\n                {c.address && (\n                  <p className=\"text-xs text-slate-500 flex items-center gap-1\">\n                    <MapPin className=\"w-3 h-3 text-slate-400\" />\n                    <span>{c.address}</span>\n                  </p>\n                )}\n\n                {/* Debt & Limit Meter */}\n                <div className=\"bg-slate-50 p-3 rounded-xl border border-slate-200 space-y-1.5\">\n                  <div className=\"flex justify-between text-xs\">\n                    <span className=\"text-slate-500 font-medium\">Unsettled Balance:</span>\n                    <span className=\"font-black text-slate-900\">\342\202\261{c.currentDebt.toFixed(2)}</span>\n                  </div>\n\n                  <div className=\"flex justify-between text-xs\">\n                    <span className=\"text-slate-500 font-medium\">Approved Credit Limit:</span>\n                    <span className=\"font-bold text-slate-700\">\342\202\261{c.creditLimit.toFixed(2)}</span>\n                  </div>\n\n                  {/* Progress Bar */}\n                  <div className=\"w-full bg-slate-200 h-2 rounded-full overflow-hidden mt-1\">\n                    <div\n                      className={`h-full transition-all ${\n                        usagePercent >= 90\n                          ? \'bg-red-600\'\n                          : usagePercent >= 70\n                          ? \'bg-amber-500\'\n                          : \'bg-emerald-500\'\n                      }`}\n                      style={{ width: `${usagePercent}%` }}\n                    />\n                  </div>\n                </div>\n\n                {c.notes && (\n                  <p className=\"text-[11px] text-slate-500 bg-slate-50 p-2 rounded-lg italic\">\n                    \"{c.notes}\"\n                  </p>\n                )}\n              </div>\n\n              {/* Action */}\n              <div className=\"pt-3 mt-3 border-t border-slate-100\">\n                {isOwner ? (\n                  <button\n                    disabled={c.currentDebt <= 0}\n                    onClick={() => handleOpenPaymentModal(c)}\n                    className=\"w-full py-2 bg-emerald-600 hover:bg-emerald-700 disabled:bg-slate-200 disabled:text-slate-400 text-white font-bold rounded-lg text-xs flex items-center justify-center space-x-1 shadow-xs transition cursor-pointer\"\n                  >\n                    <DollarSign className=\"w-4 h-4\" />\n                    <span>Record Cash Payment</span>\n                  </button>\n                ) : (\n                  <div className=\"w-full py-2 bg-slate-100 border border-slate-200 text-slate-500 font-bold rounded-lg text-xs text-center flex items-center justify-center space-x-1\">\n                    <Lock className=\"w-3.5 h-3.5\" />\n                    <span>Owner Payment Collection Only</span>\n                  </div>\n                )}\n              </div>\n            </div>\n          );\n        })}\n      </div>\n\n      {/* Payment History Table */}\n      <div className=\"bg-white rounded-xl shadow-sm border border-slate-200 p-4 space-y-3\">\n        <h3 className=\"font-bold text-sm text-slate-800 uppercase tracking-wider flex items-center gap-2\">\n          <History className=\"w-4 h-4 text-orange-600\" />\n          Recent Cash Repayment Audit Logs\n        </h3>\n\n        <div className=\"border border-slate-200 rounded-xl overflow-hidden divide-y divide-slate-100 text-xs\">\n          {debtPayments.length === 0 ? (\n            <p className=\"p-4 text-center text-slate-400 font-medium\">No repayments recorded yet.</p>\n          ) : (\n            debtPayments.map((p) => (\n              <div key={p.id} className=\"p-3 flex items-center justify-between bg-slate-50/50\">\n                <div>\n                  <span className=\"font-bold text-slate-900 block\">{p.customerName}</span>\n                  <span className=\"text-slate-500 text-[10px]\">\n                    Received by {p.receivedBy} on {new Date(p.timestamp).toLocaleString()}\n                  </span>\n                </div>\n                <div className=\"text-right\">\n                  <span className=\"font-black text-emerald-600 text-sm block\">+\342\202\261{p.amount.toFixed(2)}</span>\n                  <span className=\"text-slate-400 text-[10px]\">{p.notes}</span>\n                </div>\n              </div>\n            ))\n          )}\n        </div>\n      </div>\n\n      {/* Add / Edit Suki Modal */}\n      {isCustomerModalOpen && (\n        <div className=\"fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 flex items-center justify-center p-4\">\n          <form\n            onSubmit={handleSaveCustomerForm}\n            className=\"bg-white rounded-2xl shadow-xl max-w-md w-full p-5 space-y-4 border border-slate-200\"\n          >\n            <h3 className=\"font-bold text-base text-slate-900 border-b border-slate-100 pb-2\">\n              {editingCustId ? \'Edit Suki Account\' : \'Register New Suki Customer\'}\n            </h3>\n\n            <div className=\"space-y-3\">\n              <div>\n                <label className=\"block text-xs font-bold text-slate-700 mb-1\">\n                  Customer Name *\n                </label>\n                <input\n                  type=\"text\"\n                  required\n                  placeholder=\"e.g. Kapitan Mang Berting\"\n                  value={custName}\n                  onChange={(e) => setCustName(e.target.value)}\n                  className=\"w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:outline-none\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-bold text-slate-700 mb-1\">\n                  Contact Number\n                </label>\n                <input\n                  type=\"text\"\n                  placeholder=\"e.g. 0917-555-1234\"\n                  value={custContact}\n                  onChange={(e) => setCustContact(e.target.value)}\n                  className=\"w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:outline-none\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-bold text-slate-700 mb-1\">\n                  Barangay / Address\n                </label>\n                <input\n                  type=\"text\"\n                  placeholder=\"e.g. Brgy. San Roque, Marikina\"\n                  value={custAddress}\n                  onChange={(e) => setCustAddress(e.target.value)}\n                  className=\"w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:outline-none\"\n                />\n              </div>\n\n              <div className=\"grid grid-cols-2 gap-3\">\n                <div>\n                  <label className=\"block text-xs font-bold text-slate-700 mb-1\">\n                    Credit Limit (\342\202\261)\n                  </label>\n                  <input\n                    type=\"number\"\n                    min=\"100\"\n                    step=\"100\"\n                    value={custLimit}\n                    onChange={(e) => setCustLimit(parseFloat(e.target.value) || 0)}\n                    className=\"w-full px-3 py-2 text-sm font-bold border border-slate-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:outline-none\"\n                  />\n                </div>\n\n                <div className=\"flex items-center pt-5\">\n                  <label className=\"flex items-center space-x-2 text-xs font-bold text-slate-700 cursor-pointer\">\n                    <input\n                      type=\"checkbox\"\n                      checked={custApproved}\n                      onChange={(e) => setCustApproved(e.target.checked)}\n                      className=\"w-4 h-4 text-orange-600 rounded\"\n                    />\n                    <span>Approved for Credit</span>\n                  </label>\n                </div>\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-bold text-slate-700 mb-1\">\n                  Operational Notes\n                </label>\n                <textarea\n                  rows={2}\n                  placeholder=\"e.g. Barangay official. Pays every Friday.\"\n                  value={custNotes}\n                  onChange={(e) => setCustNotes(e.target.value)}\n                  className=\"w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-orange-500\"\n                />\n              </div>\n            </div>\n\n            <div className=\"flex items-center justify-end space-x-2 pt-3 border-t border-slate-100\">\n              <button\n                type=\"button\"\n                onClick={() => setIsCustomerModalOpen(false)}\n                className=\"px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded-lg\"\n              >\n                Cancel\n              </button>\n              <button\n                type=\"submit\"\n                className=\"px-5 py-2 text-xs font-bold bg-orange-600 hover:bg-orange-700 text-white rounded-lg shadow-sm\"\n              >\n                Save Suki Account\n              </button>\n            </div>\n          </form>\n        </div>\n      )}\n\n      {/* Record Payment Modal */}\n      {isPaymentModalOpen && selectedCustomer && (\n        <div className=\"fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 flex items-center justify-center p-4\">\n          <form\n            onSubmit={handleExecutePayment}\n            className=\"bg-white rounded-2xl shadow-xl max-w-md w-full p-5 space-y-4 border border-slate-200\"\n          >\n            <h3 className=\"font-bold text-base text-slate-900 border-b border-slate-100 pb-2\">\n              Record Cash Repayment - {selectedCustomer.name}\n            </h3>\n\n            <div className=\"bg-slate-50 p-3 rounded-xl border border-slate-200 text-xs space-y-1\">\n              <div className=\"flex justify-between\">\n                <span>Current Debt Balance:</span>\n                <span className=\"font-black text-slate-900\">\342\202\261{selectedCustomer.currentDebt.toFixed(2)}</span>\n              </div>\n            </div>\n\n            <div className=\"space-y-3\">\n              <div>\n                <label className=\"block text-xs font-bold text-slate-700 mb-1\">\n                  Cash Amount Received (\342\202\261) *\n                </label>\n                <input\n                  type=\"number\"\n                  min=\"1\"\n                  max={selectedCustomer.currentDebt}\n                  required\n                  value={payAmount}\n                  onChange={(e) => setPayAmount(parseFloat(e.target.value) || 0)}\n                  className=\"w-full text-xl font-black text-emerald-700 px-3 py-2 border border-slate-300 rounded-xl focus:ring-2 focus:ring-emerald-500\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-bold text-slate-700 mb-1\">\n                  Payment Notes / Receipt Ref\n                </label>\n                <input\n                  type=\"text\"\n                  value={payNotes}\n                  onChange={(e) => setPayNotes(e.target.value)}\n                  className=\"w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-orange-500\"\n                />\n              </div>\n            </div>\n\n            <div className=\"flex items-center justify-end space-x-2 pt-3 border-t border-slate-100\">\n              <button\n                type=\"button\"\n                onClick={() => setIsPaymentModalOpen(false)}\n                className=\"px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded-lg\"\n              >\n                Cancel\n              </button>\n              <button\n                type=\"submit\"\n                className=\"px-5 py-2 text-xs font-bold bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg shadow-sm\"\n              >\n                Record Payment\n              </button>\n            </div>\n          </form>\n        </div>\n      )}\n\n    </div>\n  );\n};"
        replacement_content: "import React, { useState } from \'react\';\nimport { \n  BookOpen, \n  Plus, \n  Search, \n  DollarSign, \n  AlertTriangle, \n  CheckCircle2, \n  UserPlus, \n  History, \n  Phone, \n  MapPin,\n  ShieldAlert,\n  Edit,\n  Eye,\n  Lock,\n  Filter,\n  X,\n  Receipt,\n  UserCheck\n} from \'lucide-react\';\nimport { CustomerCredit, DebtPaymentRecord, Role } from \'../types\';\n\ninterface ListahanModuleProps {\n  customers: CustomerCredit[];\n  debtPayments: DebtPaymentRecord[];\n  onSaveCustomer: (customer: CustomerCredit) => void;\n  onRecordPayment: (customerId: string, amount: number, receivedBy: string, notes?: string) => void;\n  receivedBy: string;\n  currentUserRole?: Role;\n}\n\nexport const ListahanModule: React.FC<ListahanModuleProps> = ({\n  customers,\n  debtPayments,\n  onSaveCustomer,\n  onRecordPayment,\n  receivedBy,\n  currentUserRole = \'ADMIN\',\n}) => {\n  const isOwner = currentUserRole === \'ADMIN\';\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  const [selectedCustomer, setSelectedCustomer] = useState<CustomerCredit | null>(null);\n\n  // Dedicated Account Payment History Filter & Modal State\n  const [historyCustomerFilter, setHistoryCustomerFilter] = useState<string>(\'ALL\');\n  const [customerHistoryModal, setCustomerHistoryModal] = useState<CustomerCredit | null>(null);\n\n  // Modals State\n  const [isCustomerModalOpen, setIsCustomerModalOpen] = useState(false);\n  const [isPaymentModalOpen, setIsPaymentModalOpen] = useState(false);\n\n  // New/Edit Customer Form\n  const [editingCustId, setEditingCustId] = useState<string | null>(null);\n  const [custName, setCustName] = useState(\'\');\n  const [custContact, setCustContact] = useState(\'\');\n  const [custAddress, setCustAddress] = useState(\'\');\n  const [custLimit, setCustLimit] = useState<number>(1000);\n  const [custApproved, setCustApproved] = useState<boolean>(true);\n  const [custNotes, setCustNotes] = useState(\'\');\n\n  // Payment Form\n  const [payAmount, setPayAmount] = useState<number>(100);\n  const [payNotes, setPayNotes] = useState(\'\');\n\n  const filteredCustomers = customers.filter((c) =>\n    c.name.toLowerCase().includes(searchQuery.toLowerCase()) ||\n    c.contact.includes(searchQuery)\n  );\n\n  const totalOutstandingUtang = customers.reduce((sum, c) => sum + c.currentDebt, 0);\n\n  // Filtered Debt Payments for History Section\n  const filteredDebtPayments = debtPayments.filter((p) => {\n    if (historyCustomerFilter === \'ALL\') return true;\n    return p.customerId === historyCustomerFilter;\n  });\n\n  const totalCollectedInFilter = filteredDebtPayments.reduce((sum, p) => sum + p.amount, 0);\n\n  const handleOpenAddCustomer = () => {\n    setEditingCustId(null);\n    setCustName(\'\');\n    setCustContact(\'\');\n    setCustAddress(\'\');\n    setCustLimit(1000);\n    setCustApproved(true);\n    setCustNotes(\'\');\n    setIsCustomerModalOpen(true);\n  };\n\n  const handleOpenEditCustomer = (c: CustomerCredit) => {\n    setEditingCustId(c.id);\n    setCustName(c.name);\n    setCustContact(c.contact);\n    setCustAddress(c.address || \'\');\n    setCustLimit(c.creditLimit);\n    setCustApproved(c.isApproved);\n    setCustNotes(c.notes || \'\');\n    setIsCustomerModalOpen(true);\n  };\n\n  const handleSaveCustomerForm = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!custName.trim()) {\n      alert(\'Please enter a customer name.\');\n      return;\n    }\n\n    const target = editingCustId ? customers.find((c) => c.id === editingCustId) : null;\n\n    const newCustomer: CustomerCredit = {\n      id: editingCustId || \'c-\' + Date.now(),\n      name: custName.trim(),\n      contact: custContact.trim(),\n      address: custAddress.trim() || undefined,\n      creditLimit: custLimit,\n      currentDebt: target ? target.currentDebt : 0,\n      isApproved: custApproved,\n      notes: custNotes.trim() || undefined,\n      updatedAt: new Date().toISOString(),\n    };\n\n    onSaveCustomer(newCustomer);\n    setIsCustomerModalOpen(false);\n  };\n\n  const handleOpenPaymentModal = (c: CustomerCredit) => {\n    setSelectedCustomer(c);\n    setPayAmount(c.currentDebt);\n    setPayNotes(\'Cash payment received\');\n    setIsPaymentModalOpen(true);\n  };\n\n  const handleExecutePayment = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!selectedCustomer) return;\n    if (payAmount <= 0) {\n      alert(\'Payment amount must be greater than zero.\');\n      return;\n    }\n\n    onRecordPayment(selectedCustomer.id, payAmount, receivedBy, payNotes);\n    setIsPaymentModalOpen(false);\n    alert(`Payment of \342\202\261${payAmount.toFixed(2)} recorded for ${selectedCustomer.name}!`);\n  };\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6\">\n      \n      {/* Top Banner */}\n      {!isOwner && (\n        <div className=\"bg-emerald-50 border border-emerald-200 rounded-xl p-3 text-xs text-emerald-900 font-semibold flex items-center justify-between shadow-2xs\">\n          <div className=\"flex items-center space-x-2\">\n            <CheckCircle2 className=\"w-4 h-4 text-emerald-700 shrink-0\" />\n            <span>\n              <strong>Employee Access:</strong> You can view suki credit accounts, record cash repayments, and inspect account payment history. Adding new accounts or modifying credit limits requires an Owner account.\n            </span>\n          </div>\n          <span className=\"bg-emerald-100 text-emerald-800 text-[10px] font-bold px-2 py-0.5 rounded border border-emerald-300 shrink-0\">\n            Payments Enabled\n          </span>\n        </div>\n      )}\n\n      <div className=\"bg-white rounded-xl shadow-sm border border-slate-200 p-4 flex flex-col md:flex-row items-center justify-between gap-4\">\n        <div>\n          <h2 className=\"text-xl font-bold text-slate-900 flex items-center gap-2\">\n            <BookOpen className=\"w-5 h-5 text-orange-600\" />\n            Digital Customer Credit Ledger (\"Listahan\")\n          </h2>\n          <p className=\"text-xs text-slate-500 mt-0.5\">\n            Replaces paper notebook tracking for suki customers with authorized credit limits & payment collection\n          </p>\n        </div>\n\n        {/* Total Utang Balance Card */}\n        <div className=\"flex items-center space-x-3 bg-orange-50 border border-orange-200 p-3 rounded-xl w-full md:w-auto\">\n          <div>\n            <span className=\"text-[10px] text-orange-800 font-bold uppercase tracking-wider block\">\n              Total Suki Outstanding Debt\n            </span>\n            <span className=\"text-2xl font-black text-orange-600\">\n              \342\202\261{totalOutstandingUtang.toFixed(2)}\n            </span>\n          </div>\n          {isOwner ? (\n            <button\n              onClick={handleOpenAddCustomer}\n              className=\"ml-auto px-3 py-2 bg-orange-600 hover:bg-orange-700 text-white font-bold rounded-lg text-xs flex items-center gap-1 shadow-xs transition cursor-pointer\"\n            >\n              <UserPlus className=\"w-4 h-4\" />\n              <span>Add Suki</span>\n            </button>\n          ) : (\n            <div className=\"ml-auto px-2.5 py-1.5 bg-slate-100 border border-slate-200 text-slate-500 text-[11px] font-bold rounded-lg flex items-center gap-1\">\n              <Lock className=\"w-3.5 h-3.5\" />\n              <span>Owner Management Only</span>\n            </div>\n          )}\n        </div>\n      </div>\n\n      {/* Search Bar */}\n      <div className=\"bg-white rounded-xl shadow-sm border border-slate-200 p-3.5\">\n        <div className=\"relative max-w-md\">\n          <Search className=\"w-4 h-4 absolute left-3 top-2.5 text-slate-400\" />\n          <input\n            type=\"text\"\n            placeholder=\"Search Suki by name or phone number...\"\n            value={searchQuery}\n            onChange={(e) => setSearchQuery(e.target.value)}\n            className=\"w-full pl-9 pr-3 py-1.5 text-sm bg-slate-50 border border-slate-200 rounded-lg focus:ring-2 focus:ring-orange-500 text-slate-800\"\n          />\n        </div>\n      </div>\n\n      {/* Customer Credit Directory Cards */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n        {filteredCustomers.map((c) => {\n          const isAtRisk = c.currentDebt >= c.creditLimit * 0.85;\n          const usagePercent = Math.min(100, Math.round((c.currentDebt / c.creditLimit) * 100));\n\n          return (\n            <div\n              key={c.id}\n              className={`bg-white rounded-xl border p-4 shadow-sm transition flex flex-col justify-between ${\n                isAtRisk ? \'border-amber-300 bg-amber-50/10\' : \'border-slate-200 hover:border-orange-300\'\n              }`}\n            >\n              <div className=\"space-y-3\">\n                <div className=\"flex items-start justify-between\">\n                  <div>\n                    <h3 className=\"font-bold text-slate-900 text-base flex items-center gap-1.5\">\n                      <span>{c.name}</span>\n                      {!c.isApproved && (\n                        <span className=\"bg-red-100 text-red-800 text-[9px] font-black px-1.5 py-0.2 rounded uppercase\">\n                          SUSPENDED\n                        </span>\n                      )}\n                    </h3>\n                    <p className=\"text-xs text-slate-500 flex items-center gap-1 mt-0.5\">\n                      <Phone className=\"w-3 h-3 text-slate-400\" />\n                      <span>{c.contact}</span>\n                    </p>\n                  </div>\n\n                  {isOwner && (\n                    <button\n                      onClick={() => handleOpenEditCustomer(c)}\n                      className=\"p-1 text-slate-400 hover:text-slate-700 hover:bg-slate-100 rounded-lg transition cursor-pointer\"\n                      title=\"Edit Customer Details\"\n                    >\n                      <Edit className=\"w-4 h-4\" />\n                    </button>\n                  )}\n                </div>\n\n                {c.address && (\n                  <p className=\"text-xs text-slate-500 flex items-center gap-1\">\n                    <MapPin className=\"w-3 h-3 text-slate-400\" />\n                    <span>{c.address}</span>\n                  </p>\n                )}\n\n                {/* Debt & Limit Meter */}\n                <div className=\"bg-slate-50 p-3 rounded-xl border border-slate-200 space-y-1.5\">\n                  <div className=\"flex justify-between text-xs\">\n                    <span className=\"text-slate-500 font-medium\">Unsettled Balance:</span>\n                    <span className=\"font-black text-slate-900\">\342\202\261{c.currentDebt.toFixed(2)}</span>\n                  </div>\n\n                  <div className=\"flex justify-between text-xs\">\n                    <span className=\"text-slate-500 font-medium\">Approved Credit Limit:</span>\n                    <span className=\"font-bold text-slate-700\">\342\202\261{c.creditLimit.toFixed(2)}</span>\n                  </div>\n\n                  {/* Progress Bar */}\n                  <div className=\"w-full bg-slate-200 h-2 rounded-full overflow-hidden mt-1\">\n                    <div\n                      className={`h-full transition-all ${\n                        usagePercent >= 90\n                          ? \'bg-red-600\'\n                          : usagePercent >= 70\n                          ? \'bg-amber-500\'\n                          : \'bg-emerald-500\'\n                      }`}\n                      style={{ width: `${usagePercent}%` }}\n                    />\n                  </div>\n                </div>\n\n                {c.notes && (\n                  <p className=\"text-[11px] text-slate-500 bg-slate-50 p-2 rounded-lg italic\">\n                    \"{c.notes}\"\n                  </p>\n                )}\n              </div>\n\n              {/* Action - Available to both Owner and Employee */}\n              <div className=\"pt-3 mt-3 border-t border-slate-100 flex items-center gap-2\">\n                <button\n                  disabled={c.currentDebt <= 0}\n                  onClick={() => handleOpenPaymentModal(c)}\n                  className=\"flex-1 py-2 bg-emerald-600 hover:bg-emerald-700 disabled:bg-slate-200 disabled:text-slate-400 text-white font-bold rounded-lg text-xs flex items-center justify-center space-x-1 shadow-xs transition cursor-pointer\"\n                >\n                  <DollarSign className=\"w-4 h-4\" />\n                  <span>Record Cash Payment</span>\n                </button>\n                <button\n                  onClick={() => setCustomerHistoryModal(c)}\n                  className=\"px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded-lg text-xs flex items-center justify-center space-x-1 transition cursor-pointer\"\n                  title=\"View Account Payment History\"\n                >\n                  <History className=\"w-3.5 h-3.5 text-orange-600\" />\n                  <span className=\"hidden sm:inline\">History</span>\n                </button>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n\n      {/* NEW DEDICATED SECTION: HISTORY OF EACH ACCOUNT\'S CREDIT PAYMENT */}\n      <div className=\"bg-white rounded-xl shadow-sm border border-slate-200 p-5 space-y-4\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-3\">\n          <div>\n            <h3 className=\"font-bold text-base text-slate-900 flex items-center gap-2\">\n              <History className=\"w-5 h-5 text-orange-600\" />\n              Suki Account Credit Payment History\n            </h3>\n            <p className=\"text-xs text-slate-500 mt-0.5\">\n              Detailed audit trail of all cash repayments collected per customer account\n            </p>\n          </div>\n\n          {/* Account Filter Selector */}\n          <div className=\"flex items-center space-x-2 shrink-0\">\n            <Filter className=\"w-4 h-4 text-slate-400\" />\n            <select\n              value={historyCustomerFilter}\n              onChange={(e) => setHistoryCustomerFilter(e.target.value)}\n              className=\"bg-slate-50 border border-slate-200 text-slate-800 text-xs font-bold px-3 py-1.5 rounded-lg focus:ring-2 focus:ring-orange-500 focus:outline-none\"\n            >\n              <option value=\"ALL\">All Suki Accounts ({debtPayments.length} Payments)</option>\n              {customers.map((c) => (\n                <option key={c.id} value={c.id}>\n                  {c.name}\n                </option>\n              ))}\n            </select>\n          </div>\n        </div>\n\n        {/* Payment History Metrics Summary */}\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3\">\n          <div className=\"bg-emerald-50/60 border border-emerald-200 rounded-xl p-3 flex items-center justify-between\">\n            <div>\n              <span className=\"text-[10px] font-bold text-emerald-800 uppercase tracking-wider block\">\n                Total Repayments Collected\n              </span>\n              <span className=\"text-xl font-black text-emerald-700\">\n                \342\202\261{totalCollectedInFilter.toFixed(2)}\n              </span>\n            </div>\n            <div className=\"w-8 h-8 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-xs\">\n              \342\202\261\n            </div>\n          </div>\n\n          <div className=\"bg-slate-50 border border-slate-200 rounded-xl p-3 flex items-center justify-between\">\n            <div>\n              <span className=\"text-[10px] font-bold text-slate-500 uppercase tracking-wider block\">\n                Total Repayment Entries\n              </span>\n              <span className=\"text-xl font-black text-slate-800\">\n                {filteredDebtPayments.length} Logs\n              </span>\n            </div>\n            <div className=\"w-8 h-8 rounded-full bg-slate-200 text-slate-700 flex items-center justify-center font-bold text-xs\">\n              #\n            </div>\n          </div>\n        </div>\n\n        {/* Detailed Payment Audit Logs Table */}\n        <div className=\"border border-slate-200 rounded-xl overflow-hidden divide-y divide-slate-100 text-xs\">\n          {filteredDebtPayments.length === 0 ? (\n            <div className=\"p-8 text-center text-slate-400 font-medium\">\n              <History className=\"w-8 h-8 mx-auto mb-2 text-slate-300\" />\n              <p>No cash repayments recorded for this filter selection.</p>\n            </div>\n          ) : (\n            filteredDebtPayments.map((p) => (\n              <div key={p.id} className=\"p-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-2 bg-white hover:bg-slate-50/80 transition\">\n                <div className=\"flex items-start space-x-3\">\n                  <div className=\"w-8 h-8 rounded-lg bg-emerald-100 text-emerald-800 flex items-center justify-center shrink-0 font-bold\">\n                    <CheckCircle2 className=\"w-4 h-4 text-emerald-600\" />\n                  </div>\n                  <div>\n                    <div className=\"flex items-center space-x-2\">\n                      <span className=\"font-bold text-slate-900 text-sm\">{p.customerName}</span>\n                      <span className=\"bg-emerald-100 text-emerald-800 text-[10px] font-extrabold px-2 py-0.5 rounded-full\">\n                        CASH\n                      </span>\n                    </div>\n                    <div className=\"text-slate-500 text-[11px] flex items-center gap-2 mt-0.5\">\n                      <span className=\"flex items-center gap-1\">\n                        <UserCheck className=\"w-3 h-3 text-slate-400\" />\n                        Received by <strong className=\"text-slate-700\">{p.receivedBy}</strong>\n                      </span>\n                      <span>\342\200\242</span>\n                      <span>{new Date(p.timestamp).toLocaleString()}</span>\n                    </div>\n                    {p.notes && (\n                      <p className=\"text-[11px] text-slate-500 italic mt-1 bg-slate-50 p-1.5 rounded\">\n                        \"{p.notes}\"\n                      </p>\n                    )}\n                  </div>\n                </div>\n\n                <div className=\"text-right shrink-0\">\n                  <span className=\"font-black text-emerald-600 text-base block\">+\342\202\261{p.amount.toFixed(2)}</span>\n                  <span className=\"text-slate-400 text-[10px] font-mono\">Ref #{p.id.slice(-6)}</span>\n                </div>\n              </div>\n            ))\n          )}\n        </div>\n      </div>\n\n      {/* INDIVIDUAL CUSTOMER HISTORY MODAL */}\n      {customerHistoryModal && (\n        <div className=\"fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 flex items-center justify-center p-4\">\n          <div className=\"bg-white rounded-2xl shadow-xl max-w-lg w-full p-5 space-y-4 border border-slate-200\">\n            <div className=\"flex items-center justify-between border-b border-slate-100 pb-3\">\n              <div>\n                <h3 className=\"font-bold text-base text-slate-900 flex items-center gap-2\">\n                  <History className=\"w-5 h-5 text-orange-600\" />\n                  Payment History: {customerHistoryModal.name}\n                </h3>\n                <p className=\"text-xs text-slate-500 mt-0.5\">\n                  Contact: {customerHistoryModal.contact} \342\200\242 Current Debt: \342\202\261{customerHistoryModal.currentDebt.toFixed(2)}\n                </p>\n              </div>\n              <button\n                onClick={() => setCustomerHistoryModal(null)}\n                className=\"p-1 hover:bg-slate-100 rounded-lg text-slate-400 hover:text-slate-600 transition\"\n              >\n                <X className=\"w-5 h-5\" />\n              </button>\n            </div>\n\n            <div className=\"space-y-3 max-h-80 overflow-y-auto pr-1\">\n              {debtPayments.filter((p) => p.customerId === customerHistoryModal.id).length === 0 ? (\n                <p className=\"p-4 text-center text-slate-400 text-xs font-medium\">\n                  No payment history recorded for {customerHistoryModal.name} yet.\n                </p>\n              ) : (\n                debtPayments\n                  .filter((p) => p.customerId === customerHistoryModal.id)\n                  .map((p) => (\n                    <div key={p.id} className=\"p-3 bg-slate-50 border border-slate-200 rounded-xl flex justify-between items-center text-xs\">\n                      <div>\n                        <span className=\"font-bold text-slate-900 text-sm block\">\342\202\261{p.amount.toFixed(2)} Cash Repayment</span>\n                        <span className=\"text-slate-500 text-[10px] block mt-0.5\">\n                          Received by {p.receivedBy} on {new Date(p.timestamp).toLocaleString()}\n                        </span>\n                        {p.notes && <span className=\"text-slate-500 text-[11px] italic block mt-1\">\"{p.notes}\"</span>}\n                      </div>\n                      <span className=\"bg-emerald-100 text-emerald-800 font-bold px-2 py-1 rounded-lg text-[10px]\">\n                        COMPLETED\n                      </span>\n                    </div>\n                  ))\n              )}\n            </div>\n\n            <div className=\"pt-3 border-t border-slate-100 flex justify-end\">\n              <button\n                onClick={() => setCustomerHistoryModal(null)}\n                className=\"px-4 py-2 bg-slate-800 hover:bg-slate-900 text-white font-bold text-xs rounded-xl cursor-pointer\"\n              >\n                Close History\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* Add / Edit Suki Modal */}\n      {isCustomerModalOpen && (\n        <div className=\"fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 flex items-center justify-center p-4\">\n          <form\n            onSubmit={handleSaveCustomerForm}\n            className=\"bg-white rounded-2xl shadow-xl max-w-md w-full p-5 space-y-4 border border-slate-200\"\n          >\n            <h3 className=\"font-bold text-base text-slate-900 border-b border-slate-100 pb-2\">\n              {editingCustId ? \'Edit Suki Account\' : \'Register New Suki Customer\'}\n            </h3>\n\n            <div className=\"space-y-3\">\n              <div>\n                <label className=\"block text-xs font-bold text-slate-700 mb-1\">\n                  Customer Name *\n                </label>\n                <input\n                  type=\"text\"\n                  required\n                  placeholder=\"e.g. Kapitan Mang Berting\"\n                  value={custName}\n                  onChange={(e) => setCustName(e.target.value)}\n                  className=\"w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:outline-none\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-bold text-slate-700 mb-1\">\n                  Contact Number\n                </label>\n                <input\n                  type=\"text\"\n                  placeholder=\"e.g. 0917-555-1234\"\n                  value={custContact}\n                  onChange={(e) => setCustContact(e.target.value)}\n                  className=\"w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:outline-none\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-bold text-slate-700 mb-1\">\n                  Barangay / Address\n                </label>\n                <input\n                  type=\"text\"\n                  placeholder=\"e.g. Brgy. San Roque, Marikina\"\n                  value={custAddress}\n                  onChange={(e) => setCustAddress(e.target.value)}\n                  className=\"w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:outline-none\"\n                />\n              </div>\n\n              <div className=\"grid grid-cols-2 gap-3\">\n                <div>\n                  <label className=\"block text-xs font-bold text-slate-700 mb-1\">\n                    Credit Limit (\342\202\261)\n                  </label>\n                  <input\n                    type=\"number\"\n                    min=\"100\"\n                    step=\"100\"\n                    value={custLimit}\n                    onChange={(e) => setCustLimit(parseFloat(e.target.value) || 0)}\n                    className=\"w-full px-3 py-2 text-sm font-bold border border-slate-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:outline-none\"\n                  />\n                </div>\n\n                <div className=\"flex items-center pt-5\">\n                  <label className=\"flex items-center space-x-2 text-xs font-bold text-slate-700 cursor-pointer\">\n                    <input\n                      type=\"checkbox\"\n                      checked={custApproved}\n                      onChange={(e) => setCustApproved(e.target.checked)}\n                      className=\"w-4 h-4 text-orange-600 rounded\"\n                    />\n                    <span>Approved for Credit</span>\n                  </label>\n                </div>\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-bold text-slate-700 mb-1\">\n                  Operational Notes\n                </label>\n                <textarea\n                  rows={2}\n                  placeholder=\"e.g. Barangay official. Pays every Friday.\"\n                  value={custNotes}\n                  onChange={(e) => setCustNotes(e.target.value)}\n                  className=\"w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-orange-500\"\n                />\n              </div>\n            </div>\n\n            <div className=\"flex items-center justify-end space-x-2 pt-3 border-t border-slate-100\">\n              <button\n                type=\"button\"\n                onClick={() => setIsCustomerModalOpen(false)}\n                className=\"px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded-lg\"\n              >\n                Cancel\n              </button>\n              <button\n                type=\"submit\"\n                className=\"px-5 py-2 text-xs font-bold bg-orange-600 hover:bg-orange-700 text-white rounded-lg shadow-sm\"\n              >\n                Save Suki Account\n              </button>\n            </div>\n          </form>\n        </div>\n      )}\n\n      {/* Record Payment Modal */}\n      {isPaymentModalOpen && selectedCustomer && (\n        <div className=\"fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 flex items-center justify-center p-4\">\n          <form\n            onSubmit={handleExecutePayment}\n            className=\"bg-white rounded-2xl shadow-xl max-w-md w-full p-5 space-y-4 border border-slate-200\"\n          >\n            <h3 className=\"font-bold text-base text-slate-900 border-b border-slate-100 pb-2\">\n              Record Cash Repayment - {selectedCustomer.name}\n            </h3>\n\n            <div className=\"bg-slate-50 p-3 rounded-xl border border-slate-200 text-xs space-y-1\">\n              <div className=\"flex justify-between\">\n                <span>Current Debt Balance:</span>\n                <span className=\"font-black text-slate-900\">\342\202\261{selectedCustomer.currentDebt.toFixed(2)}</span>\n              </div>\n            </div>\n\n            <div className=\"space-y-3\">\n              <div>\n                <label className=\"block text-xs font-bold text-slate-700 mb-1\">\n                  Cash Amount Received (\342\202\261) *\n                </label>\n                <input\n                  type=\"number\"\n                  min=\"1\"\n                  max={selectedCustomer.currentDebt}\n                  required\n                  value={payAmount}\n                  onChange={(e) => setPayAmount(parseFloat(e.target.value) || 0)}\n                  className=\"w-full text-xl font-black text-emerald-700 px-3 py-2 border border-slate-300 rounded-xl focus:ring-2 focus:ring-emerald-500\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-bold text-slate-700 mb-1\">\n                  Payment Notes / Receipt Ref\n                </label>\n                <input\n                  type=\"text\"\n                  value={payNotes}\n                  onChange={(e) => setPayNotes(e.target.value)}\n                  className=\"w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-orange-500\"\n                />\n              </div>\n            </div>\n\n            <div className=\"flex items-center justify-end space-x-2 pt-3 border-t border-slate-100\">\n              <button\n                type=\"button\"\n                onClick={() => setIsPaymentModalOpen(false)}\n                className=\"px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded-lg\"\n              >\n                Cancel\n              </button>\n              <button\n                type=\"submit\"\n                className=\"px-5 py-2 text-xs font-bold bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg shadow-sm\"\n              >\n                Record Payment\n              </button>\n            </div>\n          </form>\n        </div>\n      )}\n\n    </div>\n  );\n};"
      }
      num_matches: 1
    }
  }
}
