          text: "      quarter2Gross: q2,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      quarter3Gross: q3,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      quarter4Gross: q4,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
