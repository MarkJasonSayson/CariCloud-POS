        }
        lines {
          text: "                type=\"submit\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                className=\"px-5 py-2.5 text-xs font-extrabold bg-emerald-600 hover:bg-emerald-700 text-white rounded-full shadow-xs cursor-pointer\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              >"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
