    instruction: "Allow Employee to view Listahan tab while restricting editing/payment actions to Store Owner"
    replacement_infos {
      original_chunk {
        target_content: "import React, { useState } from \'react\';\nimport { \n  BookOpen, \n  Plus, \n  Search, \n  DollarSign, \n  AlertTriangle, \n  CheckCircle2, \n  UserPlus, \n  History, \n  Phone, \n  MapPin,\n  ShieldAlert,\n  Edit\n} from \'lucide-react\';\nimport { CustomerCredit, DebtPaymentRecord, Role } from \'../types\';\n\ninterface ListahanModuleProps {\n  customers: CustomerCredit[];\n  debtPayments: DebtPaymentRecord[];\n  onSaveCustomer: (customer: CustomerCredit) => void;\n  onRecordPayment: (customerId: string, amount: number, receivedBy: string, notes?: string) => void;\n  receivedBy: string;\n  currentUserRole?: Role;\n}\n\nexport const ListahanModule: React.FC<ListahanModuleProps> = ({\n  customers,\n  debtPayments,\n  onSaveCustomer,\n  onRecordPayment,\n  receivedBy,\n  currentUserRole = \'ADMIN\',\n}) => {\n  const [searchQuery, setSearchQuery] = useState(\'\');\n\n  // Access Guard: Utang/Listahan ledger is restricted to Store Owner only\n  if (currentUserRole !== \'ADMIN\') {\n    return (\n      <div className=\"max-w-2xl mx-auto my-12 px-4\">\n        <div className=\"bg-white rounded-3xl border border-[#E8E2DD] shadow-xl p-8 text-center space-y-4\">\n          <div className=\"w-16 h-16 rounded-2xl bg-red-50 text-red-600 flex items-center justify-center mx-auto border border-red-200\">\n            <ShieldAlert className=\"w-8 h-8\" />\n          </div>\n          <div className=\"space-y-1\">\n            <span className=\"bg-red-100 text-red-800 text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-wider inline-block\">\n              Owner Security Policy\n            </span>\n            <h2 className=\"text-xl font-extrabold text-[#2D241E]\">\n              Access Restricted: Store Owner Only\n            </h2>\n            <p className=\"text-xs text-[#756D67] max-w-md mx-auto leading-relaxed\">\n              The Listahan (Utang) customer credit ledger contains confidential financial records, debt balances, and customer credit limit approvals. Access is strictly restricted to the Store Owner (Ate Maria).\n            </p>\n          </div>\n          <div className=\"pt-2\">\n            <div className=\"p-3 bg-[#FCFAF7] border border-[#E8E2DD] rounded-xl text-xs text-[#756D67] font-semibold inline-block\">\n              Currently Logged In As: <span className=\"text-[#2D241E] font-bold\">Shift Cashier</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    );\n  }\n  const [selectedCustomer, setSelectedCustomer] = useState<CustomerCredit | null>(null);"
        replacement_content: "import React, { useState } from \'react\';\nimport { \n  BookOpen, \n  Plus, \n  Search, \n  DollarSign, \n  AlertTriangle, \n  CheckCircle2, \n  UserPlus, \n  History, \n  Phone, \n  MapPin,\n  ShieldAlert,\n  Edit,\n  Eye,\n  Lock\n} from \'lucide-react\';\nimport { CustomerCredit, DebtPaymentRecord, Role } from \'../types\';\n\ninterface ListahanModuleProps {\n  customers: CustomerCredit[];\n  debtPayments: DebtPaymentRecord[];\n  onSaveCustomer: (customer: CustomerCredit) => void;\n  onRecordPayment: (customerId: string, amount: number, receivedBy: string, notes?: string) => void;\n  receivedBy: string;\n  currentUserRole?: Role;\n}\n\nexport const ListahanModule: React.FC<ListahanModuleProps> = ({\n  customers,\n  debtPayments,\n  onSaveCustomer,\n  onRecordPayment,\n  receivedBy,\n  currentUserRole = \'ADMIN\',\n}) => {\n  const isOwner = currentUserRole === \'ADMIN\';\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  const [selectedCustomer, setSelectedCustomer] = useState<CustomerCredit | null>(null);"
      }
      num_matches: 1
    }
  }
