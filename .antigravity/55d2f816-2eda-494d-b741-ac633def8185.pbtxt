        target_content: "      {/* Top Banner */}\n      <div className=\"bg-white rounded-xl shadow-sm border border-slate-200 p-4 flex flex-col md:flex-row items-center justify-between gap-4\">\n        <div>\n          <h2 className=\"text-xl font-bold text-slate-900 flex items-center gap-2\">\n            <BookOpen className=\"w-5 h-5 text-orange-600\" />\n            Digital Customer Credit Ledger (\"Listahan\")\n          </h2>\n          <p className=\"text-xs text-slate-500 mt-0.5\">\n            Replaces paper notebook tracking for suki customers with authorized credit limits & payment collection\n          </p>\n        </div>\n\n        {/* Total Utang Balance Card */}\n        <div className=\"flex items-center space-x-3 bg-orange-50 border border-orange-200 p-3 rounded-xl w-full md:w-auto\">\n          <div>\n            <span className=\"text-[10px] text-orange-800 font-bold uppercase tracking-wider block\">\n              Total Suki Outstanding Debt\n            </span>\n            <span className=\"text-2xl font-black text-orange-600\">\n              \342\202\261{totalOutstandingUtang.toFixed(2)}\n            </span>\n          </div>\n          <button\n            onClick={handleOpenAddCustomer}\n            className=\"ml-auto px-3 py-2 bg-orange-600 hover:bg-orange-700 text-white font-bold rounded-lg text-xs flex items-center gap-1 shadow-xs transition\"\n          >\n            <UserPlus className=\"w-4 h-4\" />\n            <span>Add Suki</span>\n          </button>\n        </div>\n      </div>"
        replacement_content: "      {/* Top Banner */}\n      {!isOwner && (\n        <div className=\"bg-amber-50 border border-amber-200 rounded-xl p-3 text-xs text-amber-900 font-semibold flex items-center justify-between shadow-2xs\">\n          <div className=\"flex items-center space-x-2\">\n            <Eye className=\"w-4 h-4 text-amber-700 shrink-0\" />\n            <span>\n              <strong>Employee View Mode:</strong> You can view customer credit limits, current debts, and payment history. Adding customers, collecting payments, or modifying limits requires Owner account.\n            </span>\n          </div>\n          <span className=\"bg-amber-100 text-amber-800 text-[10px] font-bold px-2 py-0.5 rounded border border-amber-300 shrink-0\">\n            Read-Only Access\n          </span>\n        </div>\n      )}\n\n      <div className=\"bg-white rounded-xl shadow-sm border border-slate-200 p-4 flex flex-col md:flex-row items-center justify-between gap-4\">\n        <div>\n          <h2 className=\"text-xl font-bold text-slate-900 flex items-center gap-2\">\n            <BookOpen className=\"w-5 h-5 text-orange-600\" />\n            Digital Customer Credit Ledger (\"Listahan\")\n          </h2>\n          <p className=\"text-xs text-slate-500 mt-0.5\">\n            Replaces paper notebook tracking for suki customers with authorized credit limits & payment collection\n          </p>\n        </div>\n\n        {/* Total Utang Balance Card */}\n        <div className=\"flex items-center space-x-3 bg-orange-50 border border-orange-200 p-3 rounded-xl w-full md:w-auto\">\n          <div>\n            <span className=\"text-[10px] text-orange-800 font-bold uppercase tracking-wider block\">\n              Total Suki Outstanding Debt\n            </span>\n            <span className=\"text-2xl font-black text-orange-600\">\n              \342\202\261{totalOutstandingUtang.toFixed(2)}\n            </span>\n          </div>\n          {isOwner ? (\n            <button\n              onClick={handleOpenAddCustomer}\n              className=\"ml-auto px-3 py-2 bg-orange-600 hover:bg-orange-700 text-white font-bold rounded-lg text-xs flex items-center gap-1 shadow-xs transition cursor-pointer\"\n            >\n              <UserPlus className=\"w-4 h-4\" />\n              <span>Add Suki</span>\n            </button>\n          ) : (\n            <div className=\"ml-auto px-2.5 py-1.5 bg-slate-100 border border-slate-200 text-slate-500 text-[11px] font-bold rounded-lg flex items-center gap-1\">\n              <Lock className=\"w-3.5 h-3.5\" />\n              <span>Owner Action</span>\n            </div>\n          )}\n        </div>\n      </div>"
      }
