      replacement_content: "import React from \'react\';\nimport { \n  Store, \n  Wifi, \n  WifiOff, \n  RefreshCw, \n  UserCheck, \n  ShieldAlert, \n  Sparkles, \n  Palette, \n  SlidersHorizontal,\n  ChevronDown\n} from \'lucide-react\';\nimport { StoreSettings, UserProfile, Role } from \'../types\';\n\ninterface HeaderProps {\n  settings: StoreSettings;\n  currentUser: UserProfile;\n  isOnline: boolean;\n  pendingSyncCount: number;\n  onSyncTrigger: () => void;\n  onSwitchUser: () => void;\n  activeTab: string;\n  setActiveTab: (tab: string) => void;\n}\n\nexport const Header: React.FC<HeaderProps> = ({\n  settings,\n  currentUser,\n  isOnline,\n  pendingSyncCount,\n  onSyncTrigger,\n  onSwitchUser,\n  activeTab,\n  setActiveTab,\n}) => {\n  const getThemeClass = () => {\n    switch (settings.themeColor) {\n      case \'amber\':\n        return \'from-amber-700 to-amber-600\';\n      case \'emerald\':\n        return \'from-emerald-700 to-emerald-600\';\n      case \'slate\':\n        return \'from-slate-800 to-slate-700\';\n      case \'orange\':\n      default:\n        return \'from-orange-700 to-orange-600\';\n    }\n  };\n\n  const navItems = [\n    { id: \'pos\', label: \'POS Counter\', badge: null },\n    { id: \'menu\', label: \'Menu & Stock\', badge: null },\n    { id: \'listahan\', label: \'Listahan (Utang)\', badge: null },\n    { id: \'eod\', label: \'EOD Audit\', badge: null },\n    { \n      id: \'bplo\', \n      label: \'Marikina Tax Relief\', \n      tierLock: settings.activeTier < 3 ? \'Tier 3\' : null \n    },\n    { id: \'subscription\', label: \'Plans (SaaS)\', badge: \'\342\202\26149-\342\202\261199\' },\n    { id: \'settings\', label: \'Settings\', badge: null },\n  ];\n\n  return (\n    <header className=\"bg-slate-900 text-white shadow-md border-b border-slate-800 sticky top-0 z-30\">\n      {/* Top Utility Bar */}\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2.5 flex flex-wrap items-center justify-between gap-3 text-xs border-b border-slate-800/80\">\n        \n        {/* Brand Identity */}\n        <div className=\"flex items-center space-x-3\">\n          <div className={`w-9 h-9 rounded-lg bg-gradient-to-br ${getThemeClass()} flex items-center justify-center text-white font-extrabold text-lg shadow-sm tracking-tight`}>\n            CC\n          </div>\n          <div>\n            <div className=\"flex items-center space-x-2\">\n              <span className=\"font-bold text-sm text-white tracking-wide\">{settings.storeName}</span>\n              <span className=\"bg-orange-500/20 text-orange-300 border border-orange-500/30 px-2 py-0.5 rounded text-[10px] font-medium uppercase tracking-wider\">\n                Marikina Carinderia POS\n              </span>\n            </div>\n            <p className=\"text-slate-400 text-[11px] flex items-center gap-1.5 mt-0.5\">\n              <span>{settings.branchName}</span>\n              <span>\342\200\242</span>\n              <span className=\"text-slate-300\">BPLO: {settings.bploPermitNo}</span>\n            </p>\n          </div>\n        </div>\n\n        {/* Operational Status Controls */}\n        <div className=\"flex items-center space-x-3 ml-auto sm:ml-0\">\n          \n          {/* Offline Sync Status Badge */}\n          <div className=\"flex items-center\">\n            {isOnline ? (\n              <span className=\"inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-950 text-emerald-300 border border-emerald-800/60 shadow-sm\">\n                <Wifi className=\"w-3.5 h-3.5 mr-1.5 text-emerald-400\" />\n                Online (Synced)\n              </span>\n            ) : (\n              <button\n                onClick={onSyncTrigger}\n                className=\"inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-amber-950 text-amber-300 border border-amber-800/60 hover:bg-amber-900 transition\"\n                title=\"Click to attempt manual sync with CariCloud Server\"\n              >\n                <WifiOff className=\"w-3.5 h-3.5 mr-1.5 text-amber-400 animate-pulse\" />\n                Offline Mode ({pendingSyncCount} saved to IndexedDB)\n                <RefreshCw className=\"w-3 h-3 ml-1.5 opacity-80\" />\n              </button>\n            )}\n          </div>\n\n          {/* SaaS Tier Badge */}\n          <button \n            onClick={() => setActiveTab(\'subscription\')}\n            className=\"flex items-center space-x-1.5 bg-slate-800 hover:bg-slate-700 border border-slate-700 px-2.5 py-1 rounded-full text-xs text-slate-200 transition\"\n          >\n            <Sparkles className=\"w-3.5 h-3.5 text-amber-400\" />\n            <span className=\"font-semibold text-amber-300\">Tier {settings.activeTier}</span>\n            <span className=\"text-slate-400 hidden md:inline\">\n              ({settings.activeTier === 1 ? \'\342\202\26149 Basic\' : settings.activeTier === 2 ? \'\342\202\26199 Pro\' : \'\342\202\261199 Tax Complete\'})\n            </span>\n          </button>\n\n          {/* User Account & Operator Switcher */}\n          <div className=\"flex items-center space-x-2 border-l border-slate-800 pl-3\">\n            <button\n              onClick={onSwitchUser}\n              className=\"flex items-center space-x-2 bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 px-2.5 py-1 rounded-lg text-xs font-medium transition\"\n            >\n              <UserCheck className=\"w-3.5 h-3.5 text-orange-400\" />\n              <div className=\"text-left\">\n                <div className=\"font-semibold text-slate-100 flex items-center gap-1\">\n                  <span>{currentUser.name}</span>\n                  <ChevronDown className=\"w-3 h-3 opacity-60\" />\n                </div>\n                <div className=\"text-[10px] text-slate-400\">\n                  {currentUser.role === \'ADMIN\' ? \'Owner / Admin\' : \'Cashier Staff\'}\n                </div>\n              </div>\n            </button>\n          </div>\n\n        </div>\n\n      </div>\n\n      {/* Primary Navigation Tabs */}\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <nav className=\"flex space-x-1 overflow-x-auto py-2 scrollbar-none\">\n          {navItems.map((item) => {\n            const isActive = activeTab === item.id;\n            return (\n              <button\n                key={item.id}\n                onClick={() => setActiveTab(item.id)}\n                className={`flex items-center space-x-2 px-3.5 py-2 rounded-lg text-xs font-semibold whitespace-nowrap transition-all duration-150 ${\n                  isActive\n                    ? \'bg-orange-600 text-white shadow-sm font-bold\'\n                    : \'text-slate-300 hover:text-white hover:bg-slate-800/80\'\n                }`}\n              >\n                <span>{item.label}</span>\n                {item.tierLock && (\n                  <span className=\"bg-amber-500/20 text-amber-300 border border-amber-500/40 text-[9px] px-1.5 py-0.2 rounded font-mono\">\n                    {item.tierLock}\n                  </span>\n                )}\n                {item.badge && !item.tierLock && (\n                  <span className=\"bg-slate-800 text-slate-300 text-[9px] px-1.5 py-0.2 rounded font-mono\">\n                    {item.badge}\n                  </span>\n                )}\n              </button>\n            );\n          })}\n        </nav>\n      </div>\n    </header>\n  );\n};\n"
    }
