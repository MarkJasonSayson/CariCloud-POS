  file_change {
    absolute_path_uri: "file:///src/components/LoginLandingPage.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  Building2, \n  UserCheck, \n  ShieldCheck, \n  Lock, \n  ArrowRight, \n  Store, \n  Utensils, \n  KeyRound, \n  AlertCircle,\n  Receipt,\n  Edit3,\n  Check\n} from \'lucide-react\';\nimport { UserProfile, Role, StoreSettings } from \'../types\';\n\ninterface LoginLandingPageProps {\n  settings: StoreSettings;\n  onLoginSuccess: (user: UserProfile) => void;\n}\n\nexport const LoginLandingPage: React.FC<LoginLandingPageProps> = ({\n  settings,\n  onLoginSuccess,\n}) => {\n  const [selectedRole, setSelectedRole] = useState<Role | null>(null);\n  const [pinInput, setPinInput] = useState<string>(\'\');\n  const [errorMsg, setErrorMsg] = useState<string>(\'\');\n\n  const handleSelectRole = (role: Role) => {\n    setSelectedRole(role);\n    setPinInput(\'\');\n    setErrorMsg(\'\');\n  };\n\n  const handleAuthenticate = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!selectedRole) return;\n\n    const expectedPin = selectedRole === \'ADMIN\' ? settings.adminPin : settings.cashierPin;\n    \n    // Accept matching PIN or default fallback 1234/0000 for convenience\n    const isOwnerValid = selectedRole === \'ADMIN\' && (pinInput === expectedPin || pinInput === \'1234\');\n    const isEmployeeValid = selectedRole === \'CASHIER\' && (pinInput === expectedPin || pinInput === \'0000\');\n\n    if (isOwnerValid) {\n      setErrorMsg(\'\');\n      onLoginSuccess({\n        id: \'u-owner\',\n        name: \'Ate Maria (Owner)\',\n        role: \'ADMIN\',\n        pin: settings.adminPin,\n      });\n    } else if (isEmployeeValid) {\n      setErrorMsg(\'\');\n      onLoginSuccess({\n        id: \'u-cashier\',\n        name: \'Cashier Staff\',\n        role: \'CASHIER\',\n        pin: settings.cashierPin,\n      });\n    } else {\n      setErrorMsg(`Invalid PIN entered for ${selectedRole === \'ADMIN\' ? \'Store Owner\' : \'Employee\'}. Please try again.`);\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#FCFAF7] text-[#2D241E] flex flex-col justify-between p-4 sm:p-6 md:p-10 font-sans selection:bg-[#E65100] selection:text-white\">\n      \n      {/* Top Brand Bar */}\n      <div className=\"max-w-5xl mx-auto w-full flex items-center justify-between pb-6 border-b border-[#E8E2DD]\">\n        <div className=\"flex items-center space-x-3\">\n          <div className=\"w-10 h-10 rounded-xl bg-[#E65100] flex items-center justify-center text-white font-black text-xl shadow-xs\">\n            C\n          </div>\n          <div>\n            <h1 className=\"text-xl font-extrabold tracking-tight text-[#2D241E]\">\n              CariCloud POS\n            </h1>\n            <p className=\"text-xs text-[#756D67] font-medium\">\n              Marikina Carinderia Operating System\n            </p>\n          </div>\n        </div>\n\n        <div className=\"bg-white border border-[#E8E2DD] px-3 py-1.5 rounded-full text-xs text-[#756D67] font-semibold flex items-center gap-2 shadow-2xs\">\n          <Store className=\"w-3.5 h-3.5 text-[#E65100]\" />\n          <span>{settings.storeName} ({settings.branchName})</span>\n        </div>\n      </div>\n\n      {/* Main Login Selection Section */}\n      <div className=\"max-w-4xl mx-auto w-full my-auto py-8 space-y-8\">\n        \n        <div className=\"text-center max-w-2xl mx-auto space-y-2\">\n          <span className=\"bg-[#FFF3E0] text-[#E65100] text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider inline-block border border-[#E8E2DD]\">\n            Access Portal\n          </span>\n          <h2 className=\"text-2xl sm:text-3xl font-black text-[#2D241E] tracking-tight\">\n            Select Account Role to Sign In\n          </h2>\n          <p className=\"text-xs sm:text-sm text-[#756D67]\">\n            Welcome! Please choose whether you are logging in as the Store Owner or an Employee Cashier to open your workspace.\n          </p>\n        </div>\n\n        {/* Role Cards Grid */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n          \n          {/* OWNER CARD */}\n          <div\n            onClick={() => handleSelectRole(\'ADMIN\')}\n            className={`bg-white rounded-2xl border p-6 transition-all cursor-pointer relative flex flex-col justify-between ${\n              selectedRole === \'ADMIN\'\n                ? \'border-[#E65100] shadow-md ring-2 ring-[#E65100]/20 bg-[#FCFAF7]\'\n                : \'border-[#E8E2DD] shadow-2xs hover:border-[#E65100]/60 hover:shadow-xs\'\n            }`}\n          >\n            {selectedRole === \'ADMIN\' && (\n              <div className=\"absolute top-4 right-4 bg-[#E65100] text-white p-1 rounded-full\">\n                <Check className=\"w-4 h-4 stroke-[3]\" />\n              </div>\n            )}\n\n            <div className=\"space-y-4\">\n              <div className=\"w-12 h-12 rounded-xl bg-orange-100 border border-orange-200 flex items-center justify-center text-[#E65100]\">\n                <ShieldCheck className=\"w-6 h-6\" />\n              </div>\n\n              <div>\n                <span className=\"text-[10px] font-bold uppercase tracking-wider text-[#E65100] bg-orange-50 px-2 py-0.5 rounded\">\n                  Full Store Governance\n                </span>\n                <h3 className=\"text-xl font-extrabold text-[#2D241E] mt-1\">\n                  Store Owner (Admin)\n                </h3>\n                <p className=\"text-xs text-[#756D67] mt-1 leading-relaxed\">\n                  Full system control: Edit & digitize daily menu, set prices, access EOD financial reports, Marikina tax relief compliance, & store settings.\n                </p>\n              </div>\n\n              <div className=\"space-y-2 pt-2 border-t border-[#E8E2DD] text-xs text-[#2D241E]\">\n                <div className=\"flex items-center space-x-2\">\n                  <Edit3 className=\"w-3.5 h-3.5 text-[#E65100]\" />\n                  <span>Edit, Add, or Remove Menu Items & Stock</span>\n                </div>\n                <div className=\"flex items-center space-x-2\">\n                  <Receipt className=\"w-3.5 h-3.5 text-[#E65100]\" />\n                  <span>Access Archived Order Receipts & Financials</span>\n                </div>\n                <div className=\"flex items-center space-x-2\">\n                  <Building2 className=\"w-3.5 h-3.5 text-[#E65100]\" />\n                  <span>BPLO Tax Declaration & SaaS Settings</span>\n                </div>\n              </div>\n            </div>\n\n            <div className=\"mt-6 pt-4 border-t border-[#E8E2DD] flex items-center justify-between\">\n              <span className=\"text-xs font-bold text-[#756D67]\">Default PIN: <code className=\"bg-[#FCFAF7] px-2 py-0.5 rounded border font-mono text-[#2D241E]\">1234</code></span>\n              <span className={`text-xs font-bold flex items-center gap-1 ${selectedRole === \'ADMIN\' ? \'text-[#E65100]\' : \'text-[#756D67]\'}`}>\n                <span>Select Owner</span>\n                <ArrowRight className=\"w-4 h-4\" />\n              </span>\n            </div>\n          </div>\n\n          {/* EMPLOYEE CARD */}\n          <div\n            onClick={() => handleSelectRole(\'CASHIER\')}\n            className={`bg-white rounded-2xl border p-6 transition-all cursor-pointer relative flex flex-col justify-between ${\n              selectedRole === \'CASHIER\'\n                ? \'border-[#E65100] shadow-md ring-2 ring-[#E65100]/20 bg-[#FCFAF7]\'\n                : \'border-[#E8E2DD] shadow-2xs hover:border-[#E65100]/60 hover:shadow-xs\'\n            }`}\n          >\n            {selectedRole === \'CASHIER\' && (\n              <div className=\"absolute top-4 right-4 bg-[#E65100] text-white p-1 rounded-full\">\n                <Check className=\"w-4 h-4 stroke-[3]\" />\n              </div>\n            )}\n\n            <div className=\"space-y-4\">\n              <div className=\"w-12 h-12 rounded-xl bg-amber-100 border border-amber-200 flex items-center justify-center text-amber-800\">\n                <Utensils className=\"w-6 h-6\" />\n              </div>\n\n              <div>\n                <span className=\"text-[10px] font-bold uppercase tracking-wider text-amber-800 bg-amber-50 px-2 py-0.5 rounded\">\n                  Order Management Only\n                </span>\n                <h3 className=\"text-xl font-extrabold text-[#2D241E] mt-1\">\n                  Employee (Cashier Staff)\n                </h3>\n                <p className=\"text-xs text-[#756D67] mt-1 leading-relaxed\">\n                  Front-of-house order counter operations: Create orders, process Cash / QR Ph / Listahan payments, and view archived receipts. Cannot edit menu items.\n                </p>\n              </div>\n\n              <div className=\"space-y-2 pt-2 border-t border-[#E8E2DD] text-xs text-[#2D241E]\">\n                <div className=\"flex items-center space-x-2\">\n                  <UserCheck className=\"w-3.5 h-3.5 text-amber-700\" />\n                  <span>3-Tap High-Speed POS Counter Orders</span>\n                </div>\n                <div className=\"flex items-center space-x-2\">\n                  <Receipt className=\"w-3.5 h-3.5 text-amber-700\" />\n                  <span>Access & Reprint Order Receipts Archive</span>\n                </div>\n                <div className=\"flex items-center space-x-2\">\n                  <Lock className=\"w-3.5 h-3.5 text-amber-700\" />\n                  <span className=\"text-[#756D67] italic\">Menu editing disabled for employees</span>\n                </div>\n              </div>\n            </div>\n\n            <div className=\"mt-6 pt-4 border-t border-[#E8E2DD] flex items-center justify-between\">\n              <span className=\"text-xs font-bold text-[#756D67]\">Default PIN: <code className=\"bg-[#FCFAF7] px-2 py-0.5 rounded border font-mono text-[#2D241E]\">0000</code></span>\n              <span className={`text-xs font-bold flex items-center gap-1 ${selectedRole === \'CASHIER\' ? \'text-[#E65100]\' : \'text-[#756D67]\'}`}>\n                <span>Select Employee</span>\n                <ArrowRight className=\"w-4 h-4\" />\n              </span>\n            </div>\n          </div>\n\n        </div>\n\n        {/* PIN Entry Form */}\n        {selectedRole && (\n          <form\n            onSubmit={handleAuthenticate}\n            className=\"bg-white rounded-2xl p-6 border border-[#E8E2DD] shadow-sm max-w-md mx-auto space-y-4 animate-fadeIn\"\n          >\n            <div className=\"text-center space-y-1\">\n              <div className=\"inline-flex items-center justify-center w-8 h-8 rounded-full bg-[#FFF3E0] text-[#E65100] mb-1\">\n                <KeyRound className=\"w-4 h-4\" />\n              </div>\n              <h4 className=\"font-extrabold text-[#2D241E] text-base\">\n                Enter {selectedRole === \'ADMIN\' ? \'Owner\' : \'Employee\'} PIN\n              </h4>\n              <p className=\"text-xs text-[#756D67]\">\n                Enter 4-digit security code to unlock {selectedRole === \'ADMIN\' ? \'Owner Admin\' : \'Employee Cashier\'} workspace\n              </p>\n            </div>\n\n            <div>\n              <input\n                type=\"password\"\n                maxLength={4}\n                autoFocus\n                required\n                placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\"\n                value={pinInput}\n                onChange={(e) => {\n                  setPinInput(e.target.value);\n                  setErrorMsg(\'\');\n                }}\n                className=\"w-full font-mono text-center tracking-widest font-black text-3xl px-4 py-3 border border-[#E8E2DD] rounded-xl focus:ring-2 focus:ring-[#E65100] focus:outline-none text-[#2D241E]\"\n              />\n            </div>\n\n            {errorMsg && (\n              <div className=\"p-2.5 bg-red-50 border border-red-200 rounded-xl text-xs font-bold text-red-700 flex items-center justify-center gap-1.5\">\n                <AlertCircle className=\"w-4 h-4 shrink-0\" />\n                <span>{errorMsg}</span>\n              </div>\n            )}\n\n            <button\n              type=\"submit\"\n              className=\"w-full py-3.5 bg-[#E65100] hover:bg-[#BF360C] text-white font-extrabold rounded-xl text-sm shadow-xs transition cursor-pointer flex items-center justify-center space-x-2\"\n            >\n              <span>SIGN IN TO WORKSPACE</span>\n              <ArrowRight className=\"w-4 h-4\" />\n            </button>\n          </form>\n        )}\n\n      </div>\n\n      {/* Footer info */}\n      <div className=\"max-w-5xl mx-auto w-full text-center text-xs text-[#756D67] pt-6 border-t border-[#E8E2DD]\">\n        <p className=\"font-semibold\">CariCloud POS System \342\200\242 Marikina City SME Ordinance No. 2026-018 Compliant</p>\n      </div>\n\n    </div>\n  );\n};\n"
    }
