          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      (tx.customerName && tx.customerName.toLowerCase().includes(searchQuery.toLowerCase())) ||"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      tx.items.some((i) => i.menuItem.name.toLowerCase().includes(searchQuery.toLowerCase()));"
