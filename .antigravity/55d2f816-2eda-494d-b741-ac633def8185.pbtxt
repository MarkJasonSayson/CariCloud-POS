        }
        lines {
          text: "                type=\"submit\""
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                className=\"px-5 py-2 text-xs font-bold bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg shadow-sm\""
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                className=\"px-4 py-2 text-xs font-bold text-slate-500 hover:text-slate-800 cursor-pointer\""
