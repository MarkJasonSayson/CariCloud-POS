    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { Printer, CheckCircle, X, Store, Award } from \'lucide-react\';\nimport { Transaction, StoreSettings } from \'../types\';\n\ninterface ReceiptModalProps {\n  transaction: Transaction | null;\n  settings: StoreSettings;\n  onClose: () => void;\n}\n\nexport const ReceiptModal: React.FC<ReceiptModalProps> = ({\n  transaction,\n  settings,\n  onClose,\n}) => {\n  if (!transaction) return null;\n\n  const handlePrint = () => {\n    window.print();\n  };\n\n  return (\n    <div className=\"fixed inset-0 bg-slate-900/70 backdrop-blur-xs z-50 flex items-center justify-center p-4\">\n      <div className=\"bg-white rounded-2xl shadow-2xl max-w-md w-full border border-slate-200 overflow-hidden flex flex-col max-h-[90vh]\">\n        \n        {/* Modal Bar */}\n        <div className=\"p-3.5 bg-slate-900 text-white flex items-center justify-between\">\n          <div className=\"flex items-center space-x-2\">\n            <CheckCircle className=\"w-5 h-5 text-emerald-400\" />\n            <span className=\"font-bold text-sm\">Transaction Complete!</span>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-1 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Receipt Printable Container */}\n        <div className=\"p-6 overflow-y-auto font-mono text-slate-800 text-xs space-y-4 bg-slate-50/50\" id=\"printable-receipt\">\n          \n          {/* Header */}\n          <div className=\"text-center space-y-1 pb-3 border-b border-dashed border-slate-300\">\n            <h2 className=\"font-sans font-extrabold text-lg text-slate-900 tracking-tight\">\n              {settings.storeName}\n            </h2>\n            <p className=\"text-[11px] font-sans text-slate-600\">{settings.branchName}</p>\n            <p className=\"text-[10px] text-slate-500\">{settings.address}</p>\n            <div className=\"text-[10px] text-slate-500 pt-1\">\n              <span>TIN: {settings.tinNumber}</span> | <span>BPLO: {settings.bploPermitNo}</span>\n            </div>\n            <p className=\"text-[10px] text-slate-500\">Contact: {settings.contactNumber}</p>\n          </div>\n\n          {/* Transaction Metadata */}\n          <div className=\"space-y-1 text-[11px] border-b border-dashed border-slate-300 pb-3\">\n            <div className=\"flex justify-between\">\n              <span>Receipt No:</span>\n              <span className=\"font-bold\">{transaction.receiptNo}</span>\n            </div>\n            <div className=\"flex justify-between\">\n              <span>Date/Time:</span>\n              <span>{new Date(transaction.timestamp).toLocaleString()}</span>\n            </div>\n            <div className=\"flex justify-between\">\n              <span>Cashier:</span>\n              <span>{transaction.cashierName}</span>\n            </div>\n            <div className=\"flex justify-between\">\n              <span>Payment Path:</span>\n              <span className=\"font-bold uppercase\">{transaction.paymentMethod}</span>\n            </div>\n\n            {transaction.discount.isSeniorOrPwd && (\n              <div className=\"flex justify-between text-amber-800 font-bold bg-amber-50 p-1 rounded mt-1\">\n                <span>SC/PWD ID:</span>\n                <span>{transaction.discount.idNumber || \'Verified\'}</span>\n              </div>\n            )}\n\n            {transaction.customerName && (\n              <div className=\"flex justify-between text-blue-800 font-bold bg-blue-50 p-1 rounded mt-1\">\n                <span>Listahan Account:</span>\n                <span>{transaction.customerName}</span>\n              </div>\n            )}\n          </div>\n\n          {/* Line Items Table */}\n          <div className=\"space-y-2 border-b border-dashed border-slate-300 pb-3\">\n            <div className=\"flex justify-between font-bold text-slate-900 border-b border-slate-200 pb-1\">\n              <span>QTY & DISH ITEM</span>\n              <span>AMOUNT</span>\n            </div>\n\n            {transaction.items.map((item) => (\n              <div key={item.cartItemId} className=\"flex justify-between items-start\">\n                <div>\n                  <div className=\"font-bold\">\n                    {item.quantity}x {item.menuItem.name}\n                    {item.isHalfOrder && \' (HALF)\'}\n                  </div>\n                  <div className=\"text-[10px] text-slate-500\">\n                    @ \342\202\261{item.unitPrice.toFixed(2)}\n                  </div>\n                </div>\n                <div className=\"font-bold\">\342\202\261{item.totalPrice.toFixed(2)}</div>\n              </div>\n            ))}\n          </div>\n\n          {/* Math & Totals Breakdown */}\n          <div className=\"space-y-1.5 text-[11px] border-b border-dashed border-slate-300 pb-3\">\n            <div className=\"flex justify-between\">\n              <span>Gross Order Subtotal:</span>\n              <span>\342\202\261{transaction.subtotal.toFixed(2)}</span>\n            </div>\n\n            {transaction.discount.isSeniorOrPwd && (\n              <>\n                <div className=\"flex justify-between text-amber-800\">\n                  <span>Less 12% VAT Exemption:</span>\n                  <span>-\342\202\261{transaction.discount.vatExemptAmount.toFixed(2)}</span>\n                </div>\n                <div className=\"flex justify-between text-amber-800\">\n                  <span>Less 20% SC/PWD Discount:</span>\n                  <span>-\342\202\261{transaction.discount.discountAmount.toFixed(2)}</span>\n                </div>\n              </>\n            )}\n\n            <div className=\"flex justify-between text-base font-extrabold text-slate-900 pt-1\">\n              <span>TOTAL DUE:</span>\n              <span>\342\202\261{transaction.totalAmount.toFixed(2)}</span>\n            </div>\n          </div>\n\n          {/* Settlement Details */}\n          <div className=\"space-y-1 text-[11px]\">\n            {transaction.paymentMethod === \'CASH\' && (\n              <>\n                <div className=\"flex justify-between\">\n                  <span>Cash Tendered:</span>\n                  <span>\342\202\261{(transaction.tenderedAmount || transaction.totalAmount).toFixed(2)}</span>\n                </div>\n                <div className=\"flex justify-between font-bold text-slate-900\">\n                  <span>Change Due:</span>\n                  <span>\342\202\261{(transaction.changeAmount || 0).toFixed(2)}</span>\n                </div>\n              </>\n            )}\n\n            {transaction.paymentMethod === \'E_WALLET\' && (\n              <div className=\"flex justify-between font-bold text-slate-800\">\n                <span>PayMongo Ref #:</span>\n                <span>{transaction.paymongoRef}</span>\n              </div>\n            )}\n\n            {transaction.paymentMethod === \'LISTAHAN_CREDIT\' && (\n              <div className=\"text-center font-bold text-blue-900 bg-blue-50 p-2 rounded border border-blue-200\">\n                Logged to {transaction.customerName}\'s Listahan Account\n              </div>\n            )}\n          </div>\n\n          {/* Footer Note */}\n          <div className=\"text-center pt-2 text-[10px] text-slate-500 font-sans space-y-0.5\">\n            <p className=\"font-bold text-slate-700\">Mamingaw at Masarap na Kain!</p>\n            <p>Thank you for dining at {settings.storeName}</p>\n            <p className=\"text-[9px] text-slate-400\">Powered by CariCloud POS Marikina</p>\n          </div>\n\n        </div>\n\n        {/* Action Buttons */}\n        <div className=\"p-4 bg-slate-100 border-t border-slate-200 flex items-center justify-between\">\n          <button\n            onClick={onClose}\n            className=\"px-4 py-2 text-xs font-bold text-slate-600 hover:bg-slate-200 rounded-lg transition\"\n          >\n            New Order\n          </button>\n          <button\n            onClick={handlePrint}\n            className=\"px-5 py-2.5 bg-slate-900 hover:bg-slate-800 text-white font-bold rounded-lg text-xs flex items-center space-x-2 transition shadow-sm\"\n          >\n            <Printer className=\"w-4 h-4\" />\n            <span>Print Official Receipt</span>\n          </button>\n        </div>\n\n      </div>\n    </div>\n  );\n};\n"
    }
