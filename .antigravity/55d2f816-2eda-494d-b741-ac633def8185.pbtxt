  file_change {
    absolute_path_uri: "file:///src/components/BploTaxModule.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  Building2, \n  ShieldCheck, \n  AlertTriangle, \n  Download, \n  Printer, \n  Sparkles, \n  Lock, \n  CheckCircle2, \n  TrendingUp, \n  FileText,\n  HelpCircle\n} from \'lucide-react\';\nimport { MarikinaTaxReliefStats, StoreSettings, SubscriptionTierLevel } from \'../types\';\n\ninterface BploTaxModuleProps {\n  stats: MarikinaTaxReliefStats;\n  settings: StoreSettings;\n  onUpgradeTier: (tier: SubscriptionTierLevel) => void;\n}\n\nexport const BploTaxModule: React.FC<BploTaxModuleProps> = ({\n  stats,\n  settings,\n  onUpgradeTier,\n}) => {\n  const [showDeclarationPreview, setShowDeclarationPreview] = useState(false);\n\n  const isTier3Unlocked = settings.activeTier >= 3;\n  const percentOfThreshold = Math.min(100, Math.round((stats.currentAnnualGross / stats.annualGrossThreshold) * 100));\n\n  const isApproaching = percentOfThreshold >= 80 && percentOfThreshold < 100;\n  const isExceeded = percentOfThreshold >= 100;\n\n  const handlePrintForm = () => {\n    window.print();\n  };\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6\">\n      \n      {/* Top Banner */}\n      <div className=\"bg-white rounded-xl shadow-sm border border-slate-200 p-4 flex flex-col md:flex-row items-center justify-between gap-4\">\n        <div>\n          <div className=\"flex items-center space-x-2\">\n            <Building2 className=\"w-6 h-6 text-orange-600\" />\n            <h2 className=\"text-xl font-bold text-slate-900\">\n              Marikina 2026 Tax Relief & BPLO Gross Sales Compliance\n            </h2>\n            <span className=\"bg-orange-100 text-orange-800 text-[10px] font-black px-2 py-0.5 rounded uppercase\">\n              Ordinance No. 2026-018\n            </span>\n          </div>\n          <p className=\"text-xs text-slate-500 mt-1\">\n            Automated monitoring of Marikina Municipal \342\202\261250,000 gross sales threshold for preferential SME local tax relief exemptions\n          </p>\n        </div>\n\n        {!isTier3Unlocked && (\n          <div className=\"bg-amber-50 border border-amber-300 p-3 rounded-xl flex items-center space-x-3\">\n            <Lock className=\"w-5 h-5 text-amber-600\" />\n            <div className=\"text-xs\">\n              <span className=\"font-bold text-amber-900 block\">Tier 3 Feature (\342\202\261199/mo)</span>\n              <span className=\"text-amber-800 text-[11px]\">Upgrade to generate official BPLO tax forms</span>\n            </div>\n            <button\n              onClick={() => onUpgradeTier(3)}\n              className=\"px-3 py-1.5 bg-amber-600 hover:bg-amber-700 text-white font-bold rounded-lg text-xs transition\"\n            >\n              Upgrade\n            </button>\n          </div>\n        )}\n      </div>\n\n      {/* Main Compliance Dashboard */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n        \n        {/* Left Column: Threshold Progress & Metrics (7 Cols) */}\n        <div className=\"lg:col-span-7 space-y-5\">\n          \n          {/* Progress Card */}\n          <div className=\"bg-white rounded-2xl shadow-sm border border-slate-200 p-5 space-y-4\">\n            <div className=\"flex items-center justify-between\">\n              <span className=\"text-xs font-bold text-slate-500 uppercase tracking-wider\">\n                Annual Gross Sales Tracker\n              </span>\n              <span\n                className={`text-xs font-bold px-2.5 py-1 rounded-full flex items-center gap-1 ${\n                  isExceeded\n                    ? \'bg-red-100 text-red-800 border border-red-300\'\n                    : isApproaching\n                    ? \'bg-amber-100 text-amber-800 border border-amber-300\'\n                    : \'bg-emerald-100 text-emerald-800 border border-emerald-300\'\n                }`}\n              >\n                {isExceeded ? (\n                  <>\n                    <AlertTriangle className=\"w-3.5 h-3.5 text-red-600\" />\n                    <span>Threshold Exceeded</span>\n                  </>\n                ) : isApproaching ? (\n                  <>\n                    <AlertTriangle className=\"w-3.5 h-3.5 text-amber-600\" />\n                    <span>Approaching Threshold Alert</span>\n                  </>\n                ) : (\n                  <>\n                    <ShieldCheck className=\"w-3.5 h-3.5 text-emerald-600\" />\n                    <span>100% Tax Relief Eligible \360\237\237\242</span>\n                  </>\n                )}\n              </span>\n            </div>\n\n            {/* Threshold Meter */}\n            <div className=\"space-y-2\">\n              <div className=\"flex justify-between items-baseline\">\n                <span className=\"text-2xl font-black text-slate-900\">\n                  \342\202\261{stats.currentAnnualGross.toLocaleString()}\n                </span>\n                <span className=\"text-xs text-slate-500 font-bold\">\n                  Limit: \342\202\261{stats.annualGrossThreshold.toLocaleString()}\n                </span>\n              </div>\n\n              <div className=\"w-full bg-slate-100 h-3.5 rounded-full overflow-hidden p-0.5 border border-slate-200\">\n                <div\n                  className={`h-full rounded-full transition-all duration-500 ${\n                    isExceeded\n                      ? \'bg-red-600\'\n                      : isApproaching\n                      ? \'bg-amber-500\'\n                      : \'bg-gradient-to-r from-orange-500 to-emerald-500\'\n                  }`}\n                  style={{ width: `${percentOfThreshold}%` }}\n                />\n              </div>\n\n              <div className=\"flex justify-between text-[11px] text-slate-500 font-medium pt-1\">\n                <span>0%</span>\n                <span>{percentOfThreshold}% Used</span>\n                <span>\342\202\261250,000 Cap</span>\n              </div>\n            </div>\n\n            {/* Tax Savings Banner */}\n            <div className=\"bg-emerald-50 border border-emerald-200 p-4 rounded-xl flex items-center justify-between text-xs\">\n              <div>\n                <span className=\"font-bold text-emerald-900 block\">\n                  Estimated Local Business Tax Relief Savings:\n                </span>\n                <span className=\"text-xs text-emerald-700\">\n                  Under Marikina City SME Ordinance No. 2026-018\n                </span>\n              </div>\n              <span className=\"text-xl font-black text-emerald-700\">\n                \342\202\261{stats.estimatedTaxSavings.toFixed(2)}\n              </span>\n            </div>\n          </div>\n\n          {/* Quarterly Gross Sales Breakdown */}\n          <div className=\"bg-white rounded-xl shadow-sm border border-slate-200 p-5 space-y-3\">\n            <h3 className=\"font-bold text-slate-800 text-xs uppercase tracking-wider flex items-center gap-2\">\n              <TrendingUp className=\"w-4 h-4 text-orange-600\" />\n              Quarterly Gross Receipts Breakdown (2026)\n            </h3>\n\n            <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs\">\n              <div className=\"bg-slate-50 p-3 rounded-xl border border-slate-200 text-center\">\n                <span className=\"text-slate-400 font-bold text-[10px] block\">Q1 GROSS</span>\n                <span className=\"font-black text-slate-800 text-sm\">\342\202\261{stats.quarter1Gross.toLocaleString()}</span>\n              </div>\n              <div className=\"bg-slate-50 p-3 rounded-xl border border-slate-200 text-center\">\n                <span className=\"text-slate-400 font-bold text-[10px] block\">Q2 GROSS</span>\n                <span className=\"font-black text-slate-800 text-sm\">\342\202\261{stats.quarter2Gross.toLocaleString()}</span>\n              </div>\n              <div className=\"bg-slate-50 p-3 rounded-xl border border-slate-200 text-center\">\n                <span className=\"text-slate-400 font-bold text-[10px] block\">Q3 GROSS</span>\n                <span className=\"font-black text-slate-800 text-sm\">\342\202\261{stats.quarter3Gross.toLocaleString()}</span>\n              </div>\n              <div className=\"bg-slate-50 p-3 rounded-xl border border-slate-200 text-center\">\n                <span className=\"text-slate-400 font-bold text-[10px] block\">Q4 (EST.)</span>\n                <span className=\"font-black text-slate-800 text-sm\">\342\202\261{stats.quarter4Gross.toLocaleString()}</span>\n              </div>\n            </div>\n          </div>\n\n        </div>\n\n        {/* Right Column: Automated BPLO Declaration Form Generation (5 Cols) */}\n        <div className=\"lg:col-span-5 space-y-4\">\n          <div className=\"bg-slate-900 text-white rounded-2xl p-5 shadow-md border border-slate-800 space-y-4\">\n            <div className=\"flex items-center space-x-2 border-b border-slate-800 pb-2\">\n              <FileText className=\"w-5 h-5 text-orange-400\" />\n              <h3 className=\"font-bold text-base text-white\">\n                Automated BPLO Reporting\n              </h3>\n            </div>\n\n            <p className=\"text-xs text-slate-300 leading-relaxed\">\n              Aggregates historical sales transactions to output standard Gross Sales Tax Declaration matching the exact layout required by Marikina Business Permits & Licensing Office.\n            </p>\n\n            <div className=\"bg-slate-800 p-3 rounded-xl text-xs space-y-1.5 border border-slate-700\">\n              <div className=\"flex justify-between\">\n                <span className=\"text-slate-400\">Tax Year:</span>\n                <span className=\"font-bold text-white\">2026</span>\n              </div>\n              <div className=\"flex justify-between\">\n                <span className=\"text-slate-400\">Business Permit #:</span>\n                <span className=\"font-bold text-white\">{settings.bploPermitNo}</span>\n              </div>\n              <div className=\"flex justify-between\">\n                <span className=\"text-slate-400\">TIN Number:</span>\n                <span className=\"font-bold text-white\">{settings.tinNumber}</span>\n              </div>\n            </div>\n\n            <button\n              onClick={() => {\n                if (!isTier3Unlocked) {\n                  alert(\'Automated BPLO Form export requires SaaS Tier 3 (\342\202\261199/mo). Upgrade below.\');\n                  onUpgradeTier(3);\n                } else {\n                  setShowDeclarationPreview(true);\n                }\n              }}\n              className=\"w-full py-3 bg-orange-500 hover:bg-orange-600 text-slate-950 font-black rounded-xl text-xs shadow-md transition flex items-center justify-center space-x-2 cursor-pointer\"\n            >\n              <Download className=\"w-4 h-4\" />\n              <span>PREVIEW & DOWNLOAD BPLO DECLARATION</span>\n            </button>\n          </div>\n        </div>\n\n      </div>\n\n      {/* Official BPLO Declaration Form Preview Modal */}\n      {showDeclarationPreview && (\n        <div className=\"fixed inset-0 bg-slate-900/80 backdrop-blur-xs z-50 flex items-center justify-center p-4\">\n          <div className=\"bg-white rounded-2xl shadow-2xl max-w-3xl w-full border border-slate-300 overflow-hidden flex flex-col max-h-[90vh]\">\n            \n            <div className=\"p-4 bg-slate-900 text-white flex items-center justify-between\">\n              <span className=\"font-bold text-sm\">Official Marikina BPLO Declaration Preview</span>\n              <button\n                onClick={() => setShowDeclarationPreview(false)}\n                className=\"text-slate-400 hover:text-white\"\n              >\n                Close\n              </button>\n            </div>\n\n            {/* Printable Official Document */}\n            <div className=\"p-8 overflow-y-auto space-y-6 text-slate-800 bg-white\" id=\"bplo-form-print\">\n              \n              {/* Official Header */}\n              <div className=\"text-center space-y-1 border-b-2 border-slate-900 pb-4\">\n                <p className=\"text-xs font-semibold tracking-widest text-slate-600 uppercase\">\n                  REPUBLIC OF THE PHILIPPINES\n                </p>\n                <h2 className=\"font-black text-lg text-slate-900\">\n                  CITY GOVERNMENT OF MARIKINA\n                </h2>\n                <p className=\"text-xs font-bold text-orange-800\">\n                  Business Permits and Licensing Office (BPLO)\n                </p>\n                <p className=\"text-[11px] text-slate-500\">\n                  City Hall Complex, Shoe Avenue, Barangay Sto. Ni\303\261o, Marikina City\n                </p>\n                <h3 className=\"font-extrabold text-sm text-slate-900 pt-2 uppercase tracking-wide\">\n                  ANNUAL SWORN DECLARATION OF GROSS SALES / RECEIPTS FOR 2026\n                </h3>\n              </div>\n\n              {/* Taxpayer Information Grid */}\n              <div className=\"grid grid-cols-2 gap-4 text-xs bg-slate-50 p-4 border border-slate-200 rounded-xl\">\n                <div>\n                  <span className=\"text-slate-500 font-bold block\">Registered Business Name:</span>\n                  <span className=\"font-extrabold text-slate-900\">{settings.storeName}</span>\n                </div>\n                <div>\n                  <span className=\"text-slate-500 font-bold block\">Branch / Location:</span>\n                  <span className=\"font-bold text-slate-900\">{settings.branchName}</span>\n                </div>\n                <div>\n                  <span className=\"text-slate-500 font-bold block\">Business Address:</span>\n                  <span className=\"font-bold text-slate-900\">{settings.address}</span>\n                </div>\n                <div>\n                  <span className=\"text-slate-500 font-bold block\">BPLO Permit No:</span>\n                  <span className=\"font-bold text-slate-900\">{settings.bploPermitNo}</span>\n                </div>\n                <div>\n                  <span className=\"text-slate-500 font-bold block\">Taxpayer Identification No (TIN):</span>\n                  <span className=\"font-bold text-slate-900\">{settings.tinNumber}</span>\n                </div>\n                <div>\n                  <span className=\"text-slate-500 font-bold block\">Line of Business:</span>\n                  <span className=\"font-bold text-slate-900\">Eatery / Carinderia Operations</span>\n                </div>\n              </div>\n\n              {/* Certified Gross Sales Table */}\n              <div className=\"space-y-2\">\n                <h4 className=\"font-bold text-xs text-slate-900 uppercase\">\n                  I. Certified Gross Receipts Breakdown\n                </h4>\n                <table className=\"w-full text-xs border border-slate-300 divide-y divide-slate-200\">\n                  <thead className=\"bg-slate-100 font-bold text-slate-800\">\n                    <tr>\n                      <th className=\"p-2 text-left\">Period / Quarter</th>\n                      <th className=\"p-2 text-right\">Gross Receipts (PHP)</th>\n                      <th className=\"p-2 text-right\">Senior/PWD Discounts</th>\n                      <th className=\"p-2 text-right\">Net Taxable Receipts</th>\n                    </tr>\n                  </thead>\n                  <tbody className=\"divide-y divide-slate-200 font-medium\">\n                    <tr>\n                      <td className=\"p-2\">Quarter 1 (Jan - Mar)</td>\n                      <td className=\"p-2 text-right\">\342\202\261{stats.quarter1Gross.toLocaleString()}</td>\n                      <td className=\"p-2 text-right\">\342\202\261{(stats.quarter1Gross * 0.03).toFixed(2)}</td>\n                      <td className=\"p-2 text-right\">\342\202\261{(stats.quarter1Gross * 0.97).toFixed(2)}</td>\n                    </tr>\n                    <tr>\n                      <td className=\"p-2\">Quarter 2 (Apr - Jun)</td>\n                      <td className=\"p-2 text-right\">\342\202\261{stats.quarter2Gross.toLocaleString()}</td>\n                      <td className=\"p-2 text-right\">\342\202\261{(stats.quarter2Gross * 0.03).toFixed(2)}</td>\n                      <td className=\"p-2 text-right\">\342\202\261{(stats.quarter2Gross * 0.97).toFixed(2)}</td>\n                    </tr>\n                    <tr>\n                      <td className=\"p-2\">Quarter 3 (Jul - Sep)</td>\n                      <td className=\"p-2 text-right\">\342\202\261{stats.quarter3Gross.toLocaleString()}</td>\n                      <td className=\"p-2 text-right\">\342\202\261{(stats.quarter3Gross * 0.03).toFixed(2)}</td>\n                      <td className=\"p-2 text-right\">\342\202\261{(stats.quarter3Gross * 0.97).toFixed(2)}</td>\n                    </tr>\n                    <tr>\n                      <td className=\"p-2\">Quarter 4 (Oct - Dec)</td>\n                      <td className=\"p-2 text-right\">\342\202\261{stats.quarter4Gross.toLocaleString()}</td>\n                      <td className=\"p-2 text-right\">\342\202\261{(stats.quarter4Gross * 0.03).toFixed(2)}</td>\n                      <td className=\"p-2 text-right\">\342\202\261{(stats.quarter4Gross * 0.97).toFixed(2)}</td>\n                    </tr>\n                    <tr className=\"bg-orange-50 font-black text-slate-900\">\n                      <td className=\"p-2\">TOTAL ANNUAL GROSS</td>\n                      <td className=\"p-2 text-right\">\342\202\261{stats.currentAnnualGross.toLocaleString()}</td>\n                      <td className=\"p-2 text-right\">\342\202\261{(stats.currentAnnualGross * 0.03).toFixed(2)}</td>\n                      <td className=\"p-2 text-right text-orange-700\">\342\202\261{(stats.currentAnnualGross * 0.97).toFixed(2)}</td>\n                    </tr>\n                  </tbody>\n                </table>\n              </div>\n\n              {/* Tax Relief Assessment Section */}\n              <div className=\"bg-emerald-50 border border-emerald-300 p-4 rounded-xl text-xs space-y-1\">\n                <span className=\"font-bold text-emerald-900 block\">\n                  II. Marikina Ordinance 2026-018 Relief Assessment\n                </span>\n                <p className=\"text-emerald-800\">\n                  The subject business entity has declared total annual gross receipts of{\' \'}\n                  <strong className=\"underline\">\342\202\261{stats.currentAnnualGross.toLocaleString()}</strong>, which is{\' \'}\n                  <strong>WITHIN</strong> the \342\202\261250,000 threshold. Entity is verified <strong>ELIGIBLE</strong> for preferential 100% SME tax relief exemption for calendar year 2026.\n                </p>\n              </div>\n\n              {/* Sworn Undertaking */}\n              <div className=\"pt-4 text-[11px] text-slate-600 space-y-6\">\n                <p>\n                  I hereby certify under oath that the information provided above is true, correct, and complete to the best of my knowledge and based on authentic CariCloud POS financial logs.\n                </p>\n\n                <div className=\"flex justify-between items-end pt-8\">\n                  <div className=\"text-center border-t border-slate-900 w-48 pt-1\">\n                    <span className=\"font-bold text-slate-900 block\">Taxpayer / Owner Signature</span>\n                    <span className=\"text-[10px] text-slate-500\">Date: {new Date().toLocaleDateString()}</span>\n                  </div>\n\n                  <div className=\"text-center border-t border-slate-900 w-48 pt-1\">\n                    <span className=\"font-bold text-slate-900 block\">Marikina BPLO Officer</span>\n                    <span className=\"text-[10px] text-slate-500\">Stamp & Verification Seal</span>\n                  </div>\n                </div>\n              </div>\n\n            </div>\n\n            {/* Print Footer */}\n            <div className=\"p-4 bg-slate-100 border-t border-slate-200 flex items-center justify-between\">\n              <button\n                onClick={() => setShowDeclarationPreview(false)}\n                className=\"px-4 py-2 text-xs font-bold text-slate-600 hover:bg-slate-200 rounded-lg\"\n              >\n                Close Preview\n              </button>\n              <button\n                onClick={handlePrintForm}\n                className=\"px-5 py-2.5 bg-slate-900 hover:bg-slate-800 text-white font-bold rounded-lg text-xs flex items-center space-x-2 shadow-sm\"\n              >\n                <Printer className=\"w-4 h-4\" />\n                <span>Print Official Sworn BPLO Form</span>\n              </button>\n            </div>\n\n          </div>\n        </div>\n      )}\n\n    </div>\n  );\n};\n"
    }
