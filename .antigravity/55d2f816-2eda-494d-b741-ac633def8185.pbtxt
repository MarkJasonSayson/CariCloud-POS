          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  required"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  value={payAmount}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  onChange={(e) => setPayAmount(parseFloat(e.target.value) || 0)}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
