  file_change {
    absolute_path_uri: "file:///src/components/ReceiptModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { Printer, CheckCircle, X, ArrowRight, BookmarkCheck } from \'lucide-react\';\nimport { Transaction, StoreSettings } from \'../types\';\n\ninterface ReceiptModalProps {\n  transaction: Transaction | null;\n  settings: StoreSettings;\n  onClose: () => void;\n}\n\nexport const ReceiptModal: React.FC<ReceiptModalProps> = ({\n  transaction,\n  settings,\n  onClose,\n}) => {\n  if (!transaction) return null;\n\n  const handlePrint = () => {\n    window.print();\n  };\n\n  const handlePrintAndNewOrder = () => {\n    window.print();\n    onClose();\n  };\n\n  return (\n    <div className=\"fixed inset-0 bg-[#2D241E]/70 backdrop-blur-xs z-50 flex items-center justify-center p-4 animate-fadeIn\">\n      <div className=\"bg-white rounded-2xl shadow-2xl max-w-md w-full border border-[#E8E2DD] overflow-hidden flex flex-col max-h-[90vh]\">\n        \n        {/* Modal Top Bar */}\n        <div className=\"p-3.5 bg-[#2D241E] text-white flex items-center justify-between\">\n          <div className=\"flex items-center space-x-2\">\n            <CheckCircle className=\"w-5 h-5 text-emerald-400\" />\n            <div>\n              <span className=\"font-extrabold text-sm block\">Transaction Complete!</span>\n              <span className=\"text-[10px] text-stone-300 font-medium\">Auto-archived to Receipts Section</span>\n            </div>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-1 rounded-lg text-stone-400 hover:text-white hover:bg-stone-800 transition cursor-pointer\"\n            title=\"Close & Start New Order\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Auto Archive Notice Banner */}\n        <div className=\"bg-[#FFF3E0] border-b border-[#E8E2DD] px-4 py-2 flex items-center justify-between text-[11px] font-bold text-[#BF360C]\">\n          <div className=\"flex items-center gap-1.5\">\n            <BookmarkCheck className=\"w-4 h-4 text-[#E65100]\" />\n            <span>Receipt saved in system archive</span>\n          </div>\n          <span className=\"text-[10px] text-[#756D67] font-semibold\">Accessible by Owner & Employee</span>\n        </div>\n\n        {/* Receipt Printable Container */}\n        <div className=\"p-6 overflow-y-auto font-mono text-[#2D241E] text-xs space-y-4 bg-[#FCFAF7]/50\" id=\"printable-receipt\">\n          \n          {/* Header */}\n          <div className=\"text-center space-y-1 pb-3 border-b border-dashed border-[#E8E2DD]\">\n            <h2 className=\"font-sans font-black text-lg text-[#2D241E] tracking-tight\">\n              {settings.storeName}\n            </h2>\n            <p className=\"text-[11px] font-sans text-[#756D67]\">{settings.branchName}</p>\n            <p className=\"text-[10px] text-[#756D67]\">{settings.address}</p>\n            <div className=\"text-[10px] text-[#756D67] pt-1\">\n              <span>TIN: {settings.tinNumber}</span> | <span>BPLO: {settings.bploPermitNo}</span>\n            </div>\n            <p className=\"text-[10px] text-[#756D67]\">Contact: {settings.contactNumber}</p>\n          </div>\n\n          {/* Transaction Metadata */}\n          <div className=\"space-y-1 text-[11px] border-b border-dashed border-[#E8E2DD] pb-3\">\n            <div className=\"flex justify-between\">\n              <span>Receipt No:</span>\n              <span className=\"font-extrabold text-[#E65100]\">{transaction.receiptNo}</span>\n            </div>\n            <div className=\"flex justify-between\">\n              <span>Date/Time:</span>\n              <span>{new Date(transaction.timestamp).toLocaleString()}</span>\n            </div>\n            <div className=\"flex justify-between\">\n              <span>Cashier:</span>\n              <span>{transaction.cashierName}</span>\n            </div>\n            <div className=\"flex justify-between\">\n              <span>Payment Path:</span>\n              <span className=\"font-bold uppercase\">{transaction.paymentMethod}</span>\n            </div>\n\n            {transaction.discount.isSeniorOrPwd && (\n              <div className=\"flex justify-between text-amber-900 font-bold bg-amber-50 p-1 rounded mt-1 border border-amber-200\">\n                <span>SC/PWD ID:</span>\n                <span>{transaction.discount.idNumber || \'Verified\'}</span>\n              </div>\n            )}\n\n            {transaction.customerName && (\n              <div className=\"flex justify-between text-purple-900 font-bold bg-purple-50 p-1 rounded mt-1 border border-purple-200\">\n                <span>Listahan Account:</span>\n                <span>{transaction.customerName}</span>\n              </div>\n            )}\n          </div>\n\n          {/* Line Items Table */}\n          <div className=\"space-y-2 border-b border-dashed border-[#E8E2DD] pb-3\">\n            <div className=\"flex justify-between font-extrabold text-[#2D241E] border-b border-[#E8E2DD] pb-1\">\n              <span>QTY & DISH ITEM</span>\n              <span>AMOUNT</span>\n            </div>\n\n            {transaction.items.map((item) => (\n              <div key={item.cartItemId} className=\"flex justify-between items-start\">\n                <div>\n                  <div className=\"font-bold\">\n                    {item.quantity}x {item.menuItem.name}\n                    {item.isHalfOrder && \' (HALF)\'}\n                  </div>\n                  <div className=\"text-[10px] text-[#756D67]\">\n                    @ \342\202\261{item.unitPrice.toFixed(2)}\n                  </div>\n                </div>\n                <div className=\"font-bold\">\342\202\261{item.totalPrice.toFixed(2)}</div>\n              </div>\n            ))}\n          </div>\n\n          {/* Math & Totals Breakdown */}\n          <div className=\"space-y-1.5 text-[11px] border-b border-dashed border-[#E8E2DD] pb-3\">\n            <div className=\"flex justify-between\">\n              <span>Gross Order Subtotal:</span>\n              <span>\342\202\261{transaction.subtotal.toFixed(2)}</span>\n            </div>\n\n            {transaction.discount.isSeniorOrPwd && (\n              <>\n                <div className=\"flex justify-between text-amber-900\">\n                  <span>Less 12% VAT Exemption:</span>\n                  <span>-\342\202\261{transaction.discount.vatExemptAmount.toFixed(2)}</span>\n                </div>\n                <div className=\"flex justify-between text-amber-900\">\n                  <span>Less 20% SC/PWD Discount:</span>\n                  <span>-\342\202\261{transaction.discount.discountAmount.toFixed(2)}</span>\n                </div>\n              </>\n            )}\n\n            <div className=\"flex justify-between text-base font-black text-[#2D241E] pt-1\">\n              <span>TOTAL DUE:</span>\n              <span>\342\202\261{transaction.totalAmount.toFixed(2)}</span>\n            </div>\n          </div>\n\n          {/* Settlement Details */}\n          <div className=\"space-y-1 text-[11px]\">\n            {transaction.paymentMethod === \'CASH\' && (\n              <>\n                <div className=\"flex justify-between\">\n                  <span>Cash Tendered:</span>\n                  <span>\342\202\261{(transaction.tenderedAmount || transaction.totalAmount).toFixed(2)}</span>\n                </div>\n                <div className=\"flex justify-between font-extrabold text-[#2D241E]\">\n                  <span>Change Due:</span>\n                  <span>\342\202\261{(transaction.changeAmount || 0).toFixed(2)}</span>\n                </div>\n              </>\n            )}\n\n            {transaction.paymentMethod === \'E_WALLET\' && (\n              <div className=\"flex justify-between font-bold text-blue-900\">\n                <span>PayMongo Ref #:</span>\n                <span>{transaction.paymongoRef}</span>\n              </div>\n            )}\n\n            {transaction.paymentMethod === \'LISTAHAN_CREDIT\' && (\n              <div className=\"text-center font-bold text-purple-900 bg-purple-50 p-2 rounded border border-purple-200\">\n                Logged to {transaction.customerName}\'s Listahan Account\n              </div>\n            )}\n          </div>\n\n          {/* Footer Note */}\n          <div className=\"text-center pt-2 text-[10px] text-[#756D67] font-sans space-y-0.5\">\n            <p className=\"font-bold text-[#2D241E]\">Mamingaw at Masarap na Kain!</p>\n            <p>Thank you for dining at {settings.storeName}</p>\n            <p className=\"text-[9px] text-[#756D67]\">Powered by CariCloud POS Marikina</p>\n          </div>\n\n        </div>\n\n        {/* Action Buttons Panel */}\n        <div className=\"p-4 bg-[#FCFAF7] border-t border-[#E8E2DD] flex flex-col sm:flex-row items-center justify-between gap-2\">\n          \n          {/* Direct Start New Order (WITHOUT printing) */}\n          <button\n            onClick={onClose}\n            className=\"w-full sm:w-auto px-4 py-2.5 bg-white hover:bg-[#FFF3E0] border border-[#E8E2DD] hover:border-[#E65100] text-[#2D241E] hover:text-[#E65100] font-extrabold rounded-xl text-xs flex items-center justify-center space-x-1.5 transition shadow-2xs cursor-pointer\"\n          >\n            <span>Start New Order (Skip Print)</span>\n            <ArrowRight className=\"w-4 h-4 text-[#E65100]\" />\n          </button>\n\n          {/* Print & Start New Order */}\n          <div className=\"flex items-center space-x-2 w-full sm:w-auto\">\n            <button\n              onClick={handlePrint}\n              className=\"px-3 py-2.5 bg-[#FCFAF7] hover:bg-[#E8E2DD] border border-[#E8E2DD] text-[#2D241E] font-bold rounded-xl text-xs flex items-center justify-center space-x-1 transition cursor-pointer\"\n              title=\"Print receipt without closing modal\"\n            >\n              <Printer className=\"w-3.5 h-3.5\" />\n              <span>Print Only</span>\n            </button>\n\n            <button\n              onClick={handlePrintAndNewOrder}\n              className=\"flex-1 sm:flex-initial px-4 py-2.5 bg-[#E65100] hover:bg-[#BF360C] text-white font-extrabold rounded-xl text-xs flex items-center justify-center space-x-1.5 transition shadow-2xs cursor-pointer\"\n            >\n              <Printer className=\"w-4 h-4\" />\n              <span>Print & New Order</span>\n            </button>\n          </div>\n\n        </div>\n\n      </div>\n    </div>\n  );\n};\n"
    }
    diff {
      end_line: 197
      unified_diff {
