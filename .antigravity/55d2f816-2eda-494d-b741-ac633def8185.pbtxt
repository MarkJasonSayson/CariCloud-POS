           <h3 className=\"font-extrabold text-[#2D241E] text-base\">{item.name}</h3>\n                {item.description && (\n                  <p className=\"text-xs text-[#756D67] mt-0.5 line-clamp-2\">{item.description}</p>\n                )}\n              </div>\n\n              <div className=\"flex items-center space-x-3 pt-2 text-xs font-bold text-[#2D241E]\">\n                <div>\n                  <span className=\"text-[10px] text-[#756D67] block font-medium\">Full Price:</span>\n                  <span className=\"text-base text-[#2D241E]\">\342\202\261{item.price.toFixed(2)}</span>\n                </div>\n\n                {item.allowHalfOrder && (\n                  <div className=\"border-l border-[#E8E2DD] pl-3\">\n                    <span className=\"text-[10px] text-[#756D67] block font-medium\">Half Portion:</span>\n                    <span className=\"text-base text-[#E65100]\">\342\202\261{(item.halfPrice || item.price / 2).toFixed(2)}</span>\n                  </div>\n                )}\n              </div>\n            </div>"
