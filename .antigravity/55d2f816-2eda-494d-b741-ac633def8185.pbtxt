  file_change {
    absolute_path_uri: "file:///src/components/POSModule.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4\">\n      {/* Quick POS Layout: Left Column (Quick-Keys Menu Grid), Right Column (Order Cart) */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n        \n        {/* LEFT COLUMN: HIGH-SPEED QUICK-KEYS MENU (7 Cols on LG) */}\n        <div className=\"lg:col-span-7 xl:col-span-8 space-y-4\">\n          \n          {/* Top Bar: Search & Category Tabs */}\n          <div className=\"bg-white rounded-2xl shadow-2xs border border-[#E8E2DD] p-3.5 space-y-3\">\n            \n            <div className=\"flex flex-col sm:flex-row items-center justify-between gap-3\">\n              {/* Search Bar */}\n              <div className=\"relative w-full sm:w-72\">\n                <Search className=\"w-4 h-4 absolute left-3 top-2.5 text-[#756D67]\" />\n                <input\n                  type=\"text\"\n                  placeholder=\"Search dish (e.g. Adobo, Rice)...\"\n                  value={searchQuery}\n                  onChange={(e) => setSearchQuery(e.target.value)}\n                  className=\"w-full pl-9 pr-3 py-1.5 text-sm bg-[#FCFAF7] border border-[#E8E2DD] rounded-xl focus:outline-none focus:ring-2 focus:ring-[#E65100] focus:bg-white text-[#2D241E]\"\n                />\n              </div>\n\n              {/* Peak-Hour High-Speed Indicator */}\n              <div className=\"flex items-center space-x-2 text-xs font-semibold text-[#BF360C] bg-[#FFF3E0] border border-[#E8E2DD] px-3 py-1.5 rounded-xl w-full sm:w-auto justify-center\">\n                <Zap className=\"w-4 h-4 text-[#E65100] animate-bounce\" />\n                <span>Quick-Keys POS (3-Tap Order)</span>\n              </div>\n            </div>\n\n            {/* Category Filter Pills */}\n            <div className=\"flex space-x-2 overflow-x-auto pb-1 scrollbar-none\">\n              <button\n                onClick={() => setSelectedCategory(\'ALL\')}\n                className={`px-3.5 py-1.5 rounded-xl text-xs font-bold transition whitespace-nowrap border ${\n                  selectedCategory === \'ALL\'\n                    ? \'bg-[#E65100] text-white border-[#E65100] shadow-xs\'\n                    : \'bg-white text-[#756D67] border-[#E8E2DD] hover:border-[#E65100] hover:text-[#2D241E]\'\n                }`}\n              >\n                All Menu ({menuItems.length})\n              </button>\n              {CATEGORIES.map((cat) => {\n                const count = menuItems.filter((m) => m.category === cat).length;\n                const isSelected = selectedCategory === cat;\n                return (\n                  <button\n                    key={cat}\n                    onClick={() => setSelectedCategory(cat)}\n                    className={`px-3.5 py-1.5 rounded-xl text-xs font-bold transition whitespace-nowrap border ${\n                      isSelected\n                        ? \'bg-[#E65100] text-white border-[#E65100] shadow-xs\'\n                        : \'bg-white text-[#756D67] border-[#E8E2DD] hover:border-[#E65100] hover:text-[#2D241E]\'\n                    }`}\n                  >\n                    {cat} ({count})\n                  </button>\n                );\n              })}\n            </div>\n\n          </div>\n\n          {/* Quick-Keys Dishes Grid */}\n          <div className=\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-3 xl:grid-cols-4 gap-3.5\">\n            {filteredMenuItems.map((dish) => {\n              const isHalf = halfOrderStates[dish.id] || false;\n              const effectivePrice = isHalf && dish.halfPrice ? dish.halfPrice : dish.price;\n\n              return (\n                <div\n                  key={dish.id}\n                  className={`relative flex flex-col justify-between bg-white rounded-2xl border p-3.5 transition-all shadow-2xs hover:shadow-xs ${\n                    dish.isSoldOut\n                      ? \'border-[#E8E2DD] bg-stone-50 opacity-60\'\n                      : \'border-[#E8E2DD] hover:border-[#E65100]\'\n                  }`}\n                >\n                  {/* Sold Out Badge */}\n                  {dish.isSoldOut && (\n                    <div className=\"absolute inset-0 bg-[#2D241E]/60 backdrop-blur-[1px] rounded-2xl z-10 flex items-center justify-center\">\n                      <span className=\"bg-[#333333] text-white text-[10px] font-bold uppercase px-2.5 py-1 rounded shadow-xs tracking-wider\">\n                        Sold Out\n                      </span>\n                    </div>\n                  )}\n\n                  <div>\n                    {/* Dish Image Thumbnail if available */}\n                    {dish.image && (\n                      <div className=\"w-full h-24 rounded-xl overflow-hidden mb-2 bg-slate-100 border border-[#E8E2DD]\">\n                        <img\n                          src={dish.image}\n                          alt={dish.name}\n                          className=\"w-full h-full object-cover\"\n                          referrerPolicy=\"no-referrer\"\n                        />\n                      </div>\n                    )}\n\n                    {/* Category Label & Price */}\n                    <div className=\"flex items-center justify-between mb-1.5\">\n                      <span className=\"text-[10px] font-bold text-[#756D67] uppercase tracking-wider\">\n                        {dish.category}\n                      </span>\n                      <span className=\"text-base font-extrabold text-[#E65100]\">\n                        \342\202\261{effectivePrice.toFixed(2)}\n                      </span>\n                    </div>\n\n                    {/* Dish Name */}\n                    <h4 className=\"font-bold text-[#2D241E] text-sm leading-tight line-clamp-2 min-h-[2.25rem]\">\n                      {dish.name}\n                    </h4>\n\n                    {/* Description preview */}\n                    {dish.description && (\n                      <p className=\"text-[11px] text-[#756D67] line-clamp-1 mt-0.5\">\n                        {dish.description}\n                      </p>\n                    )}\n                  </div>\n\n                  {/* Half-Order Portion Switch & Add Button */}\n                  <div className=\"mt-3 pt-2.5 border-t border-[#E8E2DD] space-y-2\">\n                    {/* Portion switch toggle if dish allows half order */}\n                    {dish.allowHalfOrder && (\n                      <div className=\"flex items-center justify-between bg-[#FCFAF7] border border-[#E8E2DD] rounded-xl p-1 text-[11px]\">\n                        <span className=\"text-[#756D67] font-semibold px-1\">Portion:</span>\n                        <div className=\"flex items-center space-x-1\">\n                          <button\n                            type=\"button\"\n                            onClick={(e) => {\n                              e.stopPropagation();\n                              if (isHalf) toggleHalfOrderState(dish.id);\n                            }}\n                            className={`px-2 py-0.5 rounded-lg font-bold transition text-[10px] ${\n                              !isHalf ? \'bg-[#E65100] text-white shadow-2xs\' : \'text-[#756D67] hover:text-[#2D241E]\'\n                            }`}\n                          >\n                            Full (\342\202\261{dish.price})\n                          </button>\n                          <button\n                            type=\"button\"\n                            onClick={(e) => {\n                              e.stopPropagation();\n                              if (!isHalf) toggleHalfOrderState(dish.id);\n                            }}\n                            className={`px-2 py-0.5 rounded-lg font-bold transition text-[10px] ${\n                              isHalf ? \'bg-[#BF360C] text-white shadow-2xs\' : \'text-[#756D67] hover:text-[#2D241E]\'\n                            }`}\n                          >\n                            Half (\342\202\261{dish.halfPrice || Math.round(dish.price / 2)})\n                          </button>\n                        </div>\n                      </div>\n                    )}\n\n                    {/* Quick Add Button */}\n                    <button\n                      disabled={dish.isSoldOut}\n                      onClick={() => onAddToCart(dish, isHalf)}\n                      className=\"w-full py-2 bg-[#E65100] hover:bg-[#BF360C] active:scale-[0.98] text-white font-bold rounded-xl text-xs flex items-center justify-center space-x-1.5 transition shadow-2xs cursor-pointer\"\n                    >\n                      <Plus className=\"w-3.5 h-3.5\" />\n                      <span>Add to Order</span>\n                    </button>\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n\n        </div>\n\n        {/* RIGHT COLUMN: ACTIVE ORDER CART & CHECKOUT PANEL (5 Cols on LG) */}\n        <div className=\"lg:col-span-5 xl:col-span-4\">\n          <div className=\"bg-white rounded-2xl shadow-sm border border-[#E8E2DD] flex flex-col h-full sticky top-20 overflow-hidden\">\n            \n            {/* Cart Header */}\n            <div className=\"p-4 border-b border-[#E8E2DD] flex items-center justify-between bg-[#FCFAF7]\">\n              <div className=\"flex items-center space-x-2\">\n                <ShoppingBag className=\"w-5 h-5 text-[#E65100]\" />\n                <h3 className=\"font-extrabold text-[#2D241E] text-base\">Current Order</h3>\n                <span className=\"bg-[#FFF3E0] text-[#E65100] border border-[#E8E2DD] font-bold text-xs px-2 py-0.5 rounded-full\">\n                  {cart.reduce((sum, i) => sum + i.quantity, 0)} items\n                </span>\n              </div>\n\n              {cart.length > 0 && (\n                <button\n                  onClick={onClearCart}\n                  className=\"text-xs text-red-600 hover:text-red-700 font-semibold flex items-center gap-1 hover:underline cursor-pointer\"\n                >\n                  <Trash2 className=\"w-3.5 h-3.5\" />\n                  Clear\n                </button>\n              )}\n            </div>\n\n            {/* Cart Items List */}\n            <div className=\"p-4 flex-1 overflow-y-auto max-h-[380px] space-y-3 divide-y divide-[#E8E2DD]\">\n              {cart.length === 0 ? (\n                <div className=\"py-12 text-center text-[#756D67] space-y-2\">\n                  <Utensils className=\"w-10 h-10 mx-auto stroke-1 opacity-40 text-[#756D67]\" />\n                  <p className=\"text-sm font-bold text-[#2D241E]\">Order ticket is empty</p>\n                  <p className=\"text-xs text-[#756D67]\">Tap dish items on the left to add to counter cart</p>\n                </div>\n              ) : (\n                cart.map((item) => (\n                  <div key={item.cartItemId} className=\"pt-3 first:pt-0 flex items-start justify-between gap-2\">\n                    <div className=\"flex-1 min-w-0\">\n                      <div className=\"flex items-center gap-1.5 flex-wrap\">\n                        <span className=\"font-bold text-[#2D241E] text-sm\">\n                          {item.menuItem.name}\n                        </span>\n                        {item.isHalfOrder && (\n                          <span className=\"bg-amber-100 text-amber-900 border border-amber-300 text-[10px] font-extrabold px-1.5 py-0.2 rounded uppercase\">\n                            Half Portion\n                          </span>\n                        )}\n                      </div>\n\n                      <div className=\"text-xs text-[#756D67] font-medium mt-0.5\">\n                        \342\202\261{item.unitPrice.toFixed(2)} each\n                      </div>\n                    </div>\n\n                    {/* Quantity Controls & Line Total */}\n                    <div className=\"flex items-center space-x-3\">\n                      <div className=\"flex items-center border border-[#E8E2DD] rounded-xl bg-[#FCFAF7]\">\n                        <button\n                          onClick={() => onUpdateCartItemQuantity(item.cartItemId, item.quantity - 1)}\n                          className=\"p-1 hover:bg-[#E8E2DD] text-[#2D241E] rounded-l-xl transition cursor-pointer\"\n                        >\n                          <Minus className=\"w-3.5 h-3.5\" />\n                        </button>\n                        <span className=\"px-2 text-xs font-bold text-[#2D241E] min-w-[1.25rem] text-center\">\n                          {item.quantity}\n                        </span>\n                        <button\n                          onClick={() => onUpdateCartItemQuantity(item.cartItemId, item.quantity + 1)}\n                          className=\"p-1 hover:bg-[#E8E2DD] text-[#2D241E] rounded-r-xl transition cursor-pointer\"\n                        >\n                          <Plus className=\"w-3.5 h-3.5\" />\n                        </button>\n                      </div>\n\n                      <div className=\"text-right min-w-[3.5rem]\">\n                        <div className=\"font-extrabold text-[#2D241E] text-sm\">\n                          \342\202\261{item.totalPrice.toFixed(2)}\n                        </div>\n                        <button\n                          onClick={() => onRemoveCartItem(item.cartItemId)}\n                          className=\"text-[10px] text-red-600 hover:text-red-800 font-semibold cursor-pointer\"\n                        >\n                          Remove\n                        </button>\n                      </div>\n                    </div>\n                  </div>\n                ))\n              )}\n            </div>\n\n            {/* Statutory Discount Toggle (Senior Citizen / PWD 20% + 12% VAT) */}\n            <div className=\"p-3.5 bg-[#FFF3E0] border-t border-[#E8E2DD] space-y-2\">\n              <div className=\"flex items-center justify-between\">\n                <div className=\"flex items-center space-x-2\">\n                  <UserCheck className=\"w-4 h-4 text-[#E65100]\" />\n                  <span className=\"text-xs font-bold text-[#2D241E]\">\n                    Senior / PWD Discount (20% + VAT Exempt)\n                  </span>\n                </div>\n                <input\n                  type=\"checkbox\"\n                  checked={isSeniorOrPwd}\n                  onChange={(e) => {\n                    if (e.target.checked) {\n                      setShowSeniorModal(true);\n                    } else {\n                      onToggleSeniorPwd(false);\n                    }\n                  }}\n                  className=\"w-4 h-4 text-[#E65100] rounded focus:ring-[#E65100] cursor-pointer\"\n                />\n              </div>\n\n              {isSeniorOrPwd && (\n                <div className=\"text-[11px] bg-white border border-[#E8E2DD] rounded-xl p-2 text-[#2D241E] flex items-center justify-between\">\n                  <div>\n                    <span className=\"font-bold text-[#BF360C]\">SC/PWD ID:</span>{\' \'}\n                    <span>{seniorPwdId || \'Not specified\'}</span>\n                    {seniorPwdName && (\n                      <span className=\"text-[#756D67] ml-1\">({seniorPwdName})</span>\n                    )}\n                  </div>\n                  <button\n                    onClick={() => setShowSeniorModal(true)}\n                    className=\"text-[#E65100] font-bold hover:underline cursor-pointer\"\n                  >\n                    Edit ID\n                  </button>\n                </div>\n              )}\n            </div>\n\n            {/* Cart Summary & Math */}\n            <div className=\"p-4 bg-[#2D241E] text-white rounded-b-2xl space-y-3\">\n              <div className=\"space-y-1.5 text-xs text-stone-300\">\n                <div className=\"flex justify-between\">\n                  <span>Subtotal</span>\n                  <span className=\"font-bold text-white\">\342\202\261{cartSubtotal.toFixed(2)}</span>\n                </div>\n\n                {isSeniorOrPwd && (\n                  <>\n                    <div className=\"flex justify-between text-amber-300\">\n                      <span>Less 12% VAT Exemption</span>\n                      <span>-\342\202\261{discountDetails.vatExemptAmount.toFixed(2)}</span>\n                    </div>\n                    <div className=\"flex justify-between text-amber-300\">\n                      <span>Less 20% Statutory Discount</span>\n                      <span>-\342\202\261{discountDetails.discountAmount.toFixed(2)}</span>\n                    </div>\n                  </>\n                )}\n\n                <div className=\"pt-2 border-t border-stone-700/80 flex justify-between items-baseline\">\n                  <span className=\"text-sm font-extrabold text-white\">Total Bill</span>\n                  <span className=\"text-2xl font-black text-[#FF9800]\">\n                    \342\202\261{discountDetails.finalTotal.toFixed(2)}\n                  </span>\n                </div>\n              </div>\n\n              {/* Checkout Action Button */}\n              <button\n                disabled={cart.length === 0}\n                onClick={onOpenCheckout}\n                className=\"w-full py-3.5 bg-[#E65100] hover:bg-[#BF360C] disabled:bg-stone-800 disabled:text-stone-500 text-white font-black rounded-xl text-base shadow-md transition flex items-center justify-center space-x-2 cursor-pointer active:scale-[0.99]\"\n              >\n                <span>PROCEED TO PAYMENT</span>\n                <ChevronRight className=\"w-5 h-5 stroke-[3]\" />\n              </button>\n            </div>\n\n          </div>\n        </div>\n\n      </div>\n\n      {/* Senior Citizen / PWD ID Verification Modal */}\n      {showSeniorModal && (\n        <div className=\"fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 flex items-center justify-center p-4\">\n          <div className=\"bg-white rounded-xl shadow-xl max-w-md w-full p-5 space-y-4 border border-slate-200\">\n            <div className=\"flex items-center space-x-2 text-orange-700\">\n              <UserCheck className=\"w-6 h-6\" />\n              <h3 className=\"font-bold text-base text-slate-900\">\n                Senior Citizen / PWD Discount Authorization\n              </h3>\n            </div>\n\n            <p className=\"text-xs text-slate-600 leading-relaxed\">\n              In compliance with Philippine Statutory Law (RA 9994 / RA 10754), Senior Citizens and Persons with Disability receive 20% discount and 12% VAT exemption on personal food purchases. Please enter the valid ID details below.\n            </p>\n\n            <div className=\"space-y-3\">\n              <div>\n                <label className=\"block text-xs font-bold text-slate-700 mb-1\">\n                  ID Number (Mandatory) *\n                </label>\n                <input\n                  type=\"text\"\n                  placeholder=\"e.g. SC-MKN-2026-8812\"\n                  value={tempId}\n                  onChange={(e) => setTempId(e.target.value)}\n                  className=\"w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:outline-none\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-bold text-slate-700 mb-1\">\n                  Cardholder Name (Optional)\n                </label>\n                <input\n                  type=\"text\"\n                  placeholder=\"e.g. Cardo Dalisay\"\n                  value={tempName}\n                  onChange={(e) => setTempName(e.target.value)}\n                  className=\"w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:outline-none\"\n                />\n              </div>\n            </div>\n\n            <div className=\"flex items-center justify-end space-x-2 pt-2 border-t border-slate-100\">\n              <button\n                type=\"button\"\n                onClick={() => {\n                  setShowSeniorModal(false);\n                  if (!seniorPwdId) onToggleSeniorPwd(false);\n                }}\n                className=\"px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded-lg\"\n              >\n                Cancel\n              </button>\n              <button\n                type=\"button\"\n                onClick={handleApplySeniorModal}\n                className=\"px-5 py-2 text-xs font-bold bg-orange-600 hover:bg-orange-700 text-white rounded-lg shadow-sm\"\n              >\n                Apply Discount\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>"
      replacement_content: "    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6\">\n      {/* Quick POS Layout: Left Column (Quick-Keys Menu Grid), Right Column (Order Cart) */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8\">\n        \n        {/* LEFT COLUMN: HIGH-SPEED QUICK-KEYS MENU (7 Cols on LG) */}\n        <div className=\"lg:col-span-7 xl:col-span-8 space-y-6\">\n          \n          {/* Top Bar: Search & Category Tabs */}\n          <div className=\"bg-white rounded-3xl shadow-airmee border border-slate-200/80 p-4 space-y-4\">\n            \n            <div className=\"flex flex-col sm:flex-row items-center justify-between gap-3\">\n              {/* Search Bar */}\n              <div className=\"relative w-full sm:w-80\">\n                <Search className=\"w-4 h-4 absolute left-3.5 top-3 text-slate-400\" />\n                <input\n                  type=\"text\"\n                  placeholder=\"Search dish (e.g. Adobo, Rice)...\"\n                  value={searchQuery}\n                  onChange={(e) => setSearchQuery(e.target.value)}\n                  className=\"w-full pl-10 pr-4 py-2.5 text-xs bg-slate-50/70 border border-slate-200/80 rounded-2xl focus:outline-none focus:ring-2 focus:ring-orange-500 focus:bg-white text-slate-900 font-medium\"\n                />\n              </div>\n\n              {/* Peak-Hour High-Speed Indicator */}\n              <div className=\"flex items-center space-x-2 text-xs font-bold text-orange-700 bg-orange-50 border border-orange-200/60 px-4 py-2 rounded-full w-full sm:w-auto justify-center\">\n                <Zap className=\"w-4 h-4 text-orange-600 animate-bounce\" />\n                <span>Quick-Keys POS (3-Tap Order)</span>\n              </div>\n            </div>\n\n            {/* Category Filter Pills */}\n            <div className=\"flex space-x-2 overflow-x-auto pb-1 scrollbar-none\">\n              <button\n                onClick={() => setSelectedCategory(\'ALL\')}\n                className={`px-4 py-2 rounded-full text-xs font-bold transition whitespace-nowrap border cursor-pointer ${\n                  selectedCategory === \'ALL\'\n                    ? \'bg-orange-600 text-white border-orange-600 shadow-airmee-orange\'\n                    : \'bg-white text-slate-600 border-slate-200 hover:border-orange-400 hover:text-slate-900\'\n                }`}\n              >\n                All Menu ({menuItems.length})\n              </button>\n              {CATEGORIES.map((cat) => {\n                const count = menuItems.filter((m) => m.category === cat).length;\n                const isSelected = selectedCategory === cat;\n                return (\n                  <button\n                    key={cat}\n                    onClick={() => setSelectedCategory(cat)}\n                    className={`px-4 py-2 rounded-full text-xs font-bold transition whitespace-nowrap border cursor-pointer ${\n                      isSelected\n                        ? \'bg-orange-600 text-white border-orange-600 shadow-airmee-orange\'\n                        : \'bg-white text-slate-600 border-slate-200 hover:border-orange-400 hover:text-slate-900\'\n                    }`}\n                  >\n                    {cat} ({count})\n                  </button>\n                );\n              })}\n            </div>\n\n          </div>\n\n          {/* Quick-Keys Dishes Grid */}\n          <div className=\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-3 xl:grid-cols-4 gap-4\">\n            {filteredMenuItems.map((dish) => {\n              const isHalf = halfOrderStates[dish.id] || false;\n              const effectivePrice = isHalf && dish.halfPrice ? dish.halfPrice : dish.price;\n\n              return (\n                <div\n                  key={dish.id}\n                  className={`relative flex flex-col justify-between bg-white rounded-3xl border p-4 transition-all shadow-airmee hover:shadow-airmee-hover ${\n                    dish.isSoldOut\n                      ? \'border-slate-200 bg-slate-50 opacity-60\'\n                      : \'border-slate-200/80 hover:border-orange-400\'\n                  }`}\n                >\n                  {/* Sold Out Badge */}\n                  {dish.isSoldOut && (\n                    <div className=\"absolute inset-0 bg-slate-900/60 backdrop-blur-[1px] rounded-3xl z-10 flex items-center justify-center\">\n                      <span className=\"bg-slate-900 text-white text-[10px] font-bold uppercase px-3 py-1 rounded-full shadow-airmee tracking-wider\">\n                        Sold Out\n                      </span>\n                    </div>\n                  )}\n\n                  <div>\n                    {/* Dish Image Thumbnail if available */}\n                    {dish.image && (\n                      <div className=\"w-full h-28 rounded-2xl overflow-hidden mb-3 bg-slate-100 border border-slate-100\">\n                        <img\n                          src={dish.image}\n                          alt={dish.name}\n                          className=\"w-full h-full object-cover\"\n                          referrerPolicy=\"no-referrer\"\n                        />\n                      </div>\n                    )}\n\n                    {/* Category Label & Price */}\n                    <div className=\"flex items-center justify-between mb-1.5\">\n                      <span className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider\">\n                        {dish.category}\n                      </span>\n                      <span className=\"text-base font-black text-orange-600\">\n                        \342\202\261{effectivePrice.toFixed(2)}\n                      </span>\n                    </div>\n\n                    {/* Dish Name */}\n                    <h4 className=\"font-extrabold text-slate-900 text-sm leading-tight line-clamp-2 min-h-[2.25rem]\">\n                      {dish.name}\n                    </h4>\n\n                    {/* Description preview */}\n                    {dish.description && (\n                      <p className=\"text-[11px] text-slate-500 font-medium line-clamp-1 mt-0.5\">\n                        {dish.description}\n                      </p>\n                    )}\n                  </div>\n\n                  {/* Half-Order Portion Switch & Add Button */}\n                  <div className=\"mt-4 pt-3 border-t border-slate-100 space-y-2.5\">\n                    {/* Portion switch toggle if dish allows half order */}\n                    {dish.allowHalfOrder && (\n                      <div className=\"flex items-center justify-between bg-slate-50 border border-slate-200/80 rounded-2xl p-1 text-[11px]\">\n                        <span className=\"text-slate-500 font-bold px-1 text-[10px]\">Portion:</span>\n                        <div className=\"flex items-center space-x-1\">\n                          <button\n                            type=\"button\"\n                            onClick={(e) => {\n                              e.stopPropagation();\n                              if (isHalf) toggleHalfOrderState(dish.id);\n                            }}\n                            className={`px-2 py-0.5 rounded-xl font-extrabold transition text-[10px] cursor-pointer ${\n                              !isHalf ? \'bg-orange-600 text-white shadow-2xs\' : \'text-slate-500 hover:text-slate-900\'\n                            }`}\n                          >\n                            Full (\342\202\261{dish.price})\n                          </button>\n                          <button\n                            type=\"button\"\n                            onClick={(e) => {\n                              e.stopPropagation();\n                              if (!isHalf) toggleHalfOrderState(dish.id);\n                            }}\n                            className={`px-2 py-0.5 rounded-xl font-extrabold transition text-[10px] cursor-pointer ${\n                              isHalf ? \'bg-orange-800 text-white shadow-2xs\' : \'text-slate-500 hover:text-slate-900\'\n                            }`}\n                          >\n                            Half (\342\202\261{dish.halfPrice || Math.round(dish.price / 2)})\n                          </button>\n                        </div>\n                      </div>\n                    )}\n\n                    {/* Quick Add Button */}\n                    <button\n                      disabled={dish.isSoldOut}\n                      onClick={() => onAddToCart(dish, isHalf)}\n                      className=\"w-full py-2.5 bg-orange-600 hover:bg-orange-700 active:scale-[0.98] text-white font-extrabold rounded-full text-xs flex items-center justify-center space-x-1.5 transition shadow-airmee-orange cursor-pointer\"\n                    >\n                      <Plus className=\"w-3.5 h-3.5\" />\n                      <span>Add to Order</span>\n                    </button>\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n\n        </div>\n\n        {/* RIGHT COLUMN: ACTIVE ORDER CART & CHECKOUT PANEL (5 Cols on LG) */}\n        <div className=\"lg:col-span-5 xl:col-span-4\">\n          <div className=\"bg-white rounded-3xl shadow-airmee border border-slate-200/80 flex flex-col h-full sticky top-20 overflow-hidden\">\n            \n            {/* Cart Header */}\n            <div className=\"p-5 border-b border-slate-100 flex items-center justify-between bg-slate-50/50\">\n              <div className=\"flex items-center space-x-2.5\">\n                <ShoppingBag className=\"w-5 h-5 text-orange-600\" />\n                <h3 className=\"font-extrabold text-slate-900 text-base\">Current Order</h3>\n                <span className=\"bg-orange-50 text-orange-600 border border-orange-200/60 font-bold text-xs px-2.5 py-0.5 rounded-full\">\n                  {cart.reduce((sum, i) => sum + i.quantity, 0)} items\n                </span>\n              </div>\n\n              {cart.length > 0 && (\n                <button\n                  onClick={onClearCart}\n                  className=\"text-xs text-red-600 hover:text-red-700 font-bold flex items-center gap-1 hover:underline cursor-pointer\"\n                >\n                  <Trash2 className=\"w-3.5 h-3.5\" />\n                  Clear\n                </button>\n              )}\n            </div>\n\n            {/* Cart Items List */}\n            <div className=\"p-5 flex-1 overflow-y-auto max-h-[380px] space-y-3 divide-y divide-slate-100\">\n              {cart.length === 0 ? (\n                <div className=\"py-12 text-center text-slate-400 space-y-2\">\n                  <Utensils className=\"w-10 h-10 mx-auto stroke-1 opacity-40 text-slate-400\" />\n                  <p className=\"text-sm font-extrabold text-slate-900\">Order ticket is empty</p>\n                  <p className=\"text-xs text-slate-500 font-medium\">Tap dish items on the left to add to counter cart</p>\n                </div>\n              ) : (\n                cart.map((item) => (\n                  <div key={item.cartItemId} className=\"pt-3 first:pt-0 flex items-start justify-between gap-2\">\n                    <div className=\"flex-1 min-w-0\">\n                      <div className=\"flex items-center gap-1.5 flex-wrap\">\n                        <span className=\"font-extrabold text-slate-900 text-sm\">\n                          {item.menuItem.name}\n                        </span>\n                        {item.isHalfOrder && (\n                          <span className=\"bg-amber-50 text-amber-800 border border-amber-200/60 text-[10px] font-extrabold px-2 py-0.5 rounded-full uppercase\">\n                            Half Portion\n                          </span>\n                        )}\n                      </div>\n\n                      <div className=\"text-xs text-slate-500 font-medium mt-0.5\">\n                        \342\202\261{item.unitPrice.toFixed(2)} each\n                      </div>\n                    </div>\n\n                    {/* Quantity Controls & Line Total */}\n                    <div className=\"flex items-center space-x-3\">\n                      <div className=\"flex items-center border border-slate-200/80 rounded-2xl bg-slate-50/60\">\n                        <button\n                          onClick={() => onUpdateCartItemQuantity(item.cartItemId, item.quantity - 1)}\n                          className=\"p-1.5 hover:bg-slate-200 text-slate-800 rounded-l-2xl transition cursor-pointer\"\n                        >\n                          <Minus className=\"w-3.5 h-3.5\" />\n                        </button>\n                        <span className=\"px-2 text-xs font-black text-slate-900 min-w-[1.25rem] text-center\">\n                          {item.quantity}\n                        </span>\n                        <button\n                          onClick={() => onUpdateCartItemQuantity(item.cartItemId, item.quantity + 1)}\n                          className=\"p-1.5 hover:bg-slate-200 text-slate-800 rounded-r-2xl transition cursor-pointer\"\n                        >\n                          <Plus className=\"w-3.5 h-3.5\" />\n                        </button>\n                      </div>\n\n                      <div className=\"text-right min-w-[3.5rem]\">\n                        <div className=\"font-black text-slate-900 text-sm\">\n                          \342\202\261{item.totalPrice.toFixed(2)}\n                        </div>\n                        <button\n                          onClick={() => onRemoveCartItem(item.cartItemId)}\n                          className=\"text-[10px] text-red-600 hover:text-red-800 font-bold cursor-pointer\"\n                        >\n                          Remove\n                        </button>\n                      </div>\n                    </div>\n                  </div>\n                ))\n              )}\n            </div>\n\n            {/* Statutory Discount Toggle (Senior Citizen / PWD 20% + 12% VAT) */}\n            <div className=\"p-4 bg-orange-50/50 border-t border-slate-100 space-y-2.5\">\n              <div className=\"flex items-center justify-between\">\n                <div className=\"flex items-center space-x-2\">\n                  <UserCheck className=\"w-4 h-4 text-orange-600\" />\n                  <span className=\"text-xs font-bold text-slate-900\">\n                    Senior / PWD Discount (20% + VAT Exempt)\n                  </span>\n                </div>\n                <input\n                  type=\"checkbox\"\n                  checked={isSeniorOrPwd}\n                  onChange={(e) => {\n                    if (e.target.checked) {\n                      setShowSeniorModal(true);\n                    } else {\n                      onToggleSeniorPwd(false);\n                    }\n                  }}\n                  className=\"w-4 h-4 text-orange-600 rounded-md focus:ring-orange-500 cursor-pointer\"\n                />\n              </div>\n\n              {isSeniorOrPwd && (\n                <div className=\"text-[11px] bg-white border border-orange-200/60 rounded-2xl p-2.5 text-slate-900 flex items-center justify-between\">\n                  <div>\n                    <span className=\"font-bold text-orange-700\">SC/PWD ID:</span>{\' \'}\n                    <span className=\"font-medium\">{seniorPwdId || \'Not specified\'}</span>\n                    {seniorPwdName && (\n                      <span className=\"text-slate-500 ml-1 font-medium\">({seniorPwdName})</span>\n                    )}\n                  </div>\n                  <button\n                    onClick={() => setShowSeniorModal(true)}\n                    className=\"text-orange-600 font-extrabold hover:underline cursor-pointer\"\n                  >\n                    Edit ID\n                  </button>\n                </div>\n              )}\n            </div>\n\n            {/* Cart Summary & Math */}\n            <div className=\"p-5 bg-slate-900 text-white rounded-b-3xl space-y-4\">\n              <div className=\"space-y-2 text-xs text-slate-300 font-medium\">\n                <div className=\"flex justify-between\">\n                  <span>Subtotal</span>\n                  <span className=\"font-bold text-white\">\342\202\261{cartSubtotal.toFixed(2)}</span>\n                </div>\n\n                {isSeniorOrPwd && (\n                  <>\n                    <div className=\"flex justify-between text-amber-300\">\n                      <span>Less 12% VAT Exemption</span>\n                      <span>-\342\202\261{discountDetails.vatExemptAmount.toFixed(2)}</span>\n                    </div>\n                    <div className=\"flex justify-between text-amber-300\">\n                      <span>Less 20% Statutory Discount</span>\n                      <span>-\342\202\261{discountDetails.discountAmount.toFixed(2)}</span>\n                    </div>\n                  </>\n                )}\n\n                <div className=\"pt-3 border-t border-slate-800 flex justify-between items-baseline\">\n                  <span className=\"text-sm font-extrabold text-white\">Total Bill</span>\n                  <span className=\"text-2xl font-black text-orange-500\">\n                    \342\202\261{discountDetails.finalTotal.toFixed(2)}\n                  </span>\n                </div>\n              </div>\n\n              {/* Checkout Action Button */}\n              <button\n                disabled={cart.length === 0}\n                onClick={onOpenCheckout}\n                className=\"w-full py-4 bg-orange-600 hover:bg-orange-700 disabled:bg-slate-800 disabled:text-slate-600 text-white font-black rounded-full text-sm shadow-airmee-orange transition-all flex items-center justify-center space-x-2 cursor-pointer active:scale-[0.99]\"\n              >\n                <span>PROCEED TO PAYMENT</span>\n                <ChevronRight className=\"w-5 h-5 stroke-[3]\" />\n              </button>\n            </div>\n\n          </div>\n        </div>\n\n      </div>\n\n      {/* Senior Citizen / PWD ID Verification Modal */}\n      {showSeniorModal && (\n        <div className=\"fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 flex items-center justify-center p-4\">\n          <div className=\"bg-white rounded-3xl shadow-airmee-hover max-w-md w-full p-6 space-y-5 border border-slate-100 animate-fadeIn\">\n            <div className=\"flex items-center space-x-3 text-orange-600\">\n              <div className=\"w-10 h-10 rounded-2xl bg-orange-50 flex items-center justify-center\">\n                <UserCheck className=\"w-6 h-6\" />\n              </div>\n              <div>\n                <h3 className=\"font-extrabold text-base text-slate-900\">\n                  Senior Citizen / PWD Discount\n                </h3>\n                <p className=\"text-[11px] text-slate-500 font-medium\">Philippine Statutory Authorization</p>\n              </div>\n            </div>\n\n            <p className=\"text-xs text-slate-500 leading-relaxed font-medium\">\n              In compliance with Philippine Statutory Law (RA 9994 / RA 10754), Senior Citizens and Persons with Disability receive 20% discount and 12% VAT exemption on personal food purchases. Please enter the valid ID details below.\n            </p>\n\n            <div className=\"space-y-3\">\n              <div>\n                <label className=\"block text-xs font-bold text-slate-800 mb-1\">\n                  ID Number (Mandatory) *\n                </label>\n                <input\n                  type=\"text\"\n                  placeholder=\"e.g. SC-MKN-2026-8812\"\n                  value={tempId}\n                  onChange={(e) => setTempId(e.target.value)}\n                  className=\"w-full px-4 py-2.5 text-sm border border-slate-200 rounded-2xl focus:ring-2 focus:ring-orange-500 focus:outline-none\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-bold text-slate-800 mb-1\">\n                  Cardholder Name (Optional)\n                </label>\n                <input\n                  type=\"text\"\n                  placeholder=\"e.g. Cardo Dalisay\"\n                  value={tempName}\n                  onChange={(e) => setTempName(e.target.value)}\n                  className=\"w-full px-4 py-2.5 text-sm border border-slate-200 rounded-2xl focus:ring-2 focus:ring-orange-500 focus:outline-none\"\n                />\n              </div>\n            </div>\n\n            <div className=\"flex items-center justify-end space-x-2 pt-3 border-t border-slate-100\">\n              <button\n                type=\"button\"\n                onClick={() => {\n                  setShowSeniorModal(false);\n                  if (!seniorPwdId) onToggleSeniorPwd(false);\n                }}\n                className=\"px-4 py-2 text-xs font-bold text-slate-500 hover:text-slate-800 cursor-pointer\"\n              >\n                Cancel\n              </button>\n              <button\n                type=\"button\"\n                onClick={handleApplySeniorModal}\n                className=\"px-5 py-2.5 text-xs font-extrabold bg-orange-600 hover:bg-orange-700 text-white rounded-full shadow-airmee-orange cursor-pointer\"\n              >\n                Apply Discount\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>"
    }
