eight: 700; letter-spacing: -0.5px; } .main-layout { display: flex; flex: 1; overflow: hidden; } .category-sidebar { width: 160px; border-right: 1px solid var(--line); padding: 16px; display: flex; flex-direction: column; gap: 8px; } .category-btn { padding: 12px; border-radius: 12px; border: 1px solid var(--line); background: var(--surface); text-align: center; font-weight: 600; cursor: pointer; color: var(--text-muted); font-size: 14px; } .category-btn.active { background: var(--primary); color: white; border-color: var(--primary); } .menu-grid-container { flex: 1; padding: 20px; display: grid; grid-template-columns: repeat(3, 1fr); grid-auto-rows: 140px; gap: 16px; overflow-y: auto; background: var(--bg); } .menu-card { background: var(--surface); border-radius: 16px; padding: 16px; border: 1px solid var(--line); display: flex; flex-direction: column; justify-content: space-between; cursor: pointer; transition: transform 0.1s; position: relative; } .menu-card.sold-out { opacity: 0.6; filter: grayscale(1); } .sold-out-badge { position: absolute; top: 12px; right: 12px; background: #333; color: white; font-size: 10px; padding: 2px 6px; border-radius: 4px; text-transform: uppercase; } .menu-card-title { font-weight: 600; font-size: 16px; line-height: 1.2; } .menu-card-price { font-weight: 700; color: var(--primary); font-size: 18px; } .cart-panel { width: 360px; border-left: 1px solid var(--line); background: var(--surface); display: flex; flex-direction: column; } .cart-header { padding: 20px; border-bottom: 1px solid var(--line); } .cart-items { flex: 1; overflow-y: auto; padding: 0 20px; } .cart-item { display: flex; justify-content: space-between; align-items: center; padding: 16px 0; border-bottom: 1px solid var(--line); } .item-info h4 { margin: 0; font-size: 15px; } .item-info p { margin: 4px 0 0; font-size: 12px; color: var(--text-muted); } .cart-footer { padding: 20px; border-top: 1px solid var(--line); background: #fafafa; } .discount-toggle { display: fle